          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ превышает лимит вложений (%@)."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ överskrider gränsen för bilagor på %@."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@, %@ ek sınırını aşıyor."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",

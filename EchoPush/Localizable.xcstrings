    "Hermes isn't sure how far it got. Retry runs it again." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes ved ikke sikkert, hvor langt den nåede. Med Prøv igen køres den igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes weiß nicht genau, wie weit es kam. „Wiederholen“ führt es erneut aus."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes no sabe hasta dónde llegó. Reintentar lo vuelve a ejecutar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes ne sait pas jusqu’où il est allé. Réessayer la relance."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes non sa fin dove è arrivato. Con Riprova viene eseguito di nuovo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermesはどこまで進んだか把握できていません。再試行すると再度実行されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes가 어디까지 진행했는지 확실하지 않습니다. 재시도하면 다시 실행합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes vet ikke sikkert hvor langt den kom. Prøv igjen for å kjøre den på nytt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes weet niet zeker hoe ver het is gekomen. ‘Probeer opnieuw’ voert het nogmaals uit."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes nie wie, jak daleko doszedł. Ponowienie uruchomi to od nowa."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Hermes não sabe até onde chegou. “Tentar de novo” executa outra vez."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes не уверен, на чем остановился. «Повторить» запустит заново."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes vet inte säkert hur långt den kom. Med Försök igen körs den på nytt."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes ne kadar ilerlediğinden emin değil. Yeniden Dene onu yeniden çalıştırır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes не впевнений, наскільки просунувся. Повтор запустить це знову."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes不确定进行到了哪一步。重试会再次运行。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes 不確定進行到哪裡。重試會重新執行。"
          }
        }
      }

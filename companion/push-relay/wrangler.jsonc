{
  // Redde push relay: sealed notes from a paired Hermes in, APNs notifications out (/v1), and
  // the older household routes, hermes outbound webhooks in, APNs alerts out. See README.md.
  // Secrets (wrangler secret put): APNS_KEY (the .p8 PEM), APNS_KEY_ID (10-char key id from
  // the developer portal); for the household routes HMAC_SECRET (hermes webhook signing) and
  // REGISTER_SECRET (device registration bearer).
  "name": "redde-push-relay",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  "kv_namespaces": [
    { "binding": "STORE", "id": "3a6a29f515e1453daf557a23d9dc2a52" }
  ],
  "vars": {
    "APNS_TEAM_ID": "579BSQT6J4",
    "APNS_TOPIC": "com.goosehouse.echo",
    // post_llm_call fires for every hermes platform; only these become pushes
    // (Redde's own surfaces — Telegram etc. already notify natively).
    "PUSH_PLATFORMS": "desktop,api_server"
  },
  // What one pairing may send: two notes a second, sustained, is far more than an agent writes.
  "ratelimits": [
    { "name": "PUSH_LIMIT", "namespace_id": "1001", "simple": { "limit": 120, "period": 60 } }
  ],
  "observability": { "enabled": true }
}

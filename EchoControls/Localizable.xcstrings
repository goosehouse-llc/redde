    "Redde will tell you here when this Hermes finishes a reply, waits for you, or couldn't reply." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Redde giver dig besked her, når denne Hermes har et svar klar, venter på dig eller ikke kunne svare."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Redde sagt dir hier Bescheid, wenn dieser Hermes eine Antwort fertig hat, auf dich wartet oder nicht antworten konnte."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Redde te avisará aquí cuando este Hermes termine una respuesta, te espere o no pueda responder."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Redde vous préviendra ici quand cet Hermes termine une réponse, vous attend ou n’a pas pu répondre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Redde ti avviserà qui quando questo Hermes termina una risposta, ti aspetta o non è riuscito a rispondere."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このHermesが返答を完了したとき、対応を待っているとき、または返答できなかったときに、ここでお知らせします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 Hermes가 응답을 완료하거나, 사용자를 기다리거나, 응답하지 못하면 Redde가 여기에서 알려 줍니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Redde gir deg beskjed her når denne Hermes er ferdig med et svar, venter på deg eller ikke kunne svare."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Redde laat het je hier weten als deze Hermes een antwoord afrondt, op je wacht, of niet kon antwoorden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Redde powiadomi Cię tutaj, gdy ten Hermes skończy odpowiedź, będzie na Ciebie czekać lub nie zdoła odpowiedzieć."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Redde vai avisar aqui quando este Hermes terminar uma resposta, esperar por você ou não conseguir responder."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Redde сообщит здесь, когда этот Hermes закончит ответ, будет ждать вас или не сможет ответить."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Redde meddelar dig här när den här Hermes blir klar med ett svar, väntar på dig eller inte kunde svara."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu Hermes bir yanıtı bitirdiğinde, sizi beklediğinde ya da yanıt veremediğinde Redde size burada bildirir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Redde повідомить тут, коли цей Hermes завершить відповідь, чекатиме на вас або не зможе відповісти."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当此Hermes完成回复、等待你处理或无法回复时，Redde会在这里告诉你。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "當此 Hermes 完成回覆、等待你回應，或無法回覆時，Redde 會在這裡通知你。"
          }
        }
      }
    },

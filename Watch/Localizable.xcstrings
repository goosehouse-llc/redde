    "This chat is still working on a reply. Stop it, then delete it." : {
      "comment" : "Deleting a chat Hermes is still answering in",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne chat arbejder stadig på et svar. Stop den, og slet den derefter."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Chat arbeitet noch an einer Antwort. Stoppe ihn und lösche ihn dann."

    "The watch couldn't reach the voice service. Try again with your iPhone nearby or on Wi-Fi." : {
      "comment" : "Watch: a live call's connection got no network",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uret kunne ikke nå stemmetjenesten. Prøv igen med din iPhone i nærheden eller på Wi-Fi."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Uhr konnte den Sprachdienst nicht erreichen. Versuch es noch einmal mit deinem iPhone in der Nähe oder im WLAN."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El reloj no pudo conectar con el servicio de voz. Inténtalo de nuevo con el iPhone cerca o con wifi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La montre n’a pas pu joindre le service vocal. Réessaie avec ton iPhone à proximité ou en Wi-Fi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’orologio non è riuscito a raggiungere il servizio vocale. Riprova con l’iPhone vicino o in Wi-Fi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ウォッチから音声サービスに接続できませんでした。iPhoneを近くに置くか、Wi-Fiに接続してもう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "워치에서 음성 서비스에 연결하지 못했습니다. iPhone을 가까이 두거나 Wi-Fi에 연결한 뒤 다시 시도하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klokken kom ikke frem til taletjenesten. Prøv igjen med iPhonen i nærheten eller på Wi-Fi."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De watch kon de spraakdienst niet bereiken. Probeer het opnieuw met je iPhone in de buurt of via wifi."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zegarek nie mógł połączyć się z usługą głosową. Spróbuj ponownie z iPhone’em w pobliżu lub przez Wi-Fi."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O relógio não conseguiu acessar o serviço de voz. Tente de novo com o iPhone por perto ou no Wi-Fi."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Часы не смогли связаться с голосовым сервисом. Попробуйте снова, когда iPhone рядом или есть Wi-Fi."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klockan kunde inte nå rösttjänsten. Försök igen med din iPhone i närheten eller på Wi-Fi."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saat ses hizmetine ulaşamadı. iPhone’un yakındayken ya da Wi-Fi’dayken yeniden dene."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Годинник не зміг з’єднатися з голосовим сервісом. Спробуйте ще раз, коли iPhone поруч або є Wi-Fi."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "手表无法连接语音服务。请将 iPhone 放在附近或连接 Wi-Fi 后重试。"
          }
        },
        "zh-Hant" : {

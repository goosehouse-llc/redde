    "This Hermes gateway doesn't serve the selected profile. Turn on gateway.multiplex_profiles in its config, or pick Default under Settings → Profile." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne Hermes-gateway betjener ikke den valgte profil. Slå gateway.multiplex_profiles til i dens konfiguration, eller vælg Standard under Indstillinger → Profil."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Hermes-Gateway stellt das gewählte Profil nicht bereit. Aktiviere gateway.multiplex_profiles in seiner Konfiguration oder wähle „Standard“ unter Einstellungen → Profil."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este gateway de Hermes no sirve el perfil seleccionado. Activa gateway.multiplex_profiles en su configuración, o elige Predeterminado en Ajustes → Perfil."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette passerelle Hermes ne sert pas le profil sélectionné. Activez gateway.multiplex_profiles dans sa configuration, ou choisissez Par défaut dans Réglages → Profil."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo gateway Hermes non serve il profilo selezionato. Attiva gateway.multiplex_profiles nella sua configurazione, o scegli Predefinito in Impostazioni → Profilo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このHermesゲートウェイは選択したプロファイルを提供していません。設定ファイルでgateway.multiplex_profilesをオンにするか、設定 → プロファイルで「デフォルト」を選んでください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 Hermes 게이트웨이는 선택한 프로필을 제공하지 않습니다. 구성에서 gateway.multiplex_profiles를 켜거나, 설정 → 프로필에서 기본을 선택하십시오."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne Hermes-gatewayen betjener ikke den valgte profilen. Slå på gateway.multiplex_profiles i konfigurasjonen, eller velg Standard under Innstillinger → Profil."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deze Hermes-gateway bedient het gekozen profiel niet. Zet gateway.multiplex_profiles aan in de config, of kies Standaard onder Instellingen → Profiel."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta brama Hermesa nie obsługuje wybranego profilu. Włącz gateway.multiplex_profiles w jej konfiguracji lub wybierz Domyślny w Ustawienia → Profil."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este gateway do Hermes não atende o perfil selecionado. Ative gateway.multiplex_profiles na configuração dele, ou escolha Padrão em Ajustes → Perfil."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Этот шлюз Hermes не обслуживает выбранный профиль. Включите gateway.multiplex_profiles в его конфигурации или выберите «По умолчанию» в «Настройки» → «Профиль»."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den här Hermes-gatewayn betjänar inte den valda profilen. Slå på gateway.multiplex_profiles i dess konfiguration, eller välj Förval under Inställningar → Profil."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu Hermes ağ geçidi seçili profile hizmet vermiyor. Yapılandırmasında gateway.multiplex_profiles ayarını açın ya da Ayarlar → Profil bölümünde Varsayılan'ı seçin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Цей шлюз Hermes не обслуговує вибраний профіль. Увімкніть gateway.multiplex_profiles у його конфігурації або виберіть «Стандартний» у Параметри → Профіль."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此Hermes网关不提供所选的配置文件。请在其配置中打开gateway.multiplex_profiles，或在设置 → 配置文件中选择“默认”。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此 Hermes 閘道不提供所選的設定檔。請在其設定中開啟 gateway.multiplex_profiles，或在「設定」→「設定檔」中選擇「預設」。"
          }
        }
      }
    },

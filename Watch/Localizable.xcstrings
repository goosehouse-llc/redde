    "Hermes couldn't be reached for half an hour; the reply will be there when it can." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes kunne ikke nås i en halv time; svaret kommer, når det kan."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes war eine halbe Stunde nicht erreichbar; die Antwort kommt, sobald es geht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo contactar con Hermes durante media hora; la respuesta estará ahí cuando sea posible."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes est resté injoignable pendant une demi-heure ; la réponse arrivera dès que possible."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes non è stato raggiungibile per mezz'ora; la risposta arriverà appena possibile."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "30分間Hermesに接続できませんでした。接続でき次第、返答が届きます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "30분 동안 Hermes에 연결할 수 없었습니다. 연결되면 응답이 도착합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes kunne ikke nås på en halvtime; svaret kommer når det er mulig."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes was een halfuur niet bereikbaar; het antwoord komt zodra het kan."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes był nieosiągalny przez pół godziny; odpowiedź pojawi się, gdy będzie to możliwe."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível acessar o Hermes por meia hora; a resposta vai estar lá quando for possível."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes был недоступен полчаса; ответ появится, когда связь восстановится."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes gick inte att nå på en halvtimme; svaret kommer när det går."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes'e yarım saat boyunca ulaşılamadı; ulaşılabildiğinde yanıt orada olacak."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes був недоступний пів години; відповідь з’явиться, щойно це стане можливим."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已有半小时无法连接Hermes；能连接时，回复就会出现。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已有半小時無法連線到 Hermes；等它可以連線時，回覆就會出現。"
          }
        }
      }
    },

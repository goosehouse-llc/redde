    "Set up Redde on your iPhone first. The watch gets its connection from there." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Konfigurer først Redde på din iPhone. Uret får sin forbindelse derfra."
          }
        },
        "de" : {

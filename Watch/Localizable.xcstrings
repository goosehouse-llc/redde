    "Update Redde on your iPhone: it can't take the watch's questions yet." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opdater Redde på din iPhone: den kan ikke tage imod urets spørgsmål endnu."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktualisiere Redde auf deinem iPhone: Es kann die Fragen der Watch noch nicht annehmen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Actualiza Redde en tu iPhone: aún no puede atender las preguntas del reloj."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mettez à jour Redde sur votre iPhone : il ne peut pas encore recevoir les questions de la montre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiorna Redde sul tuo iPhone: non può ancora ricevere le domande dell'Apple Watch."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhoneのReddeをアップデートしてください。まだApple Watchからの質問を受け付けられません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone의 Redde를 업데이트하십시오. 아직 Apple Watch의 질문을 받을 수 없습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oppdater Redde på iPhonen: den kan ikke ta imot spørsmål fra klokken ennå."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Werk Redde bij op je iPhone: het kan de vragen van de Apple Watch nog niet aannemen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uaktualnij Redde na iPhonie: nie może jeszcze przyjmować pytań z zegarka."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atualize o Redde no seu iPhone: ele ainda não aceita as perguntas do relógio."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Обновите Redde на iPhone: он пока не принимает вопросы с часов."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uppdatera Redde på din iPhone: den kan inte ta emot klockans frågor än."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone'unuzdaki Redde'yi güncelleyin: henüz saatin sorularını alamıyor."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Оновіть Redde на iPhone: він ще не може приймати запитання з годинника."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请更新iPhone上的Redde：它还无法接收手表的问题。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請更新你 iPhone 上的 Redde：它還無法接收手錶的問題。"
          }
        }
      }
    },

    "%@ attachments aren't supported on %@. Switch to the Hermes Dashboard in Settings." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@-vedhæftninger understøttes ikke på %@. Skift til Hermes Dashboard i Indstillinger."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@-Anhänge werden über %@ nicht unterstützt. Wechsle in den Einstellungen zum Hermes Dashboard."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los adjuntos de %@ no son compatibles con %@. Cambia al Hermes Dashboard en Ajustes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les pièces jointes %@ ne sont pas prises en charge sur %@. Passez au Hermes Dashboard dans Réglages."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli allegati %@ non sono supportati su %@. Passa alla Hermes Dashboard in Impostazioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%2$@では%1$@の添付ファイルに対応していません。設定でHermes Dashboardに切り替えてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%2$@에서는 %1$@ 첨부 파일이 지원되지 않습니다. 설정에서 Hermes Dashboard로 전환하십시오."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@-vedlegg støttes ikke på %@. Bytt til Hermes Dashboard i Innstillinger."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@-bijlagen worden niet ondersteund op %@. Schakel over naar het Hermes Dashboard in Instellingen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Załączniki typu %@ nie są obsługiwane w %@. Przełącz się na Hermes Dashboard w Ustawieniach."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anexos de %@ não são aceitos em %@. Mude para o Hermes Dashboard nos Ajustes."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вложения типа «%@» не поддерживаются через %@. Переключитесь на Hermes Dashboard в настройках."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bilagor av typen %@ stöds inte på %@. Byt till Hermes Dashboard i Inställningar."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ekleri %@ üzerinde desteklenmiyor. Ayarlar'da Hermes Dashboard'a geçin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вкладення типу %@ не підтримуються на %@. Перейдіть на Hermes Dashboard у Параметрах."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%2$@不支持%1$@附件。请在设置中切换到Hermes Dashboard。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%2$@ 不支援 %1$@ 附件。請在「設定」中切換到 Hermes Dashboard。"
          }
        }
      }
    },
    "%@ attachments aren't supported on the Hermes API alone. Save the Hermes Dashboard login in Settings → Connection details, and they go to the server through it." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@-vedhæftninger understøttes ikke på Hermes API alene. Gem login til Hermes Dashboard i Indstillinger → Forbindelsesdetaljer, så går de til serveren gennem det."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@-Anhänge werden über die Hermes API allein nicht unterstützt. Sichere die Hermes-Dashboard-Anmeldung in Einstellungen → Verbindungsdetails, dann gehen sie darüber an den Server."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los adjuntos de %@ no son compatibles solo con la Hermes API. Guarda el inicio de sesión del Hermes Dashboard en Ajustes → Datos de conexión, y llegarán al servidor a través de él."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les pièces jointes %@ ne sont pas prises en charge avec Hermes API uniquement. Enregistrez l’identifiant du Hermes Dashboard dans Réglages → Détails de connexion, et elles passeront par lui vers le serveur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli allegati %@ non sono supportati solo con la Hermes API. Salva l'accesso alla Hermes Dashboard in Impostazioni → Dettagli connessione, e arriveranno al server tramite la Dashboard."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes APIだけでは%@の添付ファイルに対応していません。設定 → 接続の詳細でHermes Dashboardのログイン情報を保存すると、それを経由してサーバに送信されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes API만으로는 %@ 첨부 파일이 지원되지 않습니다. 설정 → 연결 세부사항에 Hermes Dashboard 로그인 정보를 저장하면 Dashboard를 통해 서버로 전송됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@-vedlegg støttes ikke på Hermes API alene. Lagre påloggingen til Hermes Dashboard i Innstillinger → Tilkoblingsdetaljer, så går de til tjeneren via den."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@-bijlagen worden niet ondersteund op alleen de Hermes API. Bewaar de Hermes Dashboard-login in Instellingen → Verbindingsgegevens, dan gaan ze daarlangs naar de server."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Załączniki typu %@ nie są obsługiwane w samym Hermes API. Zapisz login do Hermes Dashboard w Ustawienia → Szczegóły połączenia, a trafią na serwer przez Dashboard."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anexos de %@ não são aceitos só com a Hermes API. Salve o login do Hermes Dashboard em Ajustes → Detalhes da conexão, e eles vão para o servidor por ele."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вложения типа «%@» не поддерживаются только через Hermes API. Сохраните вход в Hermes Dashboard в «Настройки» → «Сведения о подключении», и они будут отправляться на сервер через него."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bilagor av typen %@ stöds inte enbart via Hermes API. Spara inloggningen för Hermes Dashboard i Inställningar → Anslutningsuppgifter, så går de till servern via den."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ekleri tek başına Hermes API'de desteklenmiyor. Hermes Dashboard girişini Ayarlar → Bağlantı ayrıntıları bölümünde kaydedin, ekler onun üzerinden sunucuya gitsin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вкладення типу %@ не підтримуються лише через Hermes API. Збережіть дані входу Hermes Dashboard у Параметри → Відомості про з’єднання, і вони надходитимуть на сервер через нього."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅使用Hermes API时不支持%@附件。在设置 → 连接详细信息中保存Hermes Dashboard登录信息后，它们会经由Dashboard发送到服务器。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "僅使用 Hermes API 時不支援 %@ 附件。請在「設定」→「連線詳細資訊」中儲存 Hermes Dashboard 登入資訊，附件就會透過它傳送到伺服器。"
          }
        }
      }
    },
    "%@ attachments aren't supported on the OpenAI-compatible server. Switch to the Hermes Dashboard in Settings." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@-vedhæftninger understøttes ikke på den OpenAI-kompatible server. Skift til Hermes Dashboard i Indstillinger."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@-Anhänge werden auf dem OpenAI-kompatiblen Server nicht unterstützt. Wechsle in den Einstellungen zum Hermes Dashboard."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los adjuntos de %@ no son compatibles con el servidor compatible con OpenAI. Cambia al Hermes Dashboard en Ajustes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les pièces jointes %@ ne sont pas prises en charge sur le serveur compatible OpenAI. Passez au Hermes Dashboard dans Réglages."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli allegati %@ non sono supportati sul server compatibile con OpenAI. Passa alla Hermes Dashboard in Impostazioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenAI互換サーバでは%@の添付ファイルに対応していません。設定でHermes Dashboardに切り替えてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenAI 호환 서버에서는 %@ 첨부 파일이 지원되지 않습니다. 설정에서 Hermes Dashboard로 전환하십시오."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@-vedlegg støttes ikke på den OpenAI-kompatible tjeneren. Bytt til Hermes Dashboard i Innstillinger."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@-bijlagen worden niet ondersteund op de OpenAI-compatibele server. Schakel over naar het Hermes Dashboard in Instellingen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Załączniki typu %@ nie są obsługiwane na serwerze zgodnym z OpenAI. Przełącz się na Hermes Dashboard w Ustawieniach."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anexos de %@ não são aceitos no servidor compatível com OpenAI. Mude para o Hermes Dashboard nos Ajustes."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вложения типа «%@» не поддерживаются на сервере, совместимом с OpenAI. Переключитесь на Hermes Dashboard в настройках."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bilagor av typen %@ stöds inte på den OpenAI-kompatibla servern. Byt till Hermes Dashboard i Inställningar."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ekleri OpenAI uyumlu sunucuda desteklenmiyor. Ayarlar'da Hermes Dashboard'a geçin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вкладення типу %@ не підтримуються на сервері, сумісному з OpenAI. Перейдіть на Hermes Dashboard у Параметрах."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenAI兼容服务器不支持%@附件。请在设置中切换到Hermes Dashboard。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "相容 OpenAI 的伺服器不支援 %@ 附件。請在「設定」中切換到 Hermes Dashboard。"
          }
        }
      }
    },
    "%@ is over the %@ attachment limit." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ er over grænsen for vedhæftninger på %@."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ überschreitet das Anhanglimit von %@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ supera el límite de %@ para adjuntos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ dépasse la limite de %@ pour les pièces jointes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ supera il limite di %@ per gli allegati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@は添付ファイルの上限（%2$@）を超えています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@이(가) 첨부 파일 한도(%2$@)를 초과합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ er over vedleggsgrensen på %@."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ is groter dan de bijlagelimiet van %@."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ przekracza limit załącznika (%@)."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ultrapassa o limite de %@ por anexo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ превышает лимит вложений (%@)."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ överskrider gränsen för bilagor på %@."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@, %@ ek sınırını aşıyor."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ перевищує ліміт вкладення в %@."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@超过了%@的附件上限。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 超過 %@ 的附件限制。"
          }
        }
      }
    },
    "%@ is too long to attach: even at low quality it is over the %@ limit. Trim it in Photos first." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ er for lang til at blive vedhæftet: selv i lav kvalitet er den over grænsen på %@. Beskær den først i Fotos."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ist zu lang zum Anhängen: Selbst in niedriger Qualität liegt es über dem Limit von %@. Kürze es zuerst in Fotos."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ es demasiado largo para adjuntarlo: incluso en baja calidad supera el límite de %@. Recórtalo antes en Fotos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ est trop long pour être joint : même en basse qualité, il dépasse la limite de %@. Raccourcissez-le d’abord dans Photos."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ è troppo lungo da allegare: anche a bassa qualità supera il limite di %@. Prima taglialo in Foto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@は長すぎて添付できません。低画質でも上限の%2$@を超えます。先に「写真」アプリでトリミングしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@은(는) 너무 길어 첨부할 수 없습니다. 낮은 화질에서도 %2$@ 한도를 초과합니다. 먼저 사진 앱에서 다듬으십시오."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ er for lang til å legges ved: selv i lav kvalitet er den over grensen på %@. Klipp den til i Bilder først."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ is te lang om bij te voegen: zelfs in lage kwaliteit gaat het over de limiet van %@. Kort het eerst in via Foto’s."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ jest za długie do załączenia: nawet w niskiej jakości przekracza limit %@. Najpierw przytnij je w aplikacji Zdjęcia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ é longo demais para anexar: mesmo em baixa qualidade passa do limite de %@. Corte antes no app Fotos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: слишком длинное для вложения — даже в низком качестве превышен лимит %@. Сначала обрежьте видео в «Фото»."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ är för lång för att bifogas: även med låg kvalitet överskrider den gränsen på %@. Korta den i Bilder först."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ eklenemeyecek kadar uzun: düşük kalitede bile %@ sınırını aşıyor. Önce Fotoğraflar'da kırpın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ задовге для вкладення: навіть у низькій якості перевищує ліміт %@. Спершу обріжте його у «Фотографіях»."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@太长，无法附加：即使是低画质也超过了%@的上限。请先在“照片”中修剪。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 太長，無法附加：即使是低畫質也超過 %@ 的限制。請先在「照片」中修剪。"
          }
        }
      }
    },

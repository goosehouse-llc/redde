    "Unlock your iPhone, then ask again: Redde can't read its keys until you do." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lås din iPhone op, og spørg så igen: Redde kan ikke læse sine nøgler, før du gør det."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entsperre dein iPhone und frag dann erneut: Bis dahin kann Redde seine Schlüssel nicht lesen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desbloquea tu iPhone y vuelve a preguntar: Redde no puede leer sus claves hasta entonces."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Déverrouillez votre iPhone, puis redemandez : Redde ne peut pas lire ses clés avant cela."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sblocca il tuo iPhone, poi chiedi di nuovo: finché non lo fai, Redde non può leggere le sue chiavi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhoneのロックを解除してから、もう一度質問してください。ロックを解除するまでReddeはキーを読み取れません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone을 잠금 해제한 다음 다시 질문하십시오. 잠금 해제하기 전에는 Redde가 키를 읽을 수 없습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lås opp iPhonen, og spør igjen: Redde kan ikke lese nøklene sine før du gjør det."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ontgrendel je iPhone en vraag het opnieuw: Redde kan zijn sleutels pas lezen als je dat doet."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odblokuj iPhone'a i zapytaj ponownie: do tego czasu Redde nie może odczytać swoich kluczy."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desbloqueie o iPhone e pergunte de novo: o Redde não consegue ler as chaves dele até lá."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Разблокируйте iPhone и спросите снова: до этого Redde не может прочитать свои ключи."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lås upp din iPhone och fråga sedan igen: Redde kan inte läsa sina nycklar förrän du gör det."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone'unuzun kilidini açın, sonra yeniden sorun: siz açana kadar Redde anahtarlarını okuyamaz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Відімкніть iPhone і запитайте ще раз: доти Redde не може прочитати свої ключі."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请解锁你的iPhone，然后重新提问：解锁前Redde无法读取其密钥。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請解鎖你的 iPhone，然後再問一次：解鎖前 Redde 無法讀取它的金鑰。"
          }
        }
      }
    },

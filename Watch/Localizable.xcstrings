    "The agent stopped before it finished (stopped elsewhere, or Hermes restarted)." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agenten stoppede, før den var færdig (stoppet et andet sted, eller Hermes genstartede)."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Agent hat aufgehört, bevor er fertig war (woanders gestoppt oder Hermes neu gestartet)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El agente se detuvo antes de terminar (se detuvo en otro sitio, o Hermes se reinició)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’agent s’est arrêté avant d’avoir fini (arrêté ailleurs, ou Hermes a redémarré)."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'agente si è fermato prima di finire (interrotto altrove, o Hermes si è riavviato)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "エージェントが完了前に停止しました（別の場所で停止されたか、Hermesが再起動しました）。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "에이전트가 완료하기 전에 중단되었습니다(다른 곳에서 중단했거나 Hermes가 재시작됨)."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agenten stoppet før den var ferdig (stoppet et annet sted, eller Hermes startet på nytt)."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De agent stopte voordat hij klaar was (elders gestopt, of Hermes is herstart)."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agent zatrzymał się przed ukończeniem (zatrzymano go gdzie indziej lub Hermes został uruchomiony ponownie)."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O agente parou antes de terminar (foi interrompido em outro lugar, ou o Hermes reiniciou)."

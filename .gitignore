# Xcode
*.xcodeproj/
xcuserdata/
DerivedData*/
build/
*.xcresult
.DS_Store

# Never commit secrets. The API key lives only in the iOS Keychain.
*.xcconfig.local
Secrets*.xcconfig

# Personal prefill for first launch; never ship or commit.
Echo/Resources/LocalDefaults.json

# Wrangler caches and local dev state (account details, local KV)
.wrangler/

# App Store preview renders (rebuild with design/video)
design/video/*.mp4
design/video/*.mov
design/video/*.png
design/video/*.log
design/video/*.wav

# Python caches from the Hermes plugin and the lab scripts
__pycache__/

# Scratch: build logs, pictures being made, and an App Store Connect API key's whereabouts
# (tmp/asc.env, for scripts/app-store-push.py). Never commit any of it.
tmp/

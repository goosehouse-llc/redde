    "More voices, and better ones, come from Settings → Accessibility → Spoken Content → Voices." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flere og bedre stemmer findes i Indstillinger → Tilgængelighed → Oplæst indhold → Stemmer."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mehr und bessere Stimmen gibt es unter Einstellungen → Bedienungshilfen → Gesprochene Inhalte → Stimmen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hay más voces, y mejores, en Ajustes → Accesibilidad → Contenido leído → Voces."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "D’autres voix, et de meilleures, sont disponibles dans Réglages → Accessibilité → Contenu énoncé → Voix."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Altre voci, e migliori, si trovano in Impostazioni → Accessibilità → Contenuto letto → Voci."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "設定 → アクセシビリティ → 読み上げコンテンツ → 声で、より多くの高品質な声を入手できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "설정 → 손쉬운 사용 → 읽기 및 말하기 → 음성에서 더 많고 더 좋은 음성을 받을 수 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flere og bedre stemmer finner du i Innstillinger → Tilgjengelighet → Opplest innhold → Stemmer."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meer en betere stemmen vind je in Instellingen → Toegankelijkheid → Gesproken materiaal → Stemmen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Więcej i lepszych głosów znajdziesz w Ustawienia → Dostępność → Treść mówiona → Głosy."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mais vozes, e melhores, em Ajustes → Acessibilidade → Conteúdo Falado → Vozes."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Больше голосов, и более качественных, — в «Настройки» → «Универсальный доступ» → «Устное содержимое» → «Голоса»."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fler röster, och bättre, finns i Inställningar → Hjälpmedel → Talat innehåll → Röster."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Daha fazla ve daha iyi ses için Ayarlar → Erişilebilirlik → Seslendirilen İçerik → Sesler bölümüne gidin."
          }
        },
        "uk" : {

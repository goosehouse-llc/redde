          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zum Anhören einer Stimme brauchst du deinen %@-Schlüssel, in Einstellungen → Stimme → Sprachmodus."
          }
        },
        "es" : {
          "stringUnit" : {

        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vejr og klokkeslæt, slået op"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wetter und Uhrzeit, nachgeschlagen"
          }
        },
        "es" : {

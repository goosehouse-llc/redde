    "Amber phosphor on warm black; your messages become shell prompts." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ravfarvet fosfor på varm sort; dine beskeder bliver til shell-prompter."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bernsteinfarbener Phosphor auf warmem Schwarz; deine Nachrichten werden zu Shell-Prompts."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fósforo ámbar sobre negro cálido; tus mensajes se convierten en prompts de shell."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Phosphore ambre sur noir chaud ; vos messages deviennent des invites de shell."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fosfori ambra su nero caldo; i tuoi messaggi diventano prompt della shell."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "温かみのある黒にアンバーの蛍光体。自分のメッセージはシェルプロンプトに。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "따뜻한 검은색 위의 호박색 형광체. 메시지가 셸 프롬프트로 바뀝니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ravgult fosfor på varm svart; meldingene dine blir skall-ledetekster."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Amberkleurige fosfor op warm zwart; je berichten worden shellprompts."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bursztynowy luminofor na ciepłej czerni; Twoje wiadomości wyglądają jak znak zachęty powłoki."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fósforo âmbar sobre preto quente; suas mensagens viram prompts de shell."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Янтарный люминофор на теплом черном; ваши сообщения становятся приглашениями оболочки."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bärnstensfärgad fosfor på varmt svart; dina meddelanden blir skalprompter."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sıcak siyah üzerinde kehribar fosfor; mesajlarınız kabuk istemlerine dönüşür."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Бурштиновий люмінофор на теплому чорному; ваші повідомлення стають запрошеннями оболонки."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "暖黑底上的琥珀色荧光；你的消息变成shell提示符。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "暖黑底上的琥珀色螢光；你的訊息會呈現為 shell 提示字元。"
          }
        }
      }
    },

          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Веде ваші плани, списки й нагадування та вчасно нагадує."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "管理你的计划、清单和提醒，并按时提醒你。"

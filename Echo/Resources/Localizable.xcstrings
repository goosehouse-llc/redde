    "%@ It is asked for on each of this conversation's turns; a model without one answers as usual." : {
      "comment" : "Footer: %@ is the sentence explaining fast mode",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Det bedes der om ved hver runde i denne samtale; en model uden det svarer som normalt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Er wird bei jeder Runde dieser Konversation angefordert; ein Modell ohne ihn antwortet wie gewohnt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Se pide en cada turno de esta conversación; un modelo sin él responde como siempre."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Il est demandé à chaque tour de cette conversation ; un modèle qui n’en a pas répond normalement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Viene richiesta a ogni turno di questa conversazione; un modello che non ce l'ha risponde come al solito."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@この会話のターンごとに要求されます。高速モードがないモデルは通常どおり回答します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 이 대화의 매 턴마다 요청되며, 빠른 모드가 없는 모델은 평소처럼 응답합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Den bes om i hver runde i denne samtalen; en modell uten hurtigmodus svarer som vanlig."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Het wordt bij elke beurt van dit gesprek gevraagd; een model zonder snelle modus antwoordt zoals gewoonlijk."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Jest on żądany w każdej turze tej rozmowy; model bez niego odpowiada jak zwykle."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Ele é pedido em cada turno desta conversa; um modelo sem modo rápido responde como sempre."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Он запрашивается на каждом ходе этого разговора; модель без него отвечает как обычно."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Det begärs vid varje tur i den här konversationen; en modell utan snabbläge svarar som vanligt."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Bu konuşmanın her turunda istenir; hızlı modu olmayan bir model her zamanki gibi yanıt verir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Він запитується на кожному ході цієї розмови; модель без нього відповідає як зазвичай."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@此对话的每一轮都会请求快速模式；没有快速模式的模型会照常回答。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@此對話的每一輪都會要求使用；沒有此模式的模型會照常回答。"
          }
        }
      }
    },

    "Kept on your Hermes server once the bot is made, so Redde on your other devices shows it too." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gemmes på din Hermes-server, når botten er oprettet, så Redde på dine andre enheder også viser det."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wird nach dem Erstellen des Bots auf deinem Hermes-Server gesichert, damit Redde es auch auf deinen anderen Geräten zeigt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se guarda en tu servidor Hermes una vez creado el bot, así que Redde también lo muestra en tus otros dispositivos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conservé sur votre serveur Hermes une fois le bot créé, pour que Redde l’affiche aussi sur vos autres appareils."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salvato sul tuo server Hermes una volta creato il bot, così lo mostra anche Redde sugli altri dispositivi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ボットの作成後はHermesサーバに保存されるため、ほかのデバイスのReddeにも表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "봇을 만들면 Hermes 서버에 보관되므로 다른 기기의 Redde에도 표시됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lagres på Hermes-tjeneren din når boten er laget, så Redde på de andre enhetene dine viser det også."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bewaard op je Hermes-server zodra de bot is gemaakt, zodat Redde op je andere apparaten het ook toont."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Po utworzeniu bota przechowywane na Twoim serwerze Hermes, więc Redde na innych urządzeniach też to pokazuje."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guardado no seu servidor Hermes depois que o bot é criado, então o Redde nos seus outros dispositivos também mostra."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "После создания бота хранится на вашем сервере Hermes, поэтому Redde на других ваших устройствах тоже это покажет."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sparas på din Hermes-server när boten har skapats, så att Redde på dina andra enheter också visar det."
          }
        },

    "Its folder and its conversations stay on the server. The conversations just aren't grouped under it any more." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dens mappe og dens samtaler bliver på serveren. Samtalerne er bare ikke længere samlet under den."
          }
        },
        "de" : {
          "stringUnit" : {

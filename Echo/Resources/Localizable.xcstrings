    "Filed as soon as your server can be reached, in a chat called Notes." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gemmes, så snart din server kan nås, i en chat, der hedder Notes."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wird abgelegt, sobald dein Server erreichbar ist, in einem Chat namens „Notes“."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se guarda en cuanto se pueda contactar con tu servidor, en un chat llamado Notes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Classée dès que votre serveur est joignable, dans une discussion nommée Notes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Archiviata appena il server è raggiungibile, in una chat chiamata “Notes”."

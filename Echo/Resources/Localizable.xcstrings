    "Works with Hermes, the open-source agent you run on your own machine, or any OpenAI-compatible model server." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fungerer med Hermes, den open source-agent, du kører på din egen maskine, eller en hvilken som helst OpenAI-kompatibel modelserver."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Funktioniert mit Hermes, dem Open-Source-Agenten auf deinem eigenen Rechner, oder jedem OpenAI-kompatiblen Modellserver."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Funciona con Hermes, el agente de código abierto que ejecutas en tu propia máquina, o con cualquier servidor de modelos compatible con OpenAI."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fonctionne avec Hermes, l’agent open source que vous exécutez sur votre propre machine, ou tout serveur de modèles compatible OpenAI."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Funziona con Hermes, l'agente open source che esegui sulla tua macchina, o con qualsiasi server di modelli compatibile con OpenAI."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自分のマシンで動かすオープンソースのエージェントHermes、または任意のOpenAI互換モデルサーバで動作します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "직접 운영하는 컴퓨터에서 실행하는 오픈 소스 에이전트인 Hermes 또는 모든 OpenAI 호환 모델 서버와 함께 작동합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fungerer med Hermes, agenten med åpen kildekode som du kjører på din egen maskin, eller en hvilken som helst OpenAI-kompatibel modelltjener."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Werkt met Hermes, de opensource-agent die je op je eigen machine draait, of met elke OpenAI-compatibele modelserver."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Działa z Hermesem, agentem open source uruchamianym na Twoim własnym komputerze, lub dowolnym serwerem modeli zgodnym z OpenAI."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Funciona com o Hermes, o agente de código aberto que você roda na sua própria máquina, ou com qualquer servidor de modelos compatível com OpenAI."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Работает с Hermes — агентом с открытым исходным кодом, который вы запускаете на своем компьютере, — или с любым сервером моделей, совместимым с OpenAI."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fungerar med Hermes, agenten med öppen källkod som du kör på din egen dator, eller med valfri OpenAI-kompatibel modellserver."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kendi makinenizde çalıştırdığınız açık kaynaklı ajan Hermes ile ya da OpenAI uyumlu herhangi bir model sunucusuyla çalışır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Працює з Hermes — агентом із відкритим кодом, який ви запускаєте на власному комп’ютері, — або з будь-яким сервером моделей, сумісним з OpenAI."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "可配合Hermes（你在自己机器上运行的开源智能体）或任何OpenAI兼容的模型服务器使用。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "可搭配 Hermes（在你自己機器上執行的開源代理），或任何相容 OpenAI 的模型伺服器使用。"
          }
        }
      }
    },

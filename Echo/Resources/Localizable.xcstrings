    "Redde couldn't tell where you are. Allow Location for Redde in Settings, or type an address." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Redde kunne ikke finde ud af, hvor du er. Tillad lokalitet for Redde i Indstillinger, eller skriv en adresse."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Redde konnte nicht feststellen, wo du bist. Erlaube den Standort für Redde in den Einstellungen oder gib eine Adresse ein."

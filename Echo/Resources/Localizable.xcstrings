    "Lock the phone or switch apps, and the reply you asked for carries on to the end." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lås telefonen, eller skift app, og det svar, du bad om, fortsætter til ende."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sperre das iPhone oder wechsle die App, und die angefragte Antwort läuft bis zum Ende weiter."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bloquea el teléfono o cambia de app, y la respuesta que pediste sigue hasta el final."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verrouillez le téléphone ou changez d’app : la réponse demandée continue jusqu’au bout."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blocca il telefono o cambia app, e la risposta che hai chiesto prosegue fino alla fine."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhoneをロックしたりアプリを切り替えたりしても、リクエストした返答は最後まで続きます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "휴대폰을 잠그거나 앱을 전환해도 요청한 응답은 끝까지 계속됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lås telefonen eller bytt app, så fortsetter svaret du ba om, helt til slutt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vergrendel je telefoon of wissel van app, en het antwoord waar je om vroeg gaat door tot het einde."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zablokuj telefon lub przełącz aplikację, a odpowiedź, o którą prosisz, będzie kontynuowana do końca."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bloqueie o telefone ou mude de app, e a resposta que você pediu continua até o fim."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Заблокируйте телефон или переключитесь на другое приложение — запрошенный ответ все равно будет получен до конца."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lås telefonen eller byt app, så fortsätter svaret du bad om till slutet."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Telefonu kilitleseniz ya da uygulama değiştirseniz de istediğiniz yanıt sonuna kadar devam eder."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Замкніть телефон або перейдіть в іншу програму — запитана відповідь триватиме до кінця."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "锁定手机或切换App，你请求的回复仍会继续直到完成。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "即使鎖定手機或切換 App，你要求的回覆也會持續到結束。"
          }
        }
      }
    },

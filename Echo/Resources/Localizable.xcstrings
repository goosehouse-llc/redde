    "Swipe right on a chat and your conversation list slides in from the left. Tap the chat or drag it back to close." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skub til højre på en chat, så glider din samtaleliste ind fra venstre. Tryk på chatten, eller træk den tilbage for at lukke."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Streiche in einem Chat nach rechts, und deine Konversationsliste gleitet von links herein. Tippe auf den Chat oder zieh ihn zurück, um sie zu schließen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desliza hacia la derecha en un chat y tu lista de conversaciones entra desde la izquierda. Toca el chat o arrástralo de vuelta para cerrarla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Balayez une discussion vers la droite et votre liste de conversations glisse depuis la gauche. Touchez la discussion ou faites-la glisser en arrière pour fermer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scorri verso destra su una chat e l'elenco delle conversazioni entra da sinistra. Tocca la chat o trascinala indietro per chiuderlo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "チャットで右にスワイプすると、左から会話リストが表示されます。閉じるにはチャットをタップするか、ドラッグして戻します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "채팅에서 오른쪽으로 쓸어넘기면 대화 목록이 왼쪽에서 나타납니다. 닫으려면 채팅을 탭하거나 다시 드래그하십시오."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sveip til høyre i en chat, så glir samtalelisten inn fra venstre. Trykk på chatten eller dra den tilbake for å lukke."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veeg naar rechts op een chat en je gesprekkenlijst schuift van links in beeld. Tik op de chat of sleep hem terug om te sluiten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przesuń czat w prawo, a lista rozmów wysunie się z lewej. Stuknij czat lub przeciągnij go z powrotem, aby zamknąć."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deslize para a direita em uma conversa e sua lista de conversas entra pela esquerda. Toque na conversa ou arraste-a de volta para fechar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Смахните вправо в чате, и список разговоров выедет слева. Чтобы закрыть его, коснитесь чата или перетащите его обратно."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Svep åt höger på en chatt så glider konversationslistan in från vänster. Tryck på chatten eller dra tillbaka den för att stänga."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir sohbette sağa kaydırın, konuşma listeniz soldan kayarak gelsin. Kapatmak için sohbete dokunun ya da listeyi geri sürükleyin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Посуньте чат праворуч, і список розмов виїде зліва. Торкніться чату або посуньте його назад, щоб закрити."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在聊天上向右轻扫，对话列表就会从左侧滑入。轻点聊天或将其拖回即可关闭。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在聊天上向右滑動，你的對話列表就會從左側滑入。點一下聊天或將它拖回即可關閉。"
          }
        }
      }
    },
    "Swipe right to have it done, left if you've done it or to put it away." : {
      "extractionState" : "stale",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stryg til højre for at få det gjort, til venstre hvis du har gjort det, eller for at lægge det væk."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wische nach rechts, damit es erledigt wird, nach links, wenn du es schon erledigt hast oder es weglegen willst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desliza a la derecha para que se haga, o a la izquierda si ya lo hiciste o para dejarlo para luego."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Balayez vers la droite pour que ce soit fait, vers la gauche si vous l’avez déjà fait ou pour le mettre de côté."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scorri a destra per farlo fare, a sinistra se l’hai già fatto o per metterlo da parte."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "右にスワイプで実行、左にスワイプで完了済みにするか、しまいます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "오른쪽으로 밀면 처리되고, 왼쪽으로 밀면 완료로 표시하거나 치워 둡니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sveip til høyre for å få det gjort, til venstre hvis du har gjort det, eller for å legge det bort."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veeg naar rechts om het te laten doen, naar links als je het al gedaan hebt of om het weg te leggen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przesuń w prawo, aby to zrobić, w lewo, jeśli już to zrobiłeś lub chcesz to odłożyć."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deslize para a direita para que seja feito, ou para a esquerda se você já fez ou para deixar de lado."

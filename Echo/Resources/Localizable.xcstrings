    "Tap to try again" : {
      "comment" : "Voice mode's state, on the Lock Screen's player",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tryk for at prøve igen"
          }
        },
        "de" : {

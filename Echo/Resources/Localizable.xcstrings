          "stringUnit" : {
            "state" : "translated",
            "value" : "已開啟。說「更多」聽其餘內容。"
          }
        }
      }
    },
    "Once" : {
      "comment" : "Approval button: allow the command this one time",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Én gang"
          }
        },
        "de" : {

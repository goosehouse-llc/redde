    "Find photos by date, kind and what they show, look at one, and delete (iOS asks you each time)." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Find fotos efter dato, type og hvad de viser, se på et, og slet (iOS spørger dig hver gang)."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fotos nach Datum, Art und Inhalt finden, eines ansehen und löschen (iOS fragt jedes Mal nach)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Buscar fotos por fecha, tipo y lo que muestran, ver una y eliminar (iOS te pregunta cada vez)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trouver des photos par date, type et contenu, en regarder une, et supprimer (iOS vous demande à chaque fois)."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trova foto per data, tipo e contenuto, ne guarda una ed elimina (iOS te lo chiede ogni volta)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "日付、種類、写っているもので写真を探し、写真を見たり削除したりします（iOSが毎回確認します）。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "날짜, 종류 및 내용으로 사진을 찾고, 사진을 보고, 삭제합니다(iOS가 매번 확인을 요청함)."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finn bilder etter dato, type og hva de viser, se på et og slett (iOS spør deg hver gang)."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Foto’s zoeken op datum, soort en wat erop staat, er een bekijken en verwijderen (iOS vraagt het je elke keer)."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wyszukuj zdjęcia według daty, rodzaju i zawartości, oglądaj je i usuwaj (iOS za każdym razem pyta)."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Encontrar fotos por data, tipo e o que mostram, ver uma, e apagar (o iOS pergunta a você toda vez)."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Находить фото по дате, типу и содержимому, просматривать и удалять (iOS каждый раз спрашивает вас)."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hitta bilder efter datum, typ och vad de visar, titta på en och radera (iOS frågar dig varje gång)."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fotoğrafları tarihe, türe ve gösterdiklerine göre bul, birine bak ve sil (iOS her seferinde size sorar)."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Шукати фото за датою, типом і вмістом, переглядати й видаляти (iOS щоразу питає вас)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按日期、类型和内容查找照片、查看照片和删除照片（iOS每次都会询问你）。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "依日期、類型和內容尋找照片、查看照片，以及刪除（iOS 每次都會詢問你）。"
          }
        }
      }
    },

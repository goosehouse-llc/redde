            "value" : "ゲートウェイを再起動しますか？"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "게이트웨이를 재시작하겠습니까?"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starte gatewayen på nytt?"
          }
        },

    "OpenAI bills the key's account $0.05 a minute, quiet minutes too." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenAI opkræver nøglens konto 0,05 $ pr. minut, også for stille minutter."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenAI berechnet dem Account des Schlüssels 0,05 $ pro Minute, auch für stille Minuten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenAI cobra 0,05 USD por minuto a la cuenta de la clave, también los minutos de silencio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenAI facture 0,05 $ par minute au compte de la clé, minutes de silence comprises."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenAI addebita 0,05 $ al minuto all'account della chiave, anche per i minuti di silenzio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenAIはキーのアカウントに1分あたり$0.05を請求します（無音の時間も含む）。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenAI는 조용한 시간도 포함하여 키의 계정에 분당 $0.05를 청구합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenAI belaster nøkkelens konto 0,05 $ per minutt, også for stille minutter."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenAI rekent $ 0,05 per minuut aan het account van de sleutel, ook voor stille minuten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenAI obciąża konto klucza kwotą 0,05 USD za minutę, również za minuty ciszy."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A OpenAI cobra US$ 0,05 por minuto da conta da chave, inclusive os minutos em silêncio."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenAI списывает со счета ключа $0,05 в минуту, включая минуты тишины."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenAI debiterar nyckelns konto 0,05 USD per minut, även tysta minuter."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenAI, anahtarın hesabından dakika başına 0,05 $ ücret alır, sessiz dakikalar dahil."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenAI стягує з облікового запису ключа 0,05 $ за хвилину, навіть за тихі хвилини."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenAI按每分钟0.05美元向该密钥的账户计费，安静的分钟也计费。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenAI 會向金鑰的帳號每分鐘收取 $0.05，安靜的時間也算。"
          }
        }
      }

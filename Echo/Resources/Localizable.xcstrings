            "state" : "translated",
            "value" : "轻点“完成”，然后在表单中添加。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "點一下「完成」，然後在表單中加入。"
          }
        }
      }
    },
    "Tap the orb and talk to the group." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tryk på kuglen, og tal med gruppen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippe auf die Kugel und sprich mit der Gruppe."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca el orbe y habla con el grupo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchez l’orbe et parlez au groupe."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tocca la sfera e parla al gruppo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "オーブをタップしてグループに話しかけてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "오브를 탭하고 그룹에게 말하십시오."
          }
        },
        "nb" : {
          "stringUnit" : {

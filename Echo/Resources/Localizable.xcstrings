    "Shows you what it will do, as a card to approve, before anything is sent, booked, bought or changed." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viser dig, hvad den vil gøre, som et kort, du skal godkende, før noget sendes, bookes, købes eller ændres."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeigt dir als Karte zum Genehmigen, was getan wird, bevor etwas gesendet, gebucht, gekauft oder geändert wird."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Te muestra lo que va a hacer, como una tarjeta para aprobar, antes de enviar, reservar, comprar o cambiar nada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous montre ce qu’il va faire, sous forme de carte à approuver, avant que quoi que ce soit soit envoyé, réservé, acheté ou modifié."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ti mostra cosa farà, come scheda da approvare, prima che qualcosa venga inviato, prenotato, comprato o modificato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "何かを送信、予約、購入、変更する前に、何をするかを承認用のカードで示します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "무언가를 보내거나 예약하거나 구매하거나 변경하기 전에, 할 일을 승인용 카드로 보여줍니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viser deg hva den skal gjøre, som et kort du godkjenner, før noe sendes, bookes, kjøpes eller endres."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toont je wat het gaat doen, als kaart om goed te keuren, voordat er iets wordt verstuurd, geboekt, gekocht of gewijzigd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pokazuje, co zrobi, jako kartę do zatwierdzenia, zanim cokolwiek zostanie wysłane, zarezerwowane, kupione lub zmienione."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra o que vai fazer, como um cartão para aprovar, antes de qualquer coisa ser enviada, reservada, comprada ou alterada."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Показывает, что собирается сделать, карточкой для одобрения, прежде чем что-либо будет отправлено, забронировано, куплено или изменено."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Visar vad den kommer att göra, som ett kort att godkänna, innan något skickas, bokas, köps eller ändras."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir şey gönderilmeden, rezerve edilmeden, satın alınmadan ya da değiştirilmeden önce ne yapacağını onaylamanız için bir kart olarak gösterir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Показує, що збирається зробити, карткою для схвалення, перш ніж щось буде надіслано, заброньовано, куплено або змінено."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在发送、预订、购买或更改任何东西之前，先以待批准的卡片形式向你展示它要做什么。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在傳送、預訂、購買或更改任何東西之前，先以待核准的卡片向你顯示它要做什麼。"
          }
        }
      }
    },

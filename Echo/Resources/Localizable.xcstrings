    "A folder of that name is made in ~/Projects on your server, and this conversation works in it from now on." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En mappe med det navn oprettes i ~/Projects på din server, og denne samtale arbejder i den fra nu af."

            "value" : "Każda ma własną stronę w Ustawienia → Agent, gdzie zmienisz godzinę lub ją wyłączysz."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada um tem sua própria página em Ajustes → Agente, para mudar o horário ou desativar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "У каждой функции есть своя страница в «Настройки» → «Агент», где можно изменить время или выключить её."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Var och en har en egen sida i Inställningar → Agent, där du kan ändra tiden eller stänga av den."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Her birinin Ayarlar → Ajan bölümünde kendi sayfası vardır; saatini oradan değiştirebilir veya kapatabilirsiniz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Кожна функція має власну сторінку в «Параметри» → «Агент», де можна змінити час або вимкнути її."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每一项在“设置 → 智能体”中都有自己的页面，可在那里更改时间或关闭。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每一項在「設定 → 代理」中都有自己的頁面，可在那裡更改時間或關閉。"
          }
        }
      }
    },
    "Each Hermes profile has its own API key (API_SERVER_KEY in the profile's .env). Enter it under Settings → Profile." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hver Hermes-profil har sin egen API-nøgle (API_SERVER_KEY i profilens .env). Indtast den under Indstillinger → Profil."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jedes Hermes-Profil hat einen eigenen API-Schlüssel (API_SERVER_KEY in der .env des Profils). Gib ihn unter Einstellungen → Profil ein."
          }
        },
        "es" : {
          "stringUnit" : {

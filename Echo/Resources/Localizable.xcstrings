          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Te groot: Hermes neemt en geeft maximaal %@ als één bestand."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Za duży: Hermes przyjmuje i wydaje najwyżej %@ w jednym pliku."
          }
        },
        "pt-BR" : {

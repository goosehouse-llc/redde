    "Redde can't schedule messages. Ask it to set up a cron job instead." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Redde kan ikke planlægge beskeder. Bed den om at oprette et cron-job i stedet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Redde kann keine Nachrichten planen. Bitte es stattdessen, einen Cron-Job einzurichten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Redde no puede programar mensajes. Pídele que configure una tarea cron."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Redde ne peut pas planifier de messages. Demandez-lui plutôt de configurer une tâche cron."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Redde non può pianificare messaggi. Chiedile invece di configurare un cron job."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reddeはメッセージを予約できません。代わりにcronジョブの設定を頼んでください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Redde는 메시지를 예약할 수 없습니다. 대신 cron 작업을 설정하도록 요청하십시오."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Redde kan ikke planlegge meldinger. Be den sette opp en cron-jobb i stedet."

    "Which voice reads %@'s replies aloud: in voice mode when that isn't a call, in group chats, in the car and with Read aloud." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvilken stemme der læser svar fra %@ op: i stemmetilstand, når det ikke er et opkald, i gruppechats, i bilen og med Læs højt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Welche Stimme die Antworten von %@ vorliest: im Sprachmodus, wenn er kein Anruf ist, in Gruppenchats, im Auto und mit „Vorlesen“."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qué voz lee en voz alta las respuestas de %@: en el modo de voz cuando no es una llamada, en los chats de grupo, en el coche y con Leer en voz alta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La voix qui lit à voix haute les réponses de %@ : en mode vocal quand ce n’est pas un appel, dans les discussions de groupe, en voiture et avec Lire à voix haute."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quale voce legge ad alta voce le risposte di %@: in modalità vocale quando non è una chiamata, nelle chat di gruppo, in auto e con Leggi ad alta voce."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@の返答を読み上げる音声：通話ではない音声モード、グループチャット、車内、「読み上げ」で使用されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@의 응답을 소리 내어 읽는 음성: 통화가 아닌 음성 모드, 그룹 채팅, 차량 및 소리 내어 읽기에서 사용됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvilken stemme som leser opp svarene til %@: i stemmemodus når det ikke er en samtale, i gruppechatter, i bilen og med Les opp."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Welke stem de antwoorden van %@ voorleest: in spraakmodus als dat geen gesprek is, in groepschats, in de auto en met ‘Lees voor’."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Który głos czyta na głos odpowiedzi %@: w trybie głosowym, gdy nie jest połączeniem, w czatach grupowych, w samochodzie i w funkcji Czytaj na głos."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qual voz lê as respostas de %@ em voz alta: no modo de voz quando ele não é uma chamada, nas conversas em grupo, no carro e com Ler em voz alta."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Каким голосом читаются ответы %@: в голосовом режиме вне звонка, в групповых чатах, в машине и через «Прочитать вслух»."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vilken röst som läser upp %@s svar: i röstläge när det inte är ett samtal, i gruppchattar, i bilen och med Läs högt."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ yanıtlarını hangi sesin sesli okuyacağı: arama olmadığında sesli modda, grup sohbetlerinde, arabada ve Sesli oku ile."
          }
        },
        "uk" : {
          "stringUnit" : {

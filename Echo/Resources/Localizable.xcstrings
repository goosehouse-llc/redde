    "To list this device's calendars too, allow Redde full access to Calendars in Settings, under Privacy & Security." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For også at vise denne enheds kalendere skal du give Redde fuld adgang til Kalender i Indstillinger under Anonymitet & sikkerhed."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um auch die Kalender dieses Geräts aufzulisten, erlaube Redde in den Einstellungen unter „Datenschutz & Sicherheit“ vollen Zugriff auf Kalender."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para ver también los calendarios de este dispositivo, da a Redde acceso total a Calendario en Ajustes, en Privacidad y seguridad."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour lister aussi les calendriers de cet appareil, accordez à Redde l'accès complet à Calendrier dans Réglages, sous Confidentialité et sécurité."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per elencare anche i calendari di questo dispositivo, concedi a Redde l'accesso completo a Calendario in Impostazioni, in Privacy e sicurezza."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このデバイスのカレンダーも表示するには、「設定」の「プライバシーとセキュリティ」で、Reddeにカレンダーへのフルアクセスを許可してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 기기의 캘린더도 표시하려면 설정의 개인정보 보호 및 보안에서 Redde에 캘린더 전체 접근 권한을 허용하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For å vise denne enhetens kalendere også, gi Redde full tilgang til Kalender i Innstillinger, under Personvern og sikkerhet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wil je ook de agenda's van dit apparaat zien, geef Redde dan volledige toegang tot Agenda in Instellingen, onder Privacy en beveiliging."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aby wyświetlić także kalendarze z tego urządzenia, daj Redde pełny dostęp do Kalendarza w Ustawieniach, w sekcji Prywatność i ochrona."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para listar também os calendários deste dispositivo, dê ao Redde acesso total ao Calendário em Ajustes, em Privacidade e Segurança."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чтобы показать и календари этого устройства, разрешите Redde полный доступ к Календарю в Настройках, в разделе «Конфиденциальность и безопасность»."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "För att också visa den här enhetens kalendrar, ge Redde full åtkomst till Kalender i Inställningar, under Integritet och säkerhet."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu aygıttaki takvimleri de listelemek için Ayarlar'da Gizlilik ve Güvenlik altında Redde'ye Takvim'e tam erişim izni verin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Щоб показати й календарі цього пристрою, дозвольте Redde повний доступ до Календаря в Параметрах, у розділі «Приватність і безпека»."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "要同时列出此设备上的日历，请在“设置”的“隐私与安全性”中允许 Redde 完全访问日历。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "若要同時列出此裝置上的行事曆，請在「設定」的「隱私權與安全性」中允許 Redde 完整取用行事曆。"
          }
        }
      }
    },

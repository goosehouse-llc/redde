    "Sign in to your server over SSH, with a key made on this iPhone. Passwords aren't used." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Log ind på din server via SSH med en nøgle, der er lavet på denne iPhone. Adgangskoder bruges ikke."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Melde dich per SSH bei deinem Server an, mit einem auf diesem iPhone erstellten Schlüssel. Passwörter werden nicht verwendet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inicia sesión en tu servidor por SSH, con una clave creada en este iPhone. No se usan contraseñas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connectez-vous à votre serveur en SSH, avec une clé créée sur cet iPhone. Les mots de passe ne sont pas utilisés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accedi al tuo server tramite SSH, con una chiave creata su questo iPhone. Le password non vengono usate."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このiPhoneで作成したキーを使い、SSHでサーバにサインインします。パスワードは使用しません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 iPhone에서 만든 키로 SSH를 통해 서버에 로그인합니다. 암호는 사용하지 않습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Logg på tjeneren din over SSH, med en nøkkel laget på denne iPhonen. Passord brukes ikke."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Log in op je server via SSH, met een sleutel die op deze iPhone is gemaakt. Wachtwoorden worden niet gebruikt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Loguj się na serwer przez SSH kluczem utworzonym na tym iPhonie. Hasła nie są używane."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inicie sessão no seu servidor por SSH, com uma chave criada neste iPhone. Senhas não são usadas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вход на сервер по SSH с ключом, созданным на этом iPhone. Пароли не используются."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Logga in på din server över SSH, med en nyckel som skapats på den här iPhonen. Lösenord används inte."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu iPhone'da oluşturulan bir anahtarla SSH üzerinden sunucunuza giriş yapın. Parola kullanılmaz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вхід на ваш сервер через SSH за допомогою ключа, створеного на цьому iPhone. Паролі не використовуються."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通过SSH登录你的服务器，使用在此iPhone上生成的密钥。不使用密码。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",

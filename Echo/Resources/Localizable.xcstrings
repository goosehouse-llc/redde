    "Its tools weren't set: it has all of your agent's for now." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dens værktøjer blev ikke indstillet: den har alle din agents indtil videre."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seine Tools wurden nicht festgelegt: Vorerst hat er alle deines Agenten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se definieron sus herramientas: por ahora tiene todas las de tu agente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ses outils n’ont pas été définis : il a tous ceux de votre agent pour l’instant."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I suoi strumenti non sono stati impostati: per ora ha tutti quelli del tuo agente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ツールは設定されませんでした。現在はエージェントのすべてのツールを使用できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "도구가 설정되지 않았습니다. 지금은 에이전트의 모든 도구를 사용합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verktøyene ble ikke angitt: den har alle agentens verktøy inntil videre."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De tools zijn niet ingesteld: voorlopig heeft het alle tools van je agent."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie ustawiono jego narzędzi: na razie ma wszystkie narzędzia Twojego agenta."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As ferramentas dele não foram definidas: por enquanto, ele tem todas as do seu agente."
          }
        },

          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La modalità vocale è una chiamata %@: la voce di %@ parla e ascolta insieme, e passa tutto ciò che conta al tuo agente. I bot possono avere la propria (Modifica bot → Voce)."
          }
        },
        "ja" : {
          "stringUnit" : {

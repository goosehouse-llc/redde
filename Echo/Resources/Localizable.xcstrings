        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Смахните вправо, чтобы это сделали, влево — если вы уже сделали это сами или чтобы отложить."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",

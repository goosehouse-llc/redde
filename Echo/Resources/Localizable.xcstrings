    "GitHub's limit for checks is reached; try again in an hour." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GitHubs grænse for tjek er nået. Prøv igen om en time."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Limit von GitHub für Prüfungen ist erreicht. Versuch es in einer Stunde erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se alcanzó el límite de comprobaciones de GitHub; vuelve a intentarlo dentro de una hora."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La limite de vérifications de GitHub est atteinte ; réessayez dans une heure."
          }
        },
        "it" : {
          "stringUnit" : {

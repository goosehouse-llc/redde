        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Pfad auf dem Hermes-Host. ~ ist das Home-Verzeichnis seines Benutzers."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una ruta en el host de Hermes. ~ es la carpeta de inicio de su usuario."
          }
        },
        "fr" : {

    "A header name is letters, digits and hyphens, without spaces or a colon." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Et headernavn består af bogstaver, tal og bindestreger, uden mellemrum eller kolon."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Header-Name besteht aus Buchstaben, Ziffern und Bindestrichen, ohne Leerzeichen oder Doppelpunkt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El nombre de un encabezado lleva letras, dígitos y guiones, sin espacios ni dos puntos."
          }
        },
        "fr" : {
          "stringUnit" : {

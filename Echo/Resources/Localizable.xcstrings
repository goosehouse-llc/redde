    "The Hermes server itself: what it is connected to, its MCP servers and logs, and restarting or updating it." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selve Hermes-serveren: hvad den er forbundet til, dens MCP-servere og logfiler, og genstart eller opdatering af den."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Hermes-Server selbst: womit er verbunden ist, seine MCP-Server und Protokolle sowie Neustart oder Update."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El propio servidor Hermes: a qué está conectado, sus servidores MCP y registros, y reiniciarlo o actualizarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le serveur Hermes lui-même : ce à quoi il est connecté, ses serveurs MCP et ses journaux, et son redémarrage ou sa mise à jour."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il server Hermes stesso: a cosa è connesso, i suoi server MCP e i log, e il suo riavvio o aggiornamento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermesサーバ本体：接続先、MCPサーバ、ログ、再起動やアップデート。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes 서버 자체: 연결 대상, MCP 서버 및 로그, 재시작 또는 업데이트."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selve Hermes-tjeneren: hva den er koblet til, MCP-tjenerne og loggene, og omstart eller oppdatering av den."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De Hermes-server zelf: waarmee hij verbonden is, zijn MCP-servers en logs, en hem herstarten of bijwerken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sam serwer Hermes: z czym jest połączony, jego serwery MCP i dzienniki oraz ponowne uruchamianie i uaktualnianie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O próprio servidor Hermes: ao que está conectado, seus servidores MCP e registros, e como reiniciá-lo ou atualizá-lo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сам сервер Hermes: к чему он подключен, его серверы MCP и журналы, перезапуск и обновление."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Själva Hermes-servern: vad den är ansluten till, dess MCP-servrar och loggar, samt omstart och uppdatering."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes sunucusunun kendisi: neye bağlı olduğu, MCP sunucuları ve günlükleri, yeniden başlatma ya da güncelleme."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сам сервер Hermes: до чого він під’єднаний, його сервери MCP і журнали, а також перезапуск чи оновлення."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes服务器本身：它连接的内容、它的MCP服务器和日志，以及重新启动或更新它。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes 伺服器本身：它連接的項目、MCP 伺服器和日誌，以及重新啟動或更新。"
          }
        }
      }
    },
    "The Hermes server itself: what it is connected to, its MCP servers and logs, and restarting or updating it. Needs the Hermes Dashboard login." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selve Hermes-serveren: hvad den er forbundet til, dens MCP-servere og logfiler, og genstart eller opdatering af den. Kræver login til Hermes Dashboard."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Hermes-Server selbst: womit er verbunden ist, seine MCP-Server und Protokolle sowie Neustart oder Update. Braucht die Hermes-Dashboard-Anmeldung."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El propio servidor Hermes: a qué está conectado, sus servidores MCP y registros, y reiniciarlo o actualizarlo. Necesita el inicio de sesión del Hermes Dashboard."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le serveur Hermes lui-même : ce à quoi il est connecté, ses serveurs MCP et ses journaux, et son redémarrage ou sa mise à jour. Requiert l’identifiant du Hermes Dashboard."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il server Hermes stesso: a cosa è connesso, i suoi server MCP e i log, e il suo riavvio o aggiornamento. Richiede l'accesso alla Hermes Dashboard."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermesサーバ本体：接続先、MCPサーバ、ログ、再起動やアップデート。Hermes Dashboardのログイン情報が必要です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes 서버 자체: 연결 대상, MCP 서버 및 로그, 재시작 또는 업데이트. Hermes Dashboard 로그인이 필요합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selve Hermes-tjeneren: hva den er koblet til, MCP-tjenerne og loggene, og omstart eller oppdatering av den. Krever påloggingen til Hermes Dashboard."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De Hermes-server zelf: waarmee hij verbonden is, zijn MCP-servers en logs, en hem herstarten of bijwerken. Vereist de Hermes Dashboard-login."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sam serwer Hermes: z czym jest połączony, jego serwery MCP i dzienniki oraz ponowne uruchamianie i uaktualnianie. Wymaga loginu do Hermes Dashboard."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O próprio servidor Hermes: ao que está conectado, seus servidores MCP e registros, e como reiniciá-lo ou atualizá-lo. Precisa do login do Hermes Dashboard."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сам сервер Hermes: к чему он подключен, его серверы MCP и журналы, перезапуск и обновление. Нужен вход в Hermes Dashboard."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Själva Hermes-servern: vad den är ansluten till, dess MCP-servrar och loggar, samt omstart och uppdatering. Kräver inloggningen för Hermes Dashboard."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes sunucusunun kendisi: neye bağlı olduğu, MCP sunucuları ve günlükleri, yeniden başlatma ya da güncelleme. Hermes Dashboard girişi gerekir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сам сервер Hermes: до чого він під’єднаний, його сервери MCP і журнали, а також перезапуск чи оновлення. Потрібні дані входу Hermes Dashboard."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes服务器本身：它连接的内容、它的MCP服务器和日志，以及重新启动或更新它。需要Hermes Dashboard登录信息。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes 伺服器本身：它連接的項目、MCP 伺服器和日誌，以及重新啟動或更新。需要 Hermes Dashboard 登入資訊。"
          }
        }
      }
    },

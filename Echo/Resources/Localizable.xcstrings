    "I'm home: turn on the hall light." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeg er hjemme: tænd lyset i gangen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ich bin zu Hause: Mach das Licht im Flur an."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ya estoy en casa: enciende la luz del pasillo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Me voilà : allume la lumière de l’entrée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sono a casa: accendi la luce dell'ingresso."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ただいま。廊下の電気をつけて。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "집에 왔어: 복도 불 켜 줘."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeg er hjemme: slå på lyset i gangen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ik ben thuis: doe de lamp in de gang aan."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jestem w domu: włącz światło w przedpokoju."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cheguei em casa: acenda a luz do corredor."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Я дома: включи свет в прихожей."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jag är hemma: tänd lampan i hallen."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eve geldim: koridor ışığını aç."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Я вдома: увімкни світло в передпокої."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我到家了：打开走廊的灯。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我到家了：打開走廊的燈。"
          }
        }
      }
    },
    "I'm home: warm the house to 21° and turn on the hall light." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeg er hjemme: varm huset op til 21°, og tænd lyset i gangen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ich bin zu Hause: Heiz das Haus auf 21° und mach das Licht im Flur an."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ya estoy en casa: calienta la casa a 21° y enciende la luz del pasillo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Me voilà : chauffe la maison à 21° et allume la lumière de l’entrée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sono a casa: scalda la casa a 21° e accendi la luce dell'ingresso."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ただいま。家を21°まで暖めて、廊下の電気をつけて。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "집에 왔어: 집을 21°로 데우고 복도 불 켜 줘."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeg er hjemme: varm opp huset til 21° og slå på lyset i gangen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ik ben thuis: verwarm het huis tot 21° en doe de lamp in de gang aan."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jestem w domu: ogrzej dom do 21° i włącz światło w przedpokoju."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cheguei em casa: aqueça a casa a 21° e acenda a luz do corredor."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Я дома: нагрей дом до 21° и включи свет в прихожей."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jag är hemma: värm upp huset till 21° och tänd lampan i hallen."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eve geldim: evi 21°'ye ısıt ve koridor ışığını aç."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Я вдома: нагрій дім до 21° і ввімкни світло в передпокої."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我到家了：把家里加热到21°，打开走廊的灯。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我到家了：把家裡暖到 21°，打開走廊的燈。"
          }
        }
      }
    },
    "I've left: lock up and turn the heating down." : {
      "localizations" : {
        "da" : {

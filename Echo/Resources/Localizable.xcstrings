          "stringUnit" : {
            "state" : "translated",
            "value" : "Auf einen Commit festgelegt: Es bleibt dort, bis es neu installiert wird."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fijado a un commit: se queda ahí hasta que se vuelva a instalar."
          }

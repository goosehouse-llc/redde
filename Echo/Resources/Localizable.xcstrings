        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dina Hermes-projekt, ovanför konversationerna. Avstängt finns deras konversationer fortfarande i listan."
          }
        },
        "tr" : {
          "stringUnit" : {

          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Do odsłuchania głosu potrzebny jest Twój klucz %@ w Ustawienia → Głos → Tryb głosowy."
          }
        },
        "pt-BR" : {
          "stringUnit" : {

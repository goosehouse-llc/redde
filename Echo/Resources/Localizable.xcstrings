    "Keep listening after each reply until you say “stop listening”." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bliv ved med at lytte efter hvert svar, indtil du siger “stop listening”."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nach jeder Antwort weiter zuhören, bis du „stop listening“ sagst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seguir escuchando tras cada respuesta hasta que digas “stop listening”."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Continuer d’écouter après chaque réponse jusqu’à ce que vous disiez « stop listening »."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Continua ad ascoltare dopo ogni risposta finché non dici “stop listening”."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「stop listening」と言うまで、返答のたびに聞き取りを続けます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“stop listening”이라고 말할 때까지 응답 후에도 계속 듣습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fortsett å lytte etter hvert svar til du sier «stop listening»."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blijf na elk antwoord luisteren tot je ‘stop listening’ zegt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Słuchaj dalej po każdej odpowiedzi, aż powiesz „stop listening”."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Continuar ouvindo após cada resposta até você dizer “stop listening”."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Слушать после каждого ответа, пока вы не скажете «stop listening»."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fortsätt lyssna efter varje svar tills du säger ”stop listening”."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“stop listening” diyene kadar her yanıttan sonra dinlemeyi sürdür."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Слухати далі після кожної відповіді, доки ви не скажете «stop listening»."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每次回复后继续聆听，直到你说“stop listening”。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每則回覆後持續聆聽，直到你說「stop listening」。"
          }
        }
      }
    },
    "Keeps your plans, lists and reminders, and nudges you on time." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Holder styr på dine planer, lister og påmindelser og minder dig om tingene i tide."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwaltet deine Pläne, Listen und Erinnerungen und erinnert dich rechtzeitig."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guarda tus planes, listas y recordatorios, y te avisa a tiempo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tient vos projets, listes et rappels, et vous relance à temps."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tiene i tuoi piani, elenchi e promemoria, e ti avvisa in tempo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "予定、リスト、リマインダーを管理し、時間どおりにお知らせします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "계획, 목록 및 미리 알림을 관리하고 제때 알려 줍니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Holder orden på planer, lister og påminnelser, og minner deg på ting i tide."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Houdt je plannen, lijsten en herinneringen bij, en geeft je op tijd een seintje."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pilnuje Twoich planów, list i przypomnień oraz przypomina o czasie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuida dos seus planos, listas e lembretes, e avisa você na hora certa."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ведет ваши планы, списки и напоминания и вовремя напоминает о них."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Håller koll på dina planer, listor och påminnelser och ger dig en knuff i tid."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",

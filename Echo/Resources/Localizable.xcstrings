    "Pick a voice below, or type a blend: voice names joined with + and optional weights in parentheses." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vælg en stemme nedenfor, eller skriv en blanding: stemmenavne sat sammen med + og valgfri vægte i parentes."

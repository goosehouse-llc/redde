            "value" : "Hermes henter det fra %@ i versjonen katalogen oppgir, sjekker det og slår det på."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes haalt het op van %@ in de versie die de catalogus noemt, controleert het en zet het aan."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes pobiera ją z %@ w wersji podanej w katalogu, sprawdza i włącza."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Hermes busca em %@ na versão indicada no catálogo, verifica e ativa."
          }
        },

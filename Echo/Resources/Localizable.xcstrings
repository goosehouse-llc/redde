            "value" : "Das Hermes Dashboard konnte nicht gefragt werden. Telefon-Tools brauchen seine Anmeldung: Einstellungen → Verbindungsdetails."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",

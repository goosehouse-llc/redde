    "On the Hermes API they go by the Dashboard's login." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "På Hermes API går de via Dashboard-login."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Über die Hermes API laufen sie über die Dashboard-Anmeldung."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En la Hermes API pasan por el inicio de sesión del Dashboard."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avec Hermes API, ils passent par l’identifiant du Dashboard."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sulla Hermes API passano tramite l'accesso alla Dashboard."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes APIでは、Dashboardのログイン情報を使用します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes API 연결에서는 Dashboard 로그인을 통해 작동합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "På Hermes API går de via Dashboard-påloggingen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Op de Hermes API gaan ze via de login van het Dashboard."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "W Hermes API korzystają z loginu do Dashboard."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",

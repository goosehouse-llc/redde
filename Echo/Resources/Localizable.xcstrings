    "Used for the “ctx %” figure when the backend can't report its window. A llama.cpp server reports it automatically." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bruges til tallet “ctx %”, når backenden ikke kan oplyse sit vindue. En llama.cpp-server oplyser det automatisk."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wird für den Wert „ctx %“ verwendet, wenn das Backend sein Fenster nicht melden kann. Ein llama.cpp-Server meldet es automatisch."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se usa para la cifra “ctx %” cuando el backend no puede informar de su ventana. Un servidor llama.cpp la informa automáticamente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sert au chiffre « ctx % » quand le back-end ne peut pas indiquer sa fenêtre. Un serveur llama.cpp l’indique automatiquement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usato per il valore “ctx %” quando il backend non può indicare la sua finestra. Un server llama.cpp la indica automaticamente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "バックエンドがウインドウサイズを報告できない場合に「ctx %」の値に使用されます。llama.cppサーバは自動的に報告します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "백엔드가 컨텍스트 창 크기를 알려 주지 않을 때 “ctx %” 수치에 사용됩니다. llama.cpp 서버는 자동으로 알려 줍니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brukes for «ctx %»-tallet når backend ikke kan rapportere vinduet sitt. En llama.cpp-tjener rapporterer det automatisk."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gebruikt voor het getal ‘ctx %’ als de backend zijn venster niet kan doorgeven. Een llama.cpp-server geeft het automatisch door."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Używane do wartości „ctx %”, gdy backend nie może podać swojego okna. Serwer llama.cpp podaje je automatycznie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usado para o valor “ctx %” quando o backend não informa a janela. Um servidor llama.cpp informa automaticamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Используется для показателя «конт. %», когда бэкенд не сообщает размер окна. Сервер llama.cpp сообщает его автоматически."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Används för värdet ”ctx %” när backenden inte kan rapportera sitt fönster. En llama.cpp-server rapporterar det automatiskt."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arka uç kendi penceresini bildiremediğinde “ctx %” değeri için kullanılır. Bir llama.cpp sunucusu bunu otomatik olarak bildirir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Використовується для показника «конт. %», коли бекенд не повідомляє розмір свого вікна. Сервер llama.cpp повідомляє його автоматично."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当后端无法报告其窗口大小时，用于计算“ctx %”数值。llama.cpp服务器会自动报告。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "後端無法回報其視窗大小時，用於計算「上下文 %」數值。llama.cpp 伺服器會自動回報。"
          }
        }
      }
    },
    "Useful" : {
      "localizations" : {
        "da" : {
          "stringUnit" : {

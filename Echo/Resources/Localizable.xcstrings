    "A question asked through AirPods sometimes got its answer from the phone's speaker. Not any more." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Et spørgsmål stillet via AirPods fik nogle gange sit svar fra telefonens højttaler. Ikke længere."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine über AirPods gestellte Frage bekam ihre Antwort manchmal über den Lautsprecher des iPhone. Jetzt nicht mehr."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una pregunta hecha con los AirPods a veces recibía la respuesta por el altavoz del teléfono. Ya no."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une question posée via des AirPods recevait parfois sa réponse par le haut-parleur du téléphone. C’est fini."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una domanda fatta tramite AirPods a volte riceveva la risposta dall'altoparlante del telefono. Non più."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AirPodsで質問したのに、iPhoneのスピーカーから回答が流れることがありました。これは修正されました。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AirPods로 한 질문의 응답이 가끔 휴대폰 스피커로 나왔습니다. 이제는 그렇지 않습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Et spørsmål stilt via AirPods fikk noen ganger svaret fra telefonens høyttaler. Ikke lenger."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een vraag via AirPods kreeg soms antwoord uit de luidspreker van de telefoon. Nu niet meer."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pytanie zadane przez AirPods czasem dostawało odpowiedź z głośnika telefonu. Już nie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma pergunta feita pelos AirPods às vezes recebia a resposta pelo alto-falante do telefone. Não mais."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "На вопрос, заданный через AirPods, ответ иногда звучал из динамика телефона. Больше такого нет."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En fråga som ställdes via AirPods fick ibland svaret från telefonens högtalare. Inte längre."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AirPods ile sorulan bir sorunun yanıtı bazen telefonun hoparlöründen geliyordu. Artık gelmiyor."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Відповідь на запитання, поставлене через AirPods, іноді лунала з динаміка телефона. Більше ні."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通过AirPods提出的问题，有时会从手机扬声器播放回答。现在不会了。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "透過 AirPods 提出的問題，有時會從手機揚聲器播放回答。現在不會了。"
          }
        }
      }
    },

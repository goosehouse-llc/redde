    "To find a photo by what it shows, Redde looks at your pictures on this %@ and keeps what it finds here." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For at finde et foto ud fra, hvad det viser, ser Redde på dine billeder på denne %@ og gemmer det, den finder, her."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um ein Foto nach seinem Inhalt zu finden, sieht sich Redde deine Bilder auf diesem %@ an und sichert die Ergebnisse hier."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para encontrar una foto por lo que muestra, Redde mira tus imágenes en este %@ y guarda aquí lo que encuentra."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour trouver une photo d’après son contenu, Redde regarde vos images sur cet %@ et conserve ici ce qu’il y trouve."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per trovare una foto in base a ciò che mostra, Redde esamina le tue immagini su questo %@ e conserva qui ciò che trova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "写っているもので写真を探せるように、Reddeはこの%@上の写真を確認し、結果をここに保存します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "내용으로 사진을 찾을 수 있도록 Redde가 이 %@에서 사진을 살펴보고 찾은 내용을 여기에 보관합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For å finne et bilde etter hva det viser, ser Redde på bildene dine på denne %@ og lagrer det den finner her."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Om een foto te vinden op wat erop staat, bekijkt Redde je afbeeldingen op deze %@ en bewaart het hier wat het vindt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aby znaleźć zdjęcie po tym, co przedstawia, Redde przegląda zdjęcia na tym urządzeniu %@ i przechowuje wyniki tutaj."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para encontrar uma foto pelo que ela mostra, o Redde analisa suas imagens neste %@ e guarda aqui o que encontra."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чтобы находить фото по содержимому, Redde просматривает ваши снимки на этом %@ и хранит результаты здесь."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "För att hitta en bild utifrån vad den visar tittar Redde på dina bilder på denna %@ och sparar det den hittar här."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir fotoğrafı gösterdiği şeye göre bulmak için Redde bu %@ üzerindeki resimlerinize bakar ve bulduklarını burada saklar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Щоб знаходити фото за вмістом, Redde переглядає ваші зображення на цьому %@ і зберігає знайдене тут."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "为了按内容查找照片，Redde会查看此%@上的图片，并将结果保存在这里。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "為了依內容尋找照片，Redde 會查看這部 %@ 上的圖片，並將結果保存在這裡。"
          }
        }
      }
    },
    "To notice arrivals with Redde closed, iOS needs Location set to Always for Redde." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For at opdage ankomster, når Redde er lukket, skal lokalitet for Redde være indstillet til Altid i iOS."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Damit Ankünfte bei geschlossenem Redde bemerkt werden, muss der Standort für Redde in iOS auf „Immer“ stehen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para detectar llegadas con Redde cerrado, iOS necesita que la ubicación de Redde esté en Siempre."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour remarquer les arrivées quand Redde est fermé, iOS doit avoir la position réglée sur « Toujours » pour Redde."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per accorgersi degli arrivi con Redde chiusa, iOS deve avere la posizione impostata su Sempre per Redde."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reddeを閉じているときに到着に気づくには、iOSでReddeの位置情報を「常に」にする必要があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Redde가 닫혀 있을 때 도착을 알아채려면 iOS에서 Redde의 위치 접근이 항상으로 설정되어 있어야 합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For å merke ankomster når Redde er lukket, må posisjon for Redde være satt til Alltid i iOS."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Om aankomsten te merken als Redde gesloten is, moet Locatie voor Redde in iOS op Altijd staan."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aby zauważać przybycia przy zamkniętym Redde, iOS musi mieć lokalizację dla Redde ustawioną na Zawsze."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para perceber chegadas com o Redde fechado, o iOS precisa que a Localização do Redde esteja em Sempre."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чтобы замечать прибытия, когда Redde закрыт, в iOS для Redde нужна геопозиция «Всегда»."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "För att märka ankomster när Redde är stängd måste plats för Redde vara inställd på Alltid i iOS."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Redde kapalıyken varışları fark etmek için iOS'ta Redde'nin Konum ayarı Her Zaman olmalıdır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Щоб помічати прибуття, коли Redde закрито, в iOS для Redde потрібна локація «Завжди»."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "要在Redde关闭时察觉到达，iOS需要将Redde的位置访问设为“始终”。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "若要在 Redde 關閉時察覺抵達，iOS 需要將 Redde 的位置取用設為「永遠」。"
          }
        }
      }
    },

        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma chave fica guardada no .env de %@ no seu servidor e nunca mais é exibida aqui."
          }
        },
        "ru" : {
          "stringUnit" : {

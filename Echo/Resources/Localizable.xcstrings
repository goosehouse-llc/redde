    "Nothing is at this path, and the Hermes Dashboard didn't say where this profile keeps its files. Saving creates the file here." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der er intet på denne sti, og Hermes Dashboard oplyste ikke, hvor denne profil gemmer sine filer. Når du gemmer, oprettes filen her."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unter diesem Pfad ist nichts, und das Hermes Dashboard hat nicht gesagt, wo dieses Profil seine Dateien ablegt. Sichern erstellt die Datei hier."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No hay nada en esta ruta, y el Hermes Dashboard no indicó dónde guarda este perfil sus archivos. Al guardar se crea el archivo aquí."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il n’y a rien à ce chemin, et le Hermes Dashboard n’a pas indiqué où ce profil garde ses fichiers. L’enregistrement crée le fichier ici."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non c'è niente in questo percorso, e la Hermes Dashboard non ha indicato dove questo profilo tiene i suoi file. Salvando, il file verrà creato qui."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このパスには何もなく、Hermes Dashboardからもこのプロファイルのファイルの保存場所が示されませんでした。保存するとここにファイルが作成されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 경로에 아무것도 없으며, Hermes Dashboard가 이 프로필의 파일 위치를 알려 주지 않았습니다. 저장하면 여기에 파일이 생성됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det finnes ingenting på denne banen, og Hermes Dashboard oppga ikke hvor denne profilen har filene sine. Når du lagrer, opprettes filen her."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er staat niets op dit pad, en het Hermes Dashboard heeft niet gezegd waar dit profiel zijn bestanden bewaart. Bewaren maakt het bestand hier aan."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pod tą ścieżką nic nie ma, a Hermes Dashboard nie podał, gdzie ten profil przechowuje pliki. Zapisanie utworzy plik tutaj."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não há nada neste caminho, e o Hermes Dashboard não informou onde este perfil guarda os arquivos. Salvar cria o arquivo aqui."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "По этому пути ничего нет, и Hermes Dashboard не сообщил, где этот профиль хранит свои файлы. При сохранении файл будет создан здесь."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det finns inget på den här sökvägen, och Hermes Dashboard sa inte var den här profilen sparar sina filer. När du sparar skapas filen här."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu yolda hiçbir şey yok ve Hermes Dashboard bu profilin dosyalarını nerede tuttuğunu söylemedi. Kaydetmek dosyayı burada oluşturur."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "За цим шляхом нічого немає, а Hermes Dashboard не повідомив, де цей профіль зберігає свої файли. Збереження створить файл тут."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此路径下没有任何内容，Hermes Dashboard也未说明此配置文件的文件存放位置。保存时会在此处创建文件。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此路徑上沒有任何內容，且 Hermes Dashboard 未說明此設定檔將檔案存放在哪裡。儲存時會在這裡建立檔案。"
          }
        }
      }
    },

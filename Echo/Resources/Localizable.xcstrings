    "Installed by hand, not from git: nothing says where a newer one would be." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Installeret manuelt, ikke fra git: intet siger, hvor et nyere ville være."

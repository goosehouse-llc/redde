          "stringUnit" : {
            "state" : "translated",
            "value" : "Le serveur n’a pas accepté la clé de cet appareil. Ajoutez la clé ci-dessous à ~/.ssh/authorized_keys pour cet utilisateur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il server non ha accettato la chiave di questo dispositivo. Aggiungi la chiave qui sotto a ~/.ssh/authorized_keys per quell'utente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サーバがこのデバイスのキーを受け付けませんでした。以下のキーをそのユーザの~/.ssh/authorized_keysに追加してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "서버가 이 기기의 키를 받아들이지 않았습니다. 해당 사용자의 ~/.ssh/authorized_keys에 아래 키를 추가하십시오."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tjeneren godtok ikke nøkkelen til denne enheten. Legg til nøkkelen nedenfor i ~/.ssh/authorized_keys for den brukeren."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De server accepteerde de sleutel van dit apparaat niet. Voeg de sleutel hieronder toe aan ~/.ssh/authorized_keys voor die gebruiker."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Serwer nie zaakceptował klucza tego urządzenia. Dodaj poniższy klucz do ~/.ssh/authorized_keys tego użytkownika."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O servidor não aceitou a chave deste dispositivo. Adicione a chave abaixo a ~/.ssh/authorized_keys desse usuário."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сервер не принял ключ этого устройства. Добавьте ключ ниже в ~/.ssh/authorized_keys этого пользователя."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Servern godtog inte den här enhetens nyckel. Lägg till nyckeln nedan i ~/.ssh/authorized_keys för den användaren."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sunucu bu aygıtın anahtarını kabul etmedi. Aşağıdaki anahtarı o kullanıcı için ~/.ssh/authorized_keys dosyasına ekleyin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сервер не прийняв ключ цього пристрою. Додайте ключ нижче до ~/.ssh/authorized_keys цього користувача."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "服务器未接受此设备的密钥。请将下方的密钥添加到该用户的~/.ssh/authorized_keys中。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "伺服器不接受此裝置的金鑰。請將下方金鑰加入該使用者的 ~/.ssh/authorized_keys。"
          }
        }
      }
    },

    "Shown in the header and the message box. Siri phrases and the Home Screen icon keep the app's real name." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vises i titellinjen og beskedfeltet. Siri-fraser og symbolet på hjemmeskærmen beholder appens rigtige navn."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erscheint im Header und im Nachrichtenfeld. Siri-Phrasen und das Symbol auf dem Home-Bildschirm behalten den echten Namen der App."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se muestra en la cabecera y en el campo de mensaje. Las frases de Siri y el icono de la pantalla de inicio conservan el nombre real de la app."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Affiché dans l’en-tête et le champ de message. Les phrases Siri et l’icône de l’écran d’accueil gardent le vrai nom de l’app."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostrato nell'intestazione e nel campo del messaggio. Le frasi di Siri e l'icona nella schermata Home mantengono il vero nome dell'app."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ヘッダとメッセージ欄に表示されます。Siriのフレーズとホーム画面のアイコンでは、アプリ本来の名前が使われます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "헤더와 메시지 입력란에 표시됩니다. Siri 문구와 홈 화면 아이콘에는 앱의 실제 이름이 유지됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vises i toppfeltet og meldingsfeltet. Siri-fraser og symbolet på Hjem-skjermen beholder appens egentlige navn."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Getoond in de kop en het berichtveld. Siri-zinnen en het appsymbool op het beginscherm houden de echte naam van de app."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Widoczne w nagłówku i polu wiadomości. Frazy Siri i ikona na ekranie początkowym zachowują prawdziwą nazwę aplikacji."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exibido no cabeçalho e no campo de mensagem. As frases da Siri e o ícone na Tela de Início mantêm o nome real do app."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Показывается в заголовке и поле сообщения. Фразы Siri и значок на экране «Домой» сохраняют настоящее имя приложения."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Visas i rubriken och meddelandefältet. Siri-fraser och symbolen på hemskärmen behåller appens riktiga namn."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Üst kısımda ve mesaj kutusunda gösterilir. Siri ifadeleri ve Ana Ekran simgesi uygulamanın gerçek adını korur."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Показується в заголовку й полі повідомлення. Фрази Siri та іконка на початковому екрані зберігають справжню назву програми."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "显示在标题栏和输入框中。Siri短语和主屏幕图标仍使用App的真实名称。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "顯示在標題列和訊息框中。Siri 語句和主畫面圖像會保留 App 的真實名稱。"
          }
        }
      }
    },

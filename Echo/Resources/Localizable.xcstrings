          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Redémarrer la passerelle ?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Riavviare il gateway?"
          }
        },
        "ja" : {
          "stringUnit" : {

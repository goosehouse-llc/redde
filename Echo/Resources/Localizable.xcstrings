          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Herstart Hermes daarna en zet alles terug als Hermes niet goed draait"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Potem uruchamia Hermes ponownie i przywraca wszystko, jeśli Hermes nie działa dobrze"

    "Phone tools: your calendar, reminders, contacts, photos and alarms, as you allow" : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Telefonværktøjer: din kalender, påmindelser, kontakter, fotos og alarmer, som du tillader"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Telefon-Tools: dein Kalender, Erinnerungen, Kontakte, Fotos und Wecker, so wie du es erlaubst"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Herramientas del teléfono: tu calendario, recordatorios, contactos, fotos y alarmas, según permitas"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Outils du téléphone : votre calendrier, vos rappels, contacts, photos et alarmes, selon ce que vous autorisez"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Strumenti del telefono: calendario, promemoria, contatti, foto e sveglie, come consenti tu"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "デバイスツール：許可した範囲でカレンダー、リマインダー、連絡先、写真、アラームを使用"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "휴대폰 도구: 허용한 대로 캘린더, 미리 알림, 연락처, 사진 및 알람 사용"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Telefonverktøy: kalenderen, påminnelser, kontakter, bilder og alarmer, slik du tillater"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Telefoontools: je agenda, herinneringen, contacten, foto’s en wekkers, zoals jij toestaat"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Narzędzia telefonu: kalendarz, przypomnienia, kontakty, zdjęcia i alarmy – na tyle, na ile pozwolisz"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ferramentas do telefone: seu calendário, lembretes, contatos, fotos e alarmes, como você permitir"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Инструменты телефона: календарь, напоминания, контакты, фото и будильники — с вашего разрешения"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Telefonverktyg: din kalender, påminnelser, kontakter, bilder och alarm, som du tillåter"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Telefon araçları: izin verdiğiniz ölçüde takviminiz, anımsatıcılarınız, kişileriniz, fotoğraflarınız ve alarmlarınız"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Інструменти телефона: календар, нагадування, контакти, фото й будильники — як дозволите"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "手机工具：经你允许的日历、提醒事项、通讯录、照片和闹钟"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "手機工具：你的行事曆、提醒事項、聯絡人、照片和鬧鐘，依你允許的範圍"
          }
        }
      }

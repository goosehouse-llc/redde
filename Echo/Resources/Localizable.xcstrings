    "The gateway stopped and hasn't come back (it says: %@). Start it on the server: hermes gateway start" : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gatewayen stoppede og er ikke kommet tilbage (den siger: %@). Start den på serveren: hermes gateway start"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Gateway wurde gestoppt und ist nicht zurück (Meldung: %@). Starte es auf dem Server: hermes gateway start"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El gateway se detuvo y no ha vuelto (dice: %@). Inícialo en el servidor: hermes gateway start"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La passerelle s’est arrêtée et n’est pas revenue (elle indique : %@). Démarrez-la sur le serveur : hermes gateway start"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il gateway si è fermato e non è ripartito (dice: %@). Avvialo sul server: hermes gateway start"

    "How the Ask, Talk and New Chat cards look on your car's screen. The car adds their names." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvordan kortene Spørg, Tal og Ny chat ser ud på din bils skærm. Bilen tilføjer deres navne."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wie die Karten „Fragen“, „Sprechen“ und „Neuer Chat“ auf dem Bildschirm deines Autos aussehen. Das Auto ergänzt ihre Namen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cómo se ven las tarjetas Preguntar, Hablar y Nuevo chat en la pantalla del coche. El coche añade sus nombres."

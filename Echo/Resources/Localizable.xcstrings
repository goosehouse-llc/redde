    "Earpiece when raised to your ear" : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ørehøjttaler, når den holdes op til øret"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hörmuschel, wenn am Ohr"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auricular al acercarlo a la oreja"

    "Does its work" : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Udfører sit arbejde"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erledigt seine Arbeit"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hace su trabajo"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fait son travail"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Svolge il suo lavoro"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "作業を担当"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "작업 수행"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gjør jobben for den"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Doet het werk"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wykonuje jego pracę"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faz o trabalho dele"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выполняет его работу"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gör dess arbete"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İşini yapar"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Виконує його роботу"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "代它工作"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "由它執行工作"
          }
        }
      }
    },
    "Does small things that are easy to undo (a reminder, a light, a list) and tells you; asks before sending, paying, booking or deleting." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gør små ting, der er nemme at fortryde (en påmindelse, et lys, en liste), og giver besked; spørger før afsendelse, betaling, booking eller sletning."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erledigt kleine Dinge, die sich leicht rückgängig machen lassen (eine Erinnerung, ein Licht, eine Liste), und sagt dir Bescheid; fragt vor dem Senden, Bezahlen, Buchen oder Löschen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hace cosas pequeñas fáciles de deshacer (un recordatorio, una luz, una lista) y te avisa; pregunta antes de enviar, pagar, reservar o eliminar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fait les petites choses faciles à annuler (un rappel, une lumière, une liste) et vous prévient ; demande avant d’envoyer, de payer, de réserver ou de supprimer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fa piccole cose facili da annullare (un promemoria, una luce, un elenco) e te lo dice; chiede prima di inviare, pagare, prenotare o eliminare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "簡単に取り消せる小さなこと（リマインダー、照明、リストなど）は実行して知らせます。送信、支払い、予約、削除の前には確認します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "되돌리기 쉬운 작은 일(미리 알림, 조명, 목록)은 실행하고 알려줍니다. 보내기, 결제, 예약, 삭제 전에는 묻습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gjør små ting som er lette å angre (en påminnelse, et lys, en liste), og sier fra; spør før sending, betaling, booking eller sletting."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Doet kleine dingen die makkelijk terug te draaien zijn (een herinnering, een lamp, een lijst) en laat het je weten; vraagt eerst bij versturen, betalen, boeken of verwijderen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Robi drobne rzeczy, które łatwo cofnąć (przypomnienie, światło, lista), i daje znać; pyta przed wysłaniem, zapłatą, rezerwacją lub usunięciem."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faz coisas pequenas e fáceis de desfazer (um lembrete, uma luz, uma lista) e avisa; pergunta antes de enviar, pagar, reservar ou apagar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Делает мелочи, которые легко отменить (напоминание, свет, список), и сообщает; спрашивает перед отправкой, оплатой, бронированием или удалением."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gör små saker som är lätta att ångra (en påminnelse, en lampa, en lista) och säger till; frågar innan något skickas, betalas, bokas eller raderas."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geri alması kolay küçük şeyleri (bir anımsatıcı, bir ışık, bir liste) yapar ve haber verir; göndermeden, ödemeden, rezervasyon yapmadan ya da silmeden önce sorar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Робить дрібниці, які легко скасувати (нагадування, світло, список), і повідомляє; питає перед надсиланням, оплатою, бронюванням або видаленням."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "会做容易撤销的小事（一个提醒、一盏灯、一个列表）并告诉你；发送、付款、预订或删除前会先问你。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "會做容易復原的小事（一則提醒、一盞燈、一份列表）並告訴你；傳送、付款、預訂或刪除前會先問你。"
          }
        }
      }
    },

    "Edit Bot → Tools offers Kanban, so a bot can make cards, in its own chat and in group chats." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rediger bot → Værktøjer tilbyder Kanban, så en bot kan lave kort, i sin egen chat og i gruppechats."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bot bearbeiten → Tools bietet Kanban, sodass ein Bot Karten erstellen kann, im eigenen Chat und in Gruppenchats."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Editar bot → Herramientas ofrece Kanban, para que un bot pueda crear tarjetas, en su propio chat y en los chats de grupo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modifier le bot → Outils propose Kanban : un bot peut créer des cartes, dans sa propre discussion et dans les discussions de groupe."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modifica bot → Strumenti offre Kanban, così un bot può creare schede, nella sua chat e nelle chat di gruppo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「ボットを編集 → ツール」でKanbanを使えるようになり、ボットが自分のチャットやグループチャットでカードを作成できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "봇 편집 → 도구에서 Kanban을 제공하므로 봇이 자체 채팅과 그룹 채팅에서 카드를 만들 수 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rediger bot → Verktøy tilbyr Kanban, så en bot kan lage kort, i sin egen chat og i gruppechatter."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wijzig bot → Tools biedt Kanban, zodat een bot kaarten kan maken, in zijn eigen chat en in groepschats."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Edytuj bota → Narzędzia oferuje Kanban, więc bot może tworzyć karty we własnym czacie i w czatach grupowych."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Editar Bot → Ferramentas oferece o Kanban, para que um bot possa criar cartões, na própria conversa e em conversas em grupo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В «Изменить бота» → «Инструменты» есть Kanban, так что бот может создавать карточки — в своем чате и в групповых."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Redigera bot → Verktyg erbjuder Kanban, så att en bot kan skapa kort, i sin egen chatt och i gruppchattar."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Botu Düzenle → Araçlar artık Kanban'ı sunuyor; böylece bir bot hem kendi sohbetinde hem grup sohbetlerinde kart oluşturabilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "У «Редагувати бота → Інструменти» є Kanban, тож бот може створювати картки у своєму чаті й у групових чатах."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "编辑机器人 → 工具中提供Kanban，机器人可在自己的聊天和群聊中创建卡片。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「編輯機器人」→「工具」提供 Kanban，讓機器人在自己的聊天和群組聊天中建立卡片。"
          }
        }
      }
    },

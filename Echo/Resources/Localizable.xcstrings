    "A bot with a picture set in Hermes Desktop shows that picture instead of its face." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En bot med et billede indstillet i Hermes Desktop viser det billede i stedet for sit ansigt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Bot mit einem in Hermes Desktop festgelegten Bild zeigt dieses Bild statt seines Gesichts."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un bot con una imagen definida en Hermes Desktop muestra esa imagen en lugar de su cara."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un bot doté d’une image dans Hermes Desktop affiche cette image à la place de son visage."

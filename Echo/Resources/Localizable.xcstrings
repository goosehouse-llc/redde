    },
    "They are removed from the Redde ledger for every client." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De fjernes fra Redde-loggen for alle klienter."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie werden für jeden Client aus dem Redde-Ledger entfernt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se quitan del registro de Redde para todos los clientes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elles sont retirées du registre de Redde pour tous les clients."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vengono rimosse dal registro di Redde per ogni client."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すべてのクライアントでRedde台帳から削除されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모든 클라이언트에서 Redde 원장에서 제거됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De fjernes fra Redde-registeret for alle klienter."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ze worden voor elke client uit het Redde-register verwijderd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zostaną usunięte z rejestru Redde dla wszystkich klientów."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elas são removidas do registro do Redde para todos os clientes."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Они удаляются из журнала Redde для всех клиентов."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De tas bort från Redde-registret för alla klienter."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tüm istemciler için Redde kayıt defterinden kaldırılırlar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Їх буде вилучено з реєстру Redde для всіх клієнтів."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "它们会从所有客户端的Redde账本中移除。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "它們會從 Redde 的記錄中移除，對所有用戶端皆然。"
          }
        }
      }
    },
    "Things you ask again and again, offered as routines. Weekly." : {
      "comment" : "Ahead of Your Day: Routine Suggestions in a line",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ting, du spørger om igen og igen, foreslået som rutiner. Hver uge."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Was du immer wieder fragst, als Routinen angeboten. Wöchentlich."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo que pides una y otra vez, ofrecido como rutinas. Cada semana."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce que vous demandez encore et encore, proposé comme routines. Chaque semaine."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le cose che chiedi spesso, proposte come routine. Ogni settimana."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "何度も頼むことを、ルーチンとして提案します。毎週。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "자주 요청하는 일을 루틴으로 제안합니다. 매주."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ting du spør om igjen og igjen, foreslått som rutiner. Hver uke."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wat je steeds weer vraagt, aangeboden als routines. Wekelijks."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To, o co prosisz raz po raz, zaproponowane jako rutyny. Co tydzień."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O que você pede de novo e de novo, oferecido como rotinas. Toda semana."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "То, о чём вы просите снова и снова, предлагается как сценарии. Раз в неделю."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sådant du frågar om igen och igen, föreslaget som rutiner. Varje vecka."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tekrar tekrar istediğiniz şeyler, rutin olarak önerilir. Haftalık."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Те, про що ви просите знову й знову, пропонується як сценарії. Щотижня."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你反复要求的事情，作为例行任务推荐给你。每周一次。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你反覆要求的事情，作為例行程序推薦給你。每週一次。"
          }
        }
      }
    },
    "Things your agent keeps an eye on and tells you only when they change, and loose ends it brings back to you when they're due." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ting, din agent holder øje med og kun fortæller dig om, når de ændrer sig, og løse ender, den vender tilbage med, når det er tid."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dinge, die dein Agent im Auge behält und dir nur meldet, wenn sie sich ändern, und offene Punkte, die er dir wieder vorlegt, wenn sie fällig sind."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cosas que tu agente vigila y de las que solo te avisa cuando cambian, y asuntos pendientes que te recuerda cuando toca."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce que votre agent surveille et ne vous signale que si cela change, et les choses en suspens qu’il vous rappelle le moment venu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cose che il tuo agente tiene d'occhio e ti segnala solo quando cambiano, e questioni in sospeso che ti ripropone quando è il momento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "エージェントが見守り、変化があったときだけ知らせるものと、期限が来たら思い出させてくれるやり残しです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "에이전트가 지켜보다가 변경될 때만 알려주는 항목과, 때가 되면 다시 알려주는 미처리 일입니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ting agenten din holder øye med og bare forteller deg om når de endrer seg, og løse tråder den kommer tilbake med når det er tid."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dingen die je agent in de gaten houdt en je alleen meldt als ze veranderen, en losse eindjes die hij terugbrengt als ze aan de beurt zijn."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rzeczy, które Twój agent ma na oku i o których mówi tylko, gdy się zmienią, oraz niezałatwione sprawy, do których wraca, gdy przyjdzie pora."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coisas que seu agente acompanha e só avisa quando mudam, e pendências que ele traz de volta quando chegar a hora."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "То, за чем следит агент, сообщая вам, только когда что-то меняется, и незакрытые дела, о которых он напомнит, когда придет время."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saker din agent håller koll på och bara berättar om när de ändras, och lösa trådar den återkommer med när det är dags."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajanınızın takip ettiği ve yalnızca değiştiklerinde size bildirdiği şeyler ile zamanı geldiğinde size geri getirdiği yarım kalmış işler."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Те, за чим стежить агент, повідомляючи вам, лише коли щось змінюється, і незавершені справи, про які він нагадає, коли настане час."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的智能体帮你留意、只在有变化时才告诉你的事情，以及到时候会再提醒你的未了事项。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的代理幫你留意、只在有變化時才告訴你的事，以及時候到了會再提醒你的未完事項。"
          }
        }
      }
    },

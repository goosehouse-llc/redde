        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Скажіть щось усім або почніть із @ та імені, щоб запитати одного. Бот, якому нічого додати, мовчить."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",

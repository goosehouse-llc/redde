    "In a call, bots' reading voices and the voice speed don't apply: it is %@'s voice." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I et opkald gælder bots' oplæsningsstemmer og stemmehastigheden ikke: det er stemmen fra %@."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In einem Anruf gelten die Vorlesestimmen der Bots und das Sprechtempo nicht: Es ist die Stimme von %@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En una llamada no se aplican las voces de lectura de los bots ni la velocidad de la voz: es la voz de %@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pendant un appel, les voix de lecture des bots et la vitesse de la voix ne s’appliquent pas : c’est la voix de %@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In una chiamata le voci di lettura dei bot e la velocità della voce non valgono: è la voce di %@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通話中は、ボットの読み上げ音声と読み上げ速度は適用されません。%@の音声になります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "통화 중에는 봇의 읽기 음성과 음성 속도가 적용되지 않으며 %@의 음성이 사용됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I en samtale gjelder ikke botenes opplesningsstemmer og stemmehastigheten: det er stemmen til %@."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In een gesprek gelden de voorleesstemmen van bots en de spreeksnelheid niet: het is de stem van %@."
          }
        },
        "pl" : {
          "stringUnit" : {

          "stringUnit" : {
            "state" : "translated",
            "value" : "Um bot oculto continua no seu servidor; encontre-o de novo em Bots Ocultos, no fim dos seus bots."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",

          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Co zastępuje słowo. Spacje się liczą, także spacja na końcu. Zostaw puste, aby tylko przełączyć model."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O que substitui a palavra. Os espaços contam, inclusive um espaço no fim. Deixe vazio para só mudar o modelo."
          }
        },
        "ru" : {

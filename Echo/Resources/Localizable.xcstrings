        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ainda não conectado: a primeira conexão mostra a impressão digital da chave e pergunta."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Еще не подключались: при первом подключении появятся отпечаток его ключа и вопрос."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inte ansluten förut: den första anslutningen visar nyckelns fingeravtryck och frågar."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Henüz karşılaşılmadı: ilk bağlantı, anahtarının parmak izini gösterir ve sorar."

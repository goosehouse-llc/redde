    "Not answered in about 5 minutes, it isn't run." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Besvares den ikke inden for ca. 5 minutter, køres den ikke."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ohne Antwort innerhalb von etwa 5 Minuten wird es nicht ausgeführt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si no se responde en unos 5 minutos, no se ejecuta."
          }
        },
        "fr" : {
          "stringUnit" : {

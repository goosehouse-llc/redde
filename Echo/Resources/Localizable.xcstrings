    "Schedule Redde to run a prompt every hour, every weekday at 9am, or once at a time you pick." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Planlæg, at Redde kører en prompt hver time, hver hverdag kl. 9 eller én gang på et tidspunkt, du vælger."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lass Redde einen Prompt stündlich, an jedem Wochentag um 9 Uhr oder einmal zu einer gewählten Zeit ausführen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Programa Redde para ejecutar una instrucción cada hora, cada día laborable a las 9:00, o una vez a la hora que elijas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Planifiez Redde pour exécuter un prompt toutes les heures, chaque jour de semaine à 9 h, ou une fois à l’heure de votre choix."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pianifica Redde per eseguire un prompt ogni ora, ogni giorno feriale alle 9, o una volta all'ora che scegli."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プロンプトを1時間ごと、平日の毎朝9時、または指定した時刻に1回、Reddeで実行するようスケジュールします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Redde가 매시간, 평일 오전 9시마다 또는 선택한 시간에 한 번 프롬프트를 실행하도록 예약합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Planlegg at Redde kjører en prompt hver time, hver ukedag kl. 9 eller én gang på et tidspunkt du velger."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laat Redde een prompt uitvoeren: elk uur, elke werkdag om 9:00, of eenmalig op een tijd die jij kiest."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zaplanuj, by Redde uruchamiało prompt co godzinę, w każdy dzień roboczy o 9:00 lub raz o wybranej godzinie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agende o Redde para executar um prompt a cada hora, todo dia útil às 9h, ou uma vez no horário que você escolher."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Запускайте запрос Redde по расписанию: каждый час, по будням в 9:00 или один раз в выбранное время."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schemalägg Redde att köra en prompt varje timme, varje vardag kl. 9 eller en gång vid en tid du väljer."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Redde'yi her saat, hafta içi her gün saat 9'da ya da seçtiğiniz bir saatte bir kez bir istem çalıştıracak şekilde zamanlayın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Плануйте, щоб Redde виконував промпт щогодини, щобудня о 9:00 або один раз у вибраний час."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "安排Redde每小时、每个工作日上午9点，或在你选定的时间运行一次提示词。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "排程讓 Redde 每小時、每個平日早上 9 點，或在你選擇的時間執行一次提示詞。"
          }
        }
      }
    },

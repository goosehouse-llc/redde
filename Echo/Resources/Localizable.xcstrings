        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diga algo para todos, ou comece com @ e um nome para perguntar a um. Um bot que não tem nada a acrescentar fica em silêncio."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Обратитесь ко всем сразу или начните с @ и имени, чтобы спросить одного. Бот, которому нечего добавить, промолчит."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Säg något till alla, eller börja med @ och ett namn för att fråga en. En bot som inte har något att tillägga håller tyst."

    "Automatic gives %@ a voice of its own, not %@'s and not another bot's while there are voices to go round. It reads %@'s replies in voice mode, in group chats and in the car." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automatisk giver %1$@ en egen stemme, ikke den fra %2$@ og ikke en anden bots, så længe der er stemmer nok. Den læser svar fra %3$@ op i stemmetilstand, i gruppechats og i bilen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Automatisch“ gibt %1$@ eine eigene Stimme, nicht die von %2$@ und nicht die eines anderen Bots, solange genug Stimmen da sind. Sie liest die Antworten von %3$@ im Sprachmodus, in Gruppenchats und im Auto vor."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Automatic gives %1$@ a voice of its own, not %2$@'s and not another bot's while there are voices to go round. It reads %3$@'s replies in voice mode, in group chats and in the car."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automática da a %1$@ una voz propia, distinta de la de %2$@ y de la de otros bots mientras haya voces para todos. Lee las respuestas de %3$@ en el modo de voz, en los chats de grupo y en el coche."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automatique donne à %1$@ une voix à lui, ni celle de %2$@ ni celle d’un autre bot tant qu’il y a assez de voix. Elle lit les réponses de %3$@ en mode vocal, dans les discussions de groupe et en voiture."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automatica dà a %1$@ una voce tutta sua, non quella di %2$@ né quella di un altro bot finché ci sono voci a sufficienza. Legge le risposte di %3$@ in modalità vocale, nelle chat di gruppo e in auto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「自動」では、音声が足りている限り、%2$@やほかのボットとは異なる独自の音声を%1$@に割り当てます。音声モード、グループチャット、車内で%3$@の返答を読み上げます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "자동은 남는 음성이 있는 한 %2$@의 음성이나 다른 봇의 음성이 아닌 %1$@ 고유의 음성을 지정합니다. 이 음성은 음성 모드, 그룹 채팅 및 차량에서 %3$@의 응답을 읽습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automatisk gir %1$@ en egen stemme, ikke stemmen til %2$@ og ikke en annen bots, så lenge det er nok stemmer. Den leser opp svarene til %3$@ i stemmemodus, i gruppechatter og i bilen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automatisch geeft %1$@ een eigen stem, niet die van %2$@ en niet die van een andere bot zolang er genoeg stemmen zijn. Die leest de antwoorden van %3$@ voor in spraakmodus, in groepschats en in de auto."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automatyczny daje botowi %1$@ własny głos – inny niż %2$@ i inny niż pozostałych botów, dopóki głosów wystarcza. Czyta odpowiedzi %3$@ w trybie głosowym, w czatach grupowych i w samochodzie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automática dá a %1$@ uma voz própria, diferente da de %2$@ e da de outro bot enquanto houver vozes suficientes. Ela lê as respostas de %3$@ no modo de voz, nas conversas em grupo e no carro."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Автоматически» дает %1$@ собственный голос — не голос %2$@ и не голос другого бота, пока голосов хватает на всех. Им читаются ответы %3$@ в голосовом режиме, в групповых чатах и в машине."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automatisk ger %1$@ en egen röst, inte %2$@s och inte en annan bots, så länge det finns röster så att det räcker. Den läser upp %3$@s svar i röstläge, i gruppchattar och i bilen."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otomatik, sesler yettiği sürece %1$@ botuna %2$@ sesinden ve başka botların seslerinden farklı, kendine ait bir ses verir. %3$@ yanıtlarını sesli modda, grup sohbetlerinde ve arabada bu ses okur."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Автоматично» дає %1$@ власний голос — не голос %2$@ і не голос іншого бота, доки голосів вистачає. Він читає відповіді %3$@ у голосовому режимі, групових чатах і в авто."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“自动”会在声音够分配时，给%1$@一个专属声音，既不同于%2$@，也不同于其他机器人。它会在语音模式、群聊和车内朗读%3$@的回复。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「自動」會在聲音足夠分配時，給 %1$@ 一個專屬的聲音，不與 %2$@ 或其他機器人重複。它會在語音模式、群組聊天和車上朗讀 %3$@ 的回覆。"
          }
        }
      }
    },

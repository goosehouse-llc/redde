    "Its chat, memories and settings are deleted from your server. This can't be undone." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dens chat, minder og indstillinger slettes fra din server. Dette kan ikke fortrydes."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sein Chat, sein Gedächtnis und seine Einstellungen werden von deinem Server gelöscht. Das kann nicht widerrufen werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Su chat, sus recuerdos y sus ajustes se eliminan de tu servidor. No se puede deshacer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sa discussion, ses souvenirs et ses réglages sont supprimés de votre serveur. Cette action est irréversible."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La sua chat, i ricordi e le impostazioni vengono eliminati dal tuo server. Questa operazione non può essere annullata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "チャット、メモリ、設定がサーバから削除されます。この操作は取り消せません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "채팅, 메모리 및 설정이 서버에서 삭제됩니다. 이 작업은 실행 취소할 수 없습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chatten, minnene og innstillingene slettes fra tjeneren din. Dette kan ikke angres."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De chat, het geheugen en de instellingen ervan worden van je server verwijderd. Dit kan niet ongedaan worden gemaakt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jego czat, wspomnienia i ustawienia zostaną usunięte z Twojego serwera. Nie można tego cofnąć."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A conversa, as memórias e os ajustes dele são apagados do seu servidor. Não é possível desfazer."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Его чат, память и настройки удаляются с вашего сервера. Это действие нельзя отменить."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dess chatt, minnen och inställningar raderas från din server. Det går inte att ångra."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sohbeti, bellek kayıtları ve ayarları sunucunuzdan silinir. Bu geri alınamaz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Його чат, спогади й параметри буде видалено з вашого сервера. Цю дію не можна скасувати."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "它的聊天、记忆和设置将从你的服务器中删除。此操作无法撤销。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "它的聊天、記憶和設定會從你的伺服器上刪除。此動作無法還原。"
          }
        }
      }
    },

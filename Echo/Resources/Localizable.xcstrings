    "Only the calendars switched on here. With none on, all of them." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kun de kalendere, der er slået til her. Er ingen slået til, dem alle."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur die hier eingeschalteten Kalender. Ist keiner eingeschaltet, alle."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo los calendarios activados aquí. Si no hay ninguno, todos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uniquement les calendriers activés ici. Si aucun ne l'est, tous."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo i calendari attivati qui. Se nessuno è attivo, tutti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ここでオンにしたカレンダーだけ。どれもオンでなければ、すべてのカレンダー。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "여기에서 켠 캘린더만 사용합니다. 아무것도 켜지 않으면 모두 사용합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bare kalenderne som er slått på her. Er ingen slått på, alle."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alleen de agenda's die hier aan staan. Staat er geen aan, dan allemaal."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tylko kalendarze włączone tutaj. Jeśli żaden nie jest włączony – wszystkie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Só os calendários ativados aqui. Sem nenhum ativado, todos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Только календари, включённые здесь. Если не включён ни один — все."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bara kalendrarna som är påslagna här. Är ingen påslagen, alla."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yalnızca burada açık olan takvimler. Hiçbiri açık değilse tümü."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Лише календарі, увімкнені тут. Якщо не ввімкнено жодного — усі."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅限在此打开的日历。若一个都没打开，则为全部日历。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "僅限在此開啟的行事曆。若一個都沒開啟，則為全部行事曆。"
          }
        }
      }
    },

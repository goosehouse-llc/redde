    "What your car's screen shows while Redde listens, thinks and speaks, in that order." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det, din bils skærm viser, mens Redde lytter, tænker og taler, i den rækkefølge."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Was der Bildschirm deines Autos zeigt, während Redde zuhört, nachdenkt und spricht, in dieser Reihenfolge."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo que muestra la pantalla del coche mientras Redde escucha, piensa y habla, en ese orden."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce qu’affiche l’écran de votre voiture pendant que Redde écoute, réfléchit et parle, dans cet ordre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cosa mostra lo schermo dell'auto mentre Redde ascolta, pensa e parla, in quest'ordine."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reddeが聞き取り、考え、話す間（この順）に車の画面に表示される内容。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Redde가 듣고, 생각하고, 말하는 동안 차량 화면에 순서대로 표시되는 내용."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hva bilskjermen viser mens Redde lytter, tenker og snakker, i den rekkefølgen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wat het scherm van je auto toont terwijl Redde luistert, nadenkt en spreekt, in die volgorde."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Co pokazuje ekran samochodu, gdy Redde słucha, myśli i mówi, w tej kolejności."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O que a tela do carro mostra enquanto o Redde ouve, pensa e fala, nessa ordem."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Что показывает экран машины, пока Redde слушает, думает и говорит — именно в таком порядке."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det som bilens skärm visar medan Redde lyssnar, tänker och talar, i den ordningen."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Redde dinlerken, düşünürken ve konuşurken (bu sırayla) arabanızın ekranında görünenler."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Що показує екран авто, поки Redde слухає, думає й говорить, у такому порядку."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Redde聆听、思考和说话时（依此顺序）你的车载屏幕上显示的内容。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Redde 聆聽、思考和說話時（依此順序），你車上螢幕所顯示的畫面。"
          }
        }
      }
    },

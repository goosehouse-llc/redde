    "The live thinking keeps scrolling, each reply shows how long it took, and replies from your own model can take as long as they need." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den igangværende tænkning bliver ved med at rulle, hvert svar viser, hvor lang tid det tog, og svar fra din egen model kan tage så lang tid, som de har brug for."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Live-Denkprozess scrollt mit, jede Antwort zeigt, wie lange sie gedauert hat, und Antworten deines eigenen Modells dürfen so lange dauern, wie sie brauchen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El razonamiento en vivo sigue desplazándose, cada respuesta muestra cuánto tardó y las respuestas de tu propio modelo pueden tardar lo que necesiten."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La réflexion en direct continue de défiler, chaque réponse indique le temps qu’elle a pris, et les réponses de votre propre modèle peuvent prendre tout le temps nécessaire."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il ragionamento in tempo reale continua a scorrere, ogni risposta mostra quanto ci ha messo, e le risposte del tuo modello possono richiedere tutto il tempo necessario."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ライブの思考は自動でスクロールし続け、各返答にかかった時間が表示され、自前のモデルからの返答は必要なだけ時間をかけられるようになりました。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "실시간 생각 과정이 계속 스크롤되고, 각 응답에 걸린 시간이 표시되며, 직접 운영하는 모델의 응답은 필요한 만큼 시간을 쓸 수 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tenkingen som vises underveis, fortsetter å rulle, hvert svar viser hvor lang tid det tok, og svar fra din egen modell kan ta så lang tid de trenger."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het live denkproces blijft scrollen, elk antwoord toont hoe lang het duurde, en antwoorden van je eigen model mogen zo lang duren als nodig."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Myślenie na żywo przewija się dalej, każda odpowiedź pokazuje, ile trwała, a odpowiedzi z Twojego własnego modelu mogą trwać tyle, ile potrzebują."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O raciocínio ao vivo continua rolando, cada resposta mostra quanto tempo levou, e as respostas do seu próprio modelo podem levar o tempo que precisarem."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Размышления в реальном времени продолжают прокручиваться, у каждого ответа видно, сколько он занял, а ответы вашей собственной модели могут длиться сколько нужно."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det pågående tänkandet fortsätter att rulla, varje svar visar hur lång tid det tog, och svar från din egen modell får ta så lång tid som de behöver."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Canlı düşünme kaymaya devam ediyor, her yanıt ne kadar sürdüğünü gösteriyor ve kendi modelinizden gelen yanıtlar gerektiği kadar sürebiliyor."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Роздуми наживо прокручуються далі, кожна відповідь показує, скільки тривала, а відповіді вашої власної моделі можуть тривати скільки завгодно."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "实时思考内容会持续滚动，每条回复都会显示耗时，来自你自己模型的回复也可以想花多久就花多久。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "即時思考內容會持續捲動，每則回覆都會顯示花了多少時間，你自己模型的回覆也可以想花多久就花多久。"
          }
        }
      }
    },

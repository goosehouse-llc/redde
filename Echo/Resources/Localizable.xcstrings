    "Conversations, attachments, credentials and settings. This can't be undone." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Samtaler, vedhæftninger, loginoplysninger og indstillinger. Dette kan ikke fortrydes."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Konversationen, Anhänge, Zugangsdaten und Einstellungen. Das kann nicht widerrufen werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conversaciones, adjuntos, credenciales y ajustes. No se puede deshacer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conversations, pièces jointes, identifiants et réglages. Cette action est irréversible."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conversazioni, allegati, credenziali e impostazioni. Questa operazione non può essere annullata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "会話、添付ファイル、認証情報、設定。この操作は取り消せません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "대화, 첨부 파일, 자격 증명 및 설정. 이 작업은 실행 취소할 수 없습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Samtaler, vedlegg, påloggingsdetaljer og innstillinger. Dette kan ikke angres."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gesprekken, bijlagen, inloggegevens en instellingen. Dit kan niet ongedaan worden gemaakt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rozmowy, załączniki, dane uwierzytelniające i ustawienia. Nie można tego cofnąć."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conversas, anexos, credenciais e ajustes. Não é possível desfazer."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Разговоры, вложения, учетные данные и настройки. Это действие нельзя отменить."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Konversationer, bilagor, inloggningsuppgifter och inställningar. Det går inte att ångra."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Konuşmalar, ekler, kimlik bilgileri ve ayarlar. Bu geri alınamaz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Розмови, вкладення, облікові дані й параметри. Цю дію не можна скасувати."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "对话、附件、凭证和设置。此操作无法撤销。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "對話、附件、憑證和設定。此動作無法還原。"
          }
        }
      }
    },
    "conversion.title" : {
      "comment" : "ID key, English \"%@ to %@\": a conversion card's title, from and to, e.g. US Dollar to Euro / Miles to kilometers (the names arrive already localized)",

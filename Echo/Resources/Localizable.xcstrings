    "You will be notified here when that Hermes finishes a reply, waits for you, or couldn't reply." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du får besked her, når den Hermes har et svar klar, venter på dig eller ikke kunne svare."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du wirst hier benachrichtigt, wenn dieser Hermes eine Antwort fertig hat, auf dich wartet oder nicht antworten konnte."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recibirás un aviso aquí cuando ese Hermes termine una respuesta, te espere o no pueda responder."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous serez averti ici quand cet Hermes termine une réponse, vous attend ou n’a pas pu répondre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Riceverai qui una notifica quando quell'Hermes termina una risposta, ti aspetta o non è riuscito a rispondere."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "そのHermesが返答を完了したとき、対応を待っているとき、または返答できなかったときに、ここで通知されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "해당 Hermes가 응답을 완료하거나, 사용자를 기다리거나, 응답하지 못하면 여기에서 알림을 받습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du blir varslet her når den Hermes er ferdig med et svar, venter på deg eller ikke kunne svare."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je krijgt hier een melding als die Hermes een antwoord afrondt, op je wacht, of niet kon antwoorden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otrzymasz tu powiadomienie, gdy ten Hermes skończy odpowiedź, będzie na Ciebie czekać lub nie zdoła odpowiedzieć."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você vai ser notificado aqui quando esse Hermes terminar uma resposta, esperar por você ou não conseguir responder."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Здесь вы получите уведомление, когда этот Hermes закончит ответ, будет ждать вас или не сможет ответить."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du får en notis här när den Hermes blir klar med ett svar, väntar på dig eller inte kunde svara."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Hermes bir yanıtı bitirdiğinde, sizi beklediğinde ya da yanıt veremediğinde burada bilgilendirileceksiniz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тут ви отримаєте сповіщення, коли той Hermes завершить відповідь, чекатиме на вас або не зможе відповісти."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当该Hermes完成回复、等待你处理或无法回复时，你会在这里收到通知。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "當該 Hermes 完成回覆、等待你回應，或無法回覆時，你會在這裡收到通知。"
          }
        }
      }
    },

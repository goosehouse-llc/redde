    "Locking your iPhone hangs up a live call, unless it is hands-free or on your car's screen." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når du låser din iPhone, lægges et liveopkald på, medmindre det er håndfrit eller på bilens skærm."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Sperren deines iPhone beendet einen Live-Anruf, außer er läuft freihändig oder auf dem Bildschirm deines Autos."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al bloquear el iPhone se cuelga una llamada en vivo, salvo que sea con manos libres o en la pantalla del coche."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verrouiller votre iPhone met fin à un appel en direct, sauf en mains libres ou sur l’écran de votre voiture."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bloccare iPhone chiude una chiamata in tempo reale, a meno che non sia a mani libere o sullo schermo dell'auto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ハンズフリーまたは車の画面での通話でない限り、iPhoneをロックするとライブ通話は終了します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "핸즈프리이거나 차량 화면에 있는 경우를 제외하고 iPhone을 잠그면 라이브 통화가 끊어집니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når du låser iPhonen, legges en live-samtale på, med mindre den er håndfri eller på bilskjermen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als je je iPhone vergrendelt, wordt een live gesprek opgehangen, tenzij het handsfree is of op het scherm van je auto."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zablokowanie iPhone'a rozłącza połączenie na żywo, chyba że trwa w trybie bez użycia rąk lub na ekranie samochodu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bloquear o iPhone desliga uma chamada ao vivo, a menos que esteja em mãos livres ou na tela do carro."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Блокировка iPhone завершает звонок с живым голосом, если только он не идет в режиме «Без рук» или на экране машины."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "När du låser din iPhone läggs ett livesamtal på, om det inte är handsfree eller på bilens skärm."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone'unuzu kilitlemek canlı aramayı kapatır; arama eller serbestse ya da arabanızın ekranındaysa kapatmaz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Замикання iPhone завершує виклик наживо, якщо він не з вільними руками й не на екрані авто."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "锁定iPhone会挂断实时通话，除非处于免提状态或在车载屏幕上。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "鎖定 iPhone 會掛斷即時通話，除非是免持模式或在你的車上螢幕上進行。"
          }
        }
      }
    },

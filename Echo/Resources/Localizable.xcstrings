        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes bunu bir sonraki yeniden başlatmada uygular."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes застосує це під час наступного перезапуску."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes会在下次重新启动时采用。"

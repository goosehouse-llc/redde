    "The gateway answered, but not in a way Redde understood." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gatewayen svarede, men ikke på en måde, Redde forstod."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Gateway hat geantwortet, aber nicht so, dass Redde es versteht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El gateway respondió, pero de una forma que Redde no entendió."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La passerelle a répondu, mais d’une manière que Redde n’a pas comprise."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il gateway ha risposto, ma in un modo che Redde non ha capito."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ゲートウェイから応答がありましたが、Reddeが理解できる形式ではありませんでした。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "게이트웨이가 응답했지만 Redde가 이해할 수 있는 방식이 아니었습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gatewayen svarte, men ikke på en måte Redde forsto."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De gateway antwoordde, maar niet op een manier die Redde begreep."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brama odpowiedziała, ale Redde nie zrozumiało odpowiedzi."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O gateway respondeu, mas de um jeito que o Redde não entendeu."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Шлюз ответил, но ответ непонятен Redde."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gatewayn svarade, men inte på ett sätt som Redde förstod."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ağ geçidi yanıt verdi ama Redde'nin anlayabileceği biçimde değil."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Шлюз відповів, але Redde не зрозумів відповіді."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "网关有响应，但Redde无法理解其内容。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "閘道有回應，但 Redde 無法理解其內容。"
          }
        }
      }
    },
    "The gateway doesn't serve this profile over the Hermes API. Turn on gateway.multiplex_profiles in its config, or switch back to Default under Settings → Profile." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gatewayen betjener ikke denne profil via Hermes API. Slå gateway.multiplex_profiles til i dens konfiguration, eller skift tilbage til Standard under Indstillinger → Profil."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Gateway stellt dieses Profil nicht über die Hermes API bereit. Aktiviere gateway.multiplex_profiles in seiner Konfiguration oder wechsle unter Einstellungen → Profil zurück zu „Standard“."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El gateway no sirve este perfil por la Hermes API. Activa gateway.multiplex_profiles en su configuración, o vuelve a Predeterminado en Ajustes → Perfil."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La passerelle ne sert pas ce profil via Hermes API. Activez gateway.multiplex_profiles dans sa configuration, ou revenez à Par défaut dans Réglages → Profil."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il gateway non serve questo profilo tramite la Hermes API. Attiva gateway.multiplex_profiles nella sua configurazione, o torna a Predefinito in Impostazioni → Profilo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ゲートウェイはHermes API経由でこのプロファイルを提供していません。設定ファイルでgateway.multiplex_profilesをオンにするか、設定 → プロファイルで「デフォルト」に戻してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "게이트웨이가 Hermes API를 통해 이 프로필을 제공하지 않습니다. 구성에서 gateway.multiplex_profiles를 켜거나, 설정 → 프로필에서 기본으로 다시 전환하십시오."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gatewayen betjener ikke denne profilen via Hermes API. Slå på gateway.multiplex_profiles i konfigurasjonen, eller bytt tilbake til Standard under Innstillinger → Profil."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De gateway bedient dit profiel niet via de Hermes API. Zet gateway.multiplex_profiles aan in de config, of schakel terug naar Standaard onder Instellingen → Profiel."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brama nie obsługuje tego profilu przez Hermes API. Włącz gateway.multiplex_profiles w jej konfiguracji lub wróć do profilu Domyślny w Ustawienia → Profil."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O gateway não atende este perfil pela Hermes API. Ative gateway.multiplex_profiles na configuração dele, ou volte para Padrão em Ajustes → Perfil."
          }
        },
        "ru" : {
          "stringUnit" : {

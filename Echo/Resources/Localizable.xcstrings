    "The gateway's API server and its API_SERVER_KEY. Sessions from every platform appear in Redde." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gatewayens API-server og dens API_SERVER_KEY. Sessioner fra alle platforme vises i Redde."
          }

        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "대화 위에 Hermes 프로젝트를 표시합니다. 끄더라도 프로젝트의 대화는 목록에 그대로 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes-prosjektene dine, over samtalene. Når dette er av, er samtalene deres fortsatt i listen."

      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes Dashboard siger, at det ikke har noget login, men dets side på %@ har intet sessionstoken. Noget foran det svarer måske i stedet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Hermes Dashboard gibt an, keine Anmeldung zu haben, aber seine Seite unter %@ enthält kein Sitzungstoken. Vielleicht antwortet stattdessen etwas, das davor sitzt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El Hermes Dashboard dice que no tiene inicio de sesión, pero su página en %@ no tiene token de sesión. Puede que algo delante de él esté respondiendo en su lugar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le Hermes Dashboard indique qu’il n’a pas d’identifiant, mais sa page à %@ n’a pas de jeton de session. Quelque chose placé devant lui répond peut-être à sa place."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La Hermes Dashboard dice di non avere un accesso, ma la sua pagina su %@ non ha un token di sessione. Forse risponde al suo posto qualcosa che le sta davanti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes Dashboardはログインがないと示していますが、%@のページにセッショントークンがありません。手前にある別のものが代わりに応答している可能性があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes Dashboard는 로그인이 없다고 하지만 %@의 페이지에 세션 토큰이 없습니다. 앞단의 다른 무언가가 대신 응답하고 있을 수 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes Dashboard sier at det ikke har pålogging, men siden på %@ har ikke noe sesjonstoken. Noe foran det svarer kanskje i stedet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het Hermes Dashboard zegt dat het geen login heeft, maar de pagina op %@ heeft geen sessietoken. Misschien antwoordt iets ervoor in zijn plaats."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes Dashboard podaje, że nie ma logowania, ale jego strona pod adresem %@ nie zawiera tokenu sesji. Być może zamiast niego odpowiada coś, co stoi przed nim."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Hermes Dashboard diz que não tem login, mas a página dele em %@ não tem token de sessão. Talvez algo na frente dele esteja respondendo no lugar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes Dashboard сообщает, что вход не нужен, но на его странице по адресу %@ нет токена сеанса. Возможно, вместо него отвечает что-то, стоящее перед ним."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes Dashboard säger att den saknar inloggning, men dess sida på %@ har ingen sessionstoken. Något framför den kanske svarar i stället."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes Dashboard girişi olmadığını söylüyor ama %@ adresindeki sayfasında oturum token'ı yok. Önündeki başka bir şey onun yerine yanıt veriyor olabilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes Dashboard повідомляє, що входу немає, але на його сторінці за адресою %@ немає токена сеансу. Можливо, замість нього відповідає щось, що стоїть перед ним."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes Dashboard表示它没有登录，但它在%@的页面上没有会话令牌。可能是它前面的其他东西在代为响应。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes Dashboard 表示它沒有登入，但它在 %@ 的頁面上沒有工作階段權杖。可能是它前方的其他東西在代為回應。"
          }
        }
      }
    },

        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Startet Hermes danach neu und stellt alles wieder her, wenn Hermes nicht rund läuft"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reinicia Hermes después y lo deshace todo si Hermes no va bien"
          }

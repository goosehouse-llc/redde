          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As conversas deixadas de lado com Começar do Zero aparecem aqui, com as mensagens."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чаты, отложенные с помощью «Начать заново», появляются здесь вместе с сообщениями."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chattar du har lagt undan med Börja om visas här, med sina meddelanden."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sıfırdan Başla ile kenara koyduğunuz sohbetler, mesajlarıyla birlikte burada görünür."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чати, відкладені за допомогою «Почати заново», з’являються тут разом із повідомленнями."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用“重新开始”搁置的聊天会连同消息显示在这里。"
          }

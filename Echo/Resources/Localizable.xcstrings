    "With or without “okay”, “Redde”, “please” or “thanks” around them." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Med eller uden “okay”, “Redde”, “please” eller “thanks” omkring dem."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit oder ohne „okay“, „Redde“, „please“ oder „thanks“ drumherum."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con o sin “okay”, “Redde”, “please” o “thanks” alrededor."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avec ou sans « okay », « Redde », « please » ou « thanks » autour."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con o senza “okay”, “Redde”, “please” o “thanks” attorno."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "前後に「okay」「Redde」「please」「thanks」があってもなくても認識します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "앞뒤에 “okay”, “Redde”, “please” 또는 “thanks”가 있어도 되고 없어도 됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Med eller uten «okay», «Redde», «please» eller «thanks» rundt dem."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Met of zonder ‘okay’, ‘Redde’, ‘please’ of ‘thanks’ eromheen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Z „okay”, „Redde”, „please” lub „thanks” wokół nich lub bez."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Com ou sem “okay”, “Redde”, “please” ou “thanks” em volta."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "С «okay», «Redde», «please» или «thanks» вокруг них или без."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Med eller utan ”okay”, ”Redde”, ”please” eller ”thanks” runt dem."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Çevresinde “okay”, “Redde”, “please” ya da “thanks” olsun ya da olmasın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "З «okay», «Redde», «please» чи «thanks» поруч або без них."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "前后带不带“okay”、“Redde”、“please”或“thanks”都可以。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "前後加不加「okay」、「Redde」、「please」或「thanks」都可以。"
          }
        }
      }
    },
    "With Redde open, say “Hey” and an agent's name to talk to it, or “Hey Home, turn the lights off” to ask at once. Turn it on, and change the phrases, in Settings → Voice → Wake Phrase. It listens on the device." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når Redde er åben, kan du sige “Hey” og en agents navn for at tale med den eller “Hey Home, sluk lyset” for at spørge med det samme. Slå det til, og skift vækkeordene, i Indstillinger → Stemme → Vækkeord. Den lytter på enheden."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sag bei geöffnetem Redde „Hey“ und den Namen eines Agenten, um mit ihm zu sprechen, oder „Hey Home, schalte das Licht aus“, um sofort zu fragen. Aktiviere es und ändere die Phrasen in Einstellungen → Stimme → Aktivierungsphrase. Es hört auf dem Gerät zu."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con Redde abierto, di “Hey” y el nombre de un agente para hablar con él, o “Hey Home, apaga las luces” para preguntar al momento. Actívalo, y cambia las frases, en Ajustes → Voz → Frase de activación. Escucha en el dispositivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avec Redde ouvert, dites « Hey » et le nom d’un agent pour lui parler, ou « Hey Maison, éteins les lumières » pour demander directement. Activez la fonction, et modifiez les phrases, dans Réglages → Voix → Phrase d’activation. L’écoute se fait sur l’appareil."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con Redde aperta, di' “Hey” e il nome di un agente per parlarci, o “Hey Casa, spegni le luci” per chiedere subito. Attivala, e cambia le frasi, in Impostazioni → Voce → Frase di attivazione. L'ascolto avviene sul dispositivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reddeを開いた状態で「Hey」とエージェントの名前を言うと話しかけられ、「Hey Home、電気を消して」と言えばすぐに頼めます。オンにしたりフレーズを変更したりするには、設定 → 音声 → 呼びかけフレーズを開きます。聞き取りはデバイス上で行われます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Redde가 열려 있을 때 “Hey”와 에이전트 이름을 말하면 대화할 수 있고, “Hey Home, 불 꺼 줘”라고 하면 바로 요청합니다. 설정 → 음성 → 호출어에서 켜고 문구를 변경하십시오. 기기에서 듣습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Med Redde åpen sier du «Hey» og navnet til en agent for å snakke med den, eller «Hey Home, slå av lyset» for å spørre med en gang. Slå det på, og endre frasene, i Innstillinger → Stemme → Vekkefrase. Den lytter på enheten."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeg met Redde open ‘Hey’ en de naam van een agent om ermee te praten, of ‘Hey Home, doe de lichten uit’ om meteen iets te vragen. Zet het aan, en wijzig de zinnen, in Instellingen → Stem → Activeringszin. Het luistert op het apparaat."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gdy Redde jest otwarte, powiedz „Hey” i imię agenta, aby z nim porozmawiać, lub „Hey Home, zgaś światła”, aby od razu poprosić. Włącz to i zmień frazy w Ustawienia → Głos → Fraza aktywująca. Nasłuchiwanie odbywa się na urządzeniu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Com o Redde aberto, diga “Hey” e o nome de um agente para falar com ele, ou “Hey Home, apague as luzes” para pedir na hora. Ative, e mude as frases, em Ajustes → Voz → Frase de Ativação. A escuta é no dispositivo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Когда Redde открыт, скажите «Hey» и имя агента, чтобы поговорить с ним, или «Hey Home, выключи свет», чтобы сразу попросить. Включите функцию и измените фразы в «Настройки» → «Голос» → «Фраза активации». Прослушивание идет на устройстве."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Med Redde öppen, säg ”Hey” och en agents namn för att prata med den, eller ”Hey Home, släck lamporna” för att fråga direkt. Slå på det, och ändra fraserna, i Inställningar → Röst → Väckningsfras. Den lyssnar på enheten."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Redde açıkken bir ajanla konuşmak için “Hey” ve ajanın adını, hemen sormak içinse “Hey Home, ışıkları kapat” deyin. Ayarlar → Ses → Uyandırma İfadesi bölümünde açın ve ifadeleri değiştirin. Aygıtta dinler."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Коли Redde відкритий, скажіть «Hey» та ім’я агента, щоб поговорити з ним, або «Hey Home, вимкни світло», щоб одразу попросити. Увімкніть це й змініть фрази в Параметри → Голос → Фраза активації. Прослуховування відбувається на пристрої."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Redde打开时，说“Hey”加智能体的名字即可与它对话，或说“Hey 管家，把灯关掉”直接提问。在设置 → 语音 → 唤醒词中打开此功能并更改唤醒词。聆听在设备上进行。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Redde 打開時，說「Hey」加上代理的名稱即可與它交談，或說「Hey Home，把燈關掉」直接詢問。可在「設定」→「語音」→「喚醒語」中開啟此功能並更改喚醒語。聆聽在裝置上進行。"
          }
        }
      }
    },
    "With your Hermes's Redde plugin 1.11 and the Dashboard login, traffic is checked again 20 minutes before you leave." : {
      "comment" : "Settings, Leave-By Alerts footer: the re-check",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Med Redde-plugin'et 1.11 på din Hermes og login til Dashboard tjekkes trafikken igen 20 minutter før du skal af sted."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit dem Redde-Plug-in 1.11 auf deinem Hermes und der Dashboard-Anmeldung wird der Verkehr 20 Minuten vor der Abfahrt erneut geprüft."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con el plugin de Redde 1.11 en tu Hermes y el inicio de sesión del Dashboard, el tráfico se vuelve a comprobar 20 minutos antes de salir."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avec le plug-in Redde 1.11 sur votre Hermes et l'identifiant du Dashboard, le trafic est revérifié 20 minutes avant votre départ."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con il plug-in Redde 1.11 sul tuo Hermes e l'accesso al Dashboard, il traffico viene ricontrollato 20 minuti prima della partenza."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HermesのReddeプラグイン1.11とDashboardのログインがあれば、出発の20分前に交通状況をもう一度確認します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes의 Redde 플러그인 1.11과 Dashboard 로그인이 있으면 출발 20분 전에 교통 상황을 다시 확인합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Med Redde-tillegget 1.11 på Hermes og pålogging til Dashboard sjekkes trafikken igjen 20 minutter før du drar."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Met de Redde-plug-in 1.11 op je Hermes en de Dashboard-login wordt het verkeer 20 minuten voor vertrek opnieuw gecontroleerd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Z wtyczką Redde 1.11 na Twoim Hermesie i logowaniem do Dashboardu ruch jest sprawdzany ponownie 20 minut przed wyjazdem."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Com o plugin do Redde 1.11 no seu Hermes e o login do Dashboard, o trânsito é verificado de novo 20 minutos antes de você sair."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "С плагином Redde 1.11 на вашем Hermes и входом в Dashboard пробки проверяются ещё раз за 20 минут до выезда."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Med Redde-pluginet 1.11 på din Hermes och inloggning till Dashboard kontrolleras trafiken igen 20 minuter innan du ska åka."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes'inizde Redde eklentisi 1.11 ve Dashboard girişi varsa trafik, çıkmadan 20 dakika önce yeniden kontrol edilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "З плагіном Redde 1.11 на вашому Hermes і входом у Dashboard затори перевіряються ще раз за 20 хвилин до виїзду."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果你的 Hermes 装有 Redde 插件 1.11 并保存了 Dashboard 登录，出发前 20 分钟会再次查看路况。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果你的 Hermes 裝有 Redde 外掛 1.11 並儲存了 Dashboard 登入，出發前 20 分鐘會再次查看路況。"
          }
        }
      }
    },

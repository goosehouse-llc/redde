          "stringUnit" : {
            "state" : "translated",
            "value" : "Vad Redde kan göra. Skapa och redigera härifrån; ändringar gäller från nästa tur."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Redde'nin yapabildikleri. Buradan oluşturun ve düzenleyin; değişiklikler sonraki turda geçerli olur."

    "Calls use the %@ key above, kept in your iPhone's Keychain, on either connection." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opkald bruger %@-nøglen ovenfor, der opbevares i din iPhones nøglering, på begge forbindelser."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anrufe nutzen den %@-Schlüssel oben, gesichert im Schlüsselbund deines iPhone, bei beiden Verbindungen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las llamadas usan la clave de %@ de arriba, guardada en el llavero de tu iPhone, con cualquiera de las dos conexiones."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les appels utilisent la clé %@ ci-dessus, conservée dans le trousseau de votre iPhone, quelle que soit la connexion."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le chiamate usano la chiave %@ qui sopra, salvata nel Portachiavi di iPhone, con entrambe le connessioni."

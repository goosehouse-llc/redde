    "Toolsets enabled on the gateway. Read through the Hermes API key or the Hermes Dashboard login, whichever is set." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Værktøjssæt, der er slået til på gatewayen. Læses via Hermes API-nøglen eller login til Hermes Dashboard, alt efter hvilken der er indstillet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auf dem Gateway aktivierte Toolsets. Gelesen über den Hermes-API-Schlüssel oder die Hermes-Dashboard-Anmeldung, je nachdem, was festgelegt ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conjuntos de herramientas activados en el gateway. Se leen con la clave de la Hermes API o con el inicio de sesión del Hermes Dashboard, el que esté configurado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ensembles d’outils activés sur la passerelle. Lus via la clé Hermes API ou l’identifiant du Hermes Dashboard, selon ce qui est défini."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Set di strumenti attivi sul gateway. Letti tramite la chiave della Hermes API o l'accesso alla Hermes Dashboard, a seconda di quale è impostato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ゲートウェイで有効なツールセット。Hermes APIキーまたはHermes Dashboardのログイン情報のうち、設定されている方で読み取ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "게이트웨이에서 활성화된 도구 세트입니다. Hermes API 키 또는 Hermes Dashboard 로그인 중 설정된 것을 통해 읽습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verktøysett som er aktivert på gatewayen. Leses via Hermes API-nøkkelen eller påloggingen til Hermes Dashboard, avhengig av hva som er angitt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toolsets die op de gateway aanstaan. Gelezen via de Hermes API-sleutel of de Hermes Dashboard-login, welke er ook is ingesteld."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zestawy narzędzi włączone w bramie. Odczytywane za pomocą klucza Hermes API lub loginu do Hermes Dashboard – tego, co jest ustawione."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conjuntos de ferramentas ativados no gateway. Lidos pela chave da Hermes API ou pelo login do Hermes Dashboard, o que estiver definido."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Наборы инструментов, включенные на шлюзе. Читаются через ключ Hermes API или вход в Hermes Dashboard — что из них задано."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verktygsuppsättningar som är påslagna på gatewayn. Läses via Hermes API-nyckeln eller inloggningen för Hermes Dashboard, beroende på vilken som är inställd."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ağ geçidinde etkin araç setleri. Hangisi ayarlıysa Hermes API anahtarı ya da Hermes Dashboard girişi üzerinden okunur."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Набори інструментів, увімкнені на шлюзі. Читаються за ключем Hermes API або даними входу Hermes Dashboard — залежно від того, що задано."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "网关上已启用的工具集。通过Hermes API密钥或Hermes Dashboard登录信息读取，以已设置的为准。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "閘道上已啟用的工具集。透過 Hermes API 金鑰或 Hermes Dashboard 登入資訊讀取，以已設定者為準。"
          }
        }
      }
    },

    "Chats already open keep the tools they started with." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chats, der allerede er åbne, beholder de værktøjer, de startede med."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bereits offene Chats behalten die Tools, mit denen sie begonnen haben."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los chats ya abiertos conservan las herramientas con las que empezaron."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les discussions déjà ouvertes gardent les outils avec lesquels elles ont commencé."

    "Add Redde's Ask a Redde Bot a Question (to a bot, in its own chat) or Ask Redde a Question (to your agent), and type what it should do." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tilføj Reddes handling “Stil en Redde-bot et spørgsmål” (til en bot, i dens egen chat) eller “Stil Redde et spørgsmål” (til din agent), og skriv, hvad den skal gøre."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Füge Reddes Aktion „Einem Redde-Bot eine Frage stellen“ (an einen Bot, in seinem eigenen Chat) oder „Redde eine Frage stellen“ (an deinen Agenten) hinzu und gib ein, was sie tun soll."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade la acción de Redde “Hacer una pregunta a un bot de Redde” (a un bot, en su propio chat) o “Hacer una pregunta a Redde” (a tu agente) y escribe qué debe hacer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoutez l’action Redde « Poser une question à un bot Redde » (à un bot, dans sa propre discussion) ou « Poser une question à Redde » (à votre agent), puis tapez ce qu’elle doit faire."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiungi l'azione di Redde “Fai una domanda a un bot di Redde” (a un bot, nella sua chat) o “Fai una domanda a Redde” (al tuo agente) e scrivi cosa deve fare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reddeの「Reddeボットに質問する」（ボットに、そのボット自身のチャットで）または「Reddeに質問する」（エージェントに）アクションを追加して、何をしてほしいかを入力します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Redde의 ‘Redde 봇에게 질문하기’(봇에게, 해당 봇의 채팅에서) 또는 ‘Redde에게 질문하기’(에이전트에게) 동작을 추가하고 무엇을 해야 하는지 입력하십시오."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Legg til Reddes handling «Still en Redde-bot et spørsmål» (til en bot, i dens egen chat) eller «Still Redde et spørsmål» (til agenten din), og skriv hva den skal gjøre."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voeg de Redde-actie ‘Stel een Redde-bot een vraag’ (aan een bot, in zijn eigen chat) of ‘Stel Redde een vraag’ (aan je agent) toe en typ wat hij moet doen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dodaj czynność Redde „Zadaj pytanie botowi Redde” (do bota, w jego własnym czacie) lub „Zadaj pytanie Redde” (do Twojego agenta) i wpisz, co ma zrobić."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adicione a ação do Redde “Fazer uma Pergunta a um Bot do Redde” (para um bot, na conversa dele) ou “Fazer uma Pergunta ao Redde” (para o seu agente) e digite o que ela deve fazer."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Добавьте действие Redde «Задать вопрос боту Redde» (боту, в его собственном чате) или «Задать вопрос Redde» (вашему агенту) и введите, что нужно сделать."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lägg till Reddes åtgärd ”Ställ en fråga till en Redde-bot” (till en bot, i dess egen chatt) eller ”Ställ en fråga till Redde” (till din agent) och skriv vad den ska göra."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Redde'nin “Redde Botuna Soru Sor” (bir bota, kendi sohbetinde) ya da “Redde'ye Soru Sor” (ajanınıza) eylemini ekleyin ve ne yapması gerektiğini yazın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Додайте дію Redde «Поставити запитання боту Redde» (боту, у його власному чаті) або «Поставити запитання Redde» (вашому агенту) і введіть, що треба зробити."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "添加Redde的“向Redde机器人提问”（发给某个机器人，在它自己的聊天中）或“向Redde提问”（发给你的智能体）操作，然后输入它应该做什么。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "加入 Redde 的「問 Redde 機器人一個問題」（傳給某個機器人，在它自己的聊天中）或「問 Redde 一個問題」（傳給你的代理）動作，然後輸入它要做什麼。"
          }
        }
      }
    },

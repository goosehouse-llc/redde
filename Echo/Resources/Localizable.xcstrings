    "That Hermes is set to send through another relay (%@), which this copy of Redde doesn't use." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den Hermes er indstillet til at sende via et andet relæ (%@), som denne kopi af Redde ikke bruger."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Hermes sendet über ein anderes Relay (%@), das diese Redde-Installation nicht nutzt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ese Hermes está configurado para enviar a través de otro relé (%@), que esta copia de Redde no usa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cet Hermes est configuré pour passer par un autre relais (%@), que cet exemplaire de Redde n’utilise pas."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quell'Hermes è impostato per inviare tramite un altro relay (%@), che questa copia di Redde non usa."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "そのHermesは別のリレー（%@）経由で送信するよう設定されていますが、このReddeはそのリレーを使用しません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "해당 Hermes는 다른 릴레이(%@)를 통해 보내도록 설정되어 있으며, 이 Redde에서는 해당 릴레이를 사용하지 않습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den Hermes er satt opp til å sende via et annet relé (%@), som denne kopien av Redde ikke bruker."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Hermes is ingesteld om via een andere relay te versturen (%@), die deze versie van Redde niet gebruikt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ten Hermes wysyła przez inny przekaźnik (%@), którego ta kopia Redde nie używa."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esse Hermes está configurado para enviar por outro retransmissor (%@), que esta cópia do Redde não usa."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Этот Hermes настроен на отправку через другой ретранслятор (%@), который эта копия Redde не использует."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",

            "value" : "Verktygen %@ har."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ajanının araçları."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Інструменти, які має %@."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {

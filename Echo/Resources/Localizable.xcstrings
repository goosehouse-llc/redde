    "Aliases catch the ways speech recognition tends to hear the word." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aliasser fanger de måder, talegenkendelse plejer at høre ordet på."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aliasse fangen ab, wie die Spracherkennung das Wort oft versteht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los alias recogen las formas en que el reconocimiento de voz suele oír la palabra."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les alias couvrent les façons dont la reconnaissance vocale a tendance à entendre le mot."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli alias coprono i modi in cui il riconoscimento vocale tende a sentire la parola."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "別名は、音声認識がその単語を聞き取りがちな表記をカバーします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "별칭으로 음성 인식이 단어를 흔히 잘못 알아듣는 형태도 인식합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aliaser fanger opp måtene talegjenkjenningen pleier å høre ordet på."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aliassen vangen op hoe spraakherkenning het woord vaak verstaat."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aliasy wyłapują to, jak rozpoznawanie mowy zwykle słyszy to słowo."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os apelidos captam as formas como o reconhecimento de fala costuma ouvir a palavra."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Псевдонимы учитывают, как распознавание речи обычно слышит слово."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alias fångar de sätt som taligenkänningen brukar höra ordet på."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diğer adlar, konuşma tanımanın sözcüğü duyma eğiliminde olduğu biçimleri yakalar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Псевдоніми вловлюють варіанти того, як розпізнавання мовлення чує це слово."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "别名可以涵盖语音识别可能听成的各种说法。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "別名可涵蓋語音辨識容易將該字詞聽成的各種說法。"
          }
        }
      }
    },

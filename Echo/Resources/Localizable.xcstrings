    "Does what you ask and tells you exactly what it did; asks only before paying or deleting." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gør det, du beder om, og fortæller præcis, hvad der blev gjort; spørger kun før betaling eller sletning."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tut, worum du bittest, und sagt dir genau, was getan wurde; fragt nur vor dem Bezahlen oder Löschen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hace lo que pides y te dice exactamente qué hizo; solo pregunta antes de pagar o eliminar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fait ce que vous demandez et vous dit exactement ce qui a été fait ; demande seulement avant de payer ou de supprimer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fa ciò che chiedi e ti dice esattamente cosa ha fatto; chiede solo prima di pagare o eliminare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "頼まれたことを実行し、何をしたかを正確に知らせます。確認するのは支払いと削除の前だけです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "요청한 일을 하고 무엇을 했는지 정확히 알려줍니다. 결제나 삭제 전에만 묻습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gjør det du ber om, og sier nøyaktig hva som ble gjort; spør bare før betaling eller sletting."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Doet wat je vraagt en vertelt je precies wat er is gedaan; vraagt alleen eerst bij betalen of verwijderen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Robi to, o co prosisz, i mówi dokładnie, co zostało zrobione; pyta tylko przed zapłatą lub usunięciem."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faz o que você pede e diz exatamente o que fez; só pergunta antes de pagar ou apagar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Делает то, что вы просите, и точно сообщает, что сделано; спрашивает только перед оплатой или удалением."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gör det du ber om och berättar exakt vad som gjordes; frågar bara innan något betalas eller raderas."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İstediğinizi yapar ve tam olarak ne yapıldığını söyler; yalnızca ödemeden ya da silmeden önce sorar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Робить те, що ви просите, і точно повідомляє, що зроблено; питає лише перед оплатою або видаленням."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按你的要求去做，并准确告诉你做了什么；只在付款或删除前问你。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "照你的要求去做，並確切告訴你做了什麼；只在付款或刪除前問你。"
          }

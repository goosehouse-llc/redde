    "Nod for yes, shake your head for no, or say it." : {
      "comment" : "On the voice screen",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nik for ja, ryst på hovedet for nej, eller sig “yes” eller “no”."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nicke für Ja, schüttle den Kopf für Nein, oder sag es."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Asiente para decir sí, niega con la cabeza para decir no, o dilo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hochez la tête pour oui, secouez-la pour non, ou dites « yes » ou « no »."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Annuisci per sì, scuoti la testa per no, oppure di' “yes” o “no”."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "うなずくと「はい」、首を振ると「いいえ」。声で「yes」「no」とも言えます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "예는 고개를 끄덕이고, 아니요는 고개를 저으십시오. 또는 “yes”나 “no”라고 말하십시오."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nikk for ja, rist på hodet for nei, eller si det."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Knik voor ja, schud je hoofd voor nee, of zeg het."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skiń głową na „tak”, pokręć nią na „nie” albo powiedz „yes” lub „no”."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acene com a cabeça para sim, balance-a para não, ou diga “yes” ou “no”."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Кивните — «да», покачайте головой — «нет», или скажите «yes» или «no»."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nicka för ja, skaka på huvudet för nej, eller säg det."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Evet için başınızı sallayın, hayır için iki yana sallayın ya da “yes” veya “no” deyin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Кивніть — «так», похитайте головою — «ні», або скажіть це."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "点头表示yes，摇头表示no，或直接说出来。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "點頭表示 yes，搖頭表示 no，或直接說出來。"
          }
        }
      }
    },
    "Nod or say “%@”. Shake your head or say “%@”." : {
      "comment" : "On the voice screen. The two values are the words Redde listens for to approve and to deny, in the language it listens in",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nik, eller sig “%@”. Ryst på hovedet, eller sig “%@”."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nicke oder sag „%@“. Schüttle den Kopf oder sag „%@“."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Asiente o di “%@”. Niega con la cabeza o di “%@”."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hochez la tête ou dites « %@ ». Secouez la tête ou dites « %@ »."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Annuisci o di' “%@”. Scuoti la testa o di' “%@”."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "うなずくか「%@」と言って承認。首を振るか「%@」と言って拒否。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "고개를 끄덕이거나 “%@”(이)라고 말하십시오. 고개를 젓거나 “%@”(이)라고 말하십시오."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nikk eller si «%@». Rist på hodet eller si «%@»."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Knik of zeg ‘%@’. Schud je hoofd of zeg ‘%@’."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skiń głową lub powiedz „%@”. Pokręć głową lub powiedz „%@”."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acene com a cabeça ou diga “%@”. Balance a cabeça ou diga “%@”."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Кивните или скажите «%@». Покачайте головой или скажите «%@»."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nicka eller säg ”%@”. Skaka på huvudet eller säg ”%@”."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Başınızı aşağı yukarı sallayın ya da “%@” deyin. Başınızı iki yana sallayın ya da “%@” deyin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Кивніть або скажіть «%@». Похитайте головою або скажіть «%@»."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "点头或说“%@”。摇头或说“%@”。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "點頭或說「%@」。搖頭或說「%@」。"
          }
        }
      }
    },

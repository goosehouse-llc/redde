    "Hands a note to Redde to file. Nothing is sent back." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Giver Redde en note, som den gemmer. Der sendes intet tilbage."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Übergibt Redde eine Notiz zum Ablegen. Es kommt keine Antwort."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Da una nota a Redde para que la guarde. No se devuelve nada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Confie une note à Redde pour qu’il la classe. Rien n’est renvoyé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passa a Redde una nota da archiviare. Non arriva nessuna risposta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reddeにメモを渡して記録させます。返信はありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "저장할 메모를 Redde에 전달합니다. 아무 응답도 보내지 않습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gir Redde et notat å ta vare på. Ingenting sendes tilbake."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geeft Redde een notitie om op te bergen. Er wordt niets teruggestuurd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przekazuje notatkę do zapisania przez Redde. Nic nie jest odsyłane."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entrega uma nota ao Redde para arquivar. Nada é respondido."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Передает заметку в Redde для сохранения. Ответа не будет."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lämnar en anteckning till Redde att spara. Inget skickas tillbaka."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaydetmesi için Redde'ye bir not verir. Geri bir şey gönderilmez."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Передає нотатку Redde на збереження. У відповідь нічого не надсилається."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {

            "state" : "translated",
            "value" : "이 iPhone에 %@의 API 키가 없습니다. 프로필의 키로 봇을 다시 추가하십시오."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det finnes ingen API-nøkkel for %@ på denne iPhonen. Legg til boten på nytt med nøkkelen til profilen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er is geen API-sleutel voor %@ op deze iPhone. Voeg de bot opnieuw toe met de sleutel van zijn profiel."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na tym iPhonie nie ma klucza API dla %@. Dodaj bota ponownie z kluczem jego profilu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não há chave de API para %@ neste iPhone. Adicione o bot de novo com a chave do perfil dele."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "На этом iPhone нет ключа API для %@. Добавьте бота снова с ключом его профиля."

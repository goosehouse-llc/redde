    "Pair this device so ideas and briefings arrive with Redde closed." : {
      "comment" : "Ahead of Your Day: offering to pair for notifications",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Par denne enhed, så idéer og briefinger kommer, også når Redde er lukket."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kopple dieses Gerät, damit Ideen und Briefings auch bei geschlossenem Redde ankommen."
          }
        },
        "es" : {

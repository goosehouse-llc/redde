          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Front matter (name, description, version, metadata), потім розділи When to Use, Procedure, Pitfalls, Verification. Redde завантажує навичку на вимогу, коли запит їй відповідає."
          }

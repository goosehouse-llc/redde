    "Allow the camera for Redde in Settings to scan a setup code, or paste the setup link instead." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Giv Redde adgang til kameraet i Indstillinger for at scanne en opsætningskode, eller indsæt opsætningslinket i stedet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erlaube Redde die Kamera in den Einstellungen, um einen Einrichtungscode zu scannen, oder füge stattdessen den Einrichtungslink ein."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permite la cámara para Redde en Ajustes para escanear un código de configuración, o pega el enlace de configuración."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autorisez l’appareil photo pour Redde dans Réglages afin de scanner un code de configuration, ou collez plutôt le lien de configuration."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consenti la fotocamera a Redde in Impostazioni per scansionare un codice di configurazione, oppure incolla il link di configurazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "セットアップコードをスキャンするには設定でReddeにカメラを許可するか、代わりにセットアップリンクをペーストしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "설정 코드를 스캔하려면 설정에서 Redde의 카메라 접근을 허용하거나, 대신 설정 링크를 붙여넣으십시오."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gi Redde tilgang til kameraet i Innstillinger for å skanne en oppsettskode, eller lim inn oppsettslenken i stedet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sta de camera toe voor Redde in Instellingen om een instelcode te scannen, of plak in plaats daarvan de instellink."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zezwól Redde na dostęp do aparatu w Ustawieniach, aby zeskanować kod konfiguracji, lub wklej łącze konfiguracji."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permita a câmera para o Redde nos Ajustes para escanear um código de configuração, ou cole o link de configuração."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Разрешите Redde доступ к камере в Настройках, чтобы сканировать код настройки, или вставьте ссылку настройки."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tillåt kameran för Redde i Inställningar för att skanna en inställningskod, eller klistra in inställningslänken i stället."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kurulum kodu taramak için Ayarlar'da Redde'ye kamera izni verin ya da bunun yerine kurulum bağlantısını yapıştırın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дозвольте камеру для Redde в Параметрах, щоб сканувати код налаштування, або вставте посилання налаштування."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请在设置中允许Redde使用相机以扫描设置码，或改为粘贴设置链接。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在「設定」中允許 Redde 使用相機以掃描設定碼，或改為貼上設定連結。"
          }
        }
      }
    },

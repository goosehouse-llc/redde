          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” não é um nome válido para arquivo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» не может быть именем файла."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "”%@” kan inte användas som filnamn."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” bir dosyanın alabileceği bir ad değil."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» не може бути назвою файлу."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”不能用作文件名。"
          }
        },
        "zh-Hant" : {

    "Adds this device's calendars to the list. Only their names are used, to match the calendars your agent reads." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Føjer denne enheds kalendere til listen. Kun deres navne bruges, til at matche de kalendere, din agent læser."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fügt die Kalender dieses Geräts zur Liste hinzu. Nur ihre Namen werden verwendet, passend zu den Kalendern, die dein Agent liest."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade a la lista los calendarios de este dispositivo. Solo se usan sus nombres, para coincidir con los calendarios que lee tu agente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoute à la liste les calendriers de cet appareil. Seuls leurs noms servent, pour correspondre aux calendriers que lit votre agent."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiunge all'elenco i calendari di questo dispositivo. Si usano solo i nomi, per abbinarli ai calendari che legge il tuo agente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このデバイスのカレンダーをリストに追加します。使うのは名前だけで、エージェントが読むカレンダーと照合します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 기기의 캘린더를 목록에 추가합니다. 에이전트가 읽는 캘린더와 맞추기 위해 이름만 사용합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Legger denne enhetens kalendere til i listen. Bare navnene brukes, for å matche kalenderne agenten din leser."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voegt de agenda's van dit apparaat toe aan de lijst. Alleen hun namen worden gebruikt, om ze te koppelen aan de agenda's die je agent leest."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dodaje do listy kalendarze z tego urządzenia. Używane są tylko ich nazwy, by dopasować je do kalendarzy, które czyta Twój agent."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adiciona à lista os calendários deste dispositivo. Só os nomes são usados, para corresponder aos calendários que seu agente lê."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Добавляет в список календари этого устройства. Используются только их названия, чтобы сопоставить их с календарями, которые читает ваш агент."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lägger till den här enhetens kalendrar i listan. Bara deras namn används, för att matcha kalendrarna din agent läser."
          }
        },
        "tr" : {
          "stringUnit" : {

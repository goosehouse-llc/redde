    "This server has no profile by that name; it may have been renamed or deleted. Pick another under Settings → Profile." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne server har ingen profil med det navn; den kan være omdøbt eller slettet. Vælg en anden under Indstillinger → Profil."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Server hat kein Profil mit diesem Namen; es wurde vielleicht umbenannt oder gelöscht. Wähle ein anderes unter Einstellungen → Profil."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este servidor no tiene ningún perfil con ese nombre; puede que se haya renombrado o eliminado. Elige otro en Ajustes → Perfil."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce serveur n’a aucun profil de ce nom ; il a peut-être été renommé ou supprimé. Choisissez-en un autre dans Réglages → Profil."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo server non ha un profilo con quel nome; potrebbe essere stato rinominato o eliminato. Scegline un altro in Impostazioni → Profilo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このサーバにはその名前のプロファイルがありません。名前が変更されたか、削除された可能性があります。設定 → プロファイルで別のものを選んでください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 서버에 해당 이름의 프로필이 없습니다. 이름이 변경되었거나 삭제되었을 수 있습니다. 설정 → 프로필에서 다른 프로필을 선택하십시오."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne tjeneren har ingen profil med det navnet; den kan ha fått nytt navn eller blitt slettet. Velg en annen under Innstillinger → Profil."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",

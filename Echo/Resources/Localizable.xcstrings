    "Warm near-black and bone with a pale sky accent; serif replies, sans questions, monospaced code." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varm næsten-sort og ben med en lys himmelblå accent; svar med serif, spørgsmål uden, kode i fast bredde."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Warmes Fast-Schwarz und Knochenweiß mit blassem Himmelsakzent; Antworten mit Serifen, Fragen ohne, Code in Monospace."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Casi negro cálido y hueso con un acento azul cielo pálido; respuestas con serifa, preguntas sin serifa, código monoespaciado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quasi-noir chaud et os avec un accent bleu ciel pâle ; réponses avec empattements, questions sans empattements, code à chasse fixe."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quasi nero caldo e osso con un accento celeste pallido; risposte con grazie, domande senza grazie, codice a spaziatura fissa."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "温かみのある黒とボーンホワイトに淡いスカイのアクセント。返答はセリフ体、質問はサンセリフ体、コードは等幅。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "연한 하늘색 강조 색상의 따뜻한 검은색과 아이보리. 응답은 세리프, 질문은 산세리프, 코드는 고정폭."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varm nesten-svart og beinhvit med en blek himmelblå aksent; svar med seriffer, spørsmål uten, kode i fast bredde."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Warm bijna-zwart en ivoor met een bleek hemelsblauw accent; antwoorden met schreef, vragen schreefloos, code in monospace."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ciepła prawie czerń i kość słoniowa z bladobłękitnym akcentem; odpowiedzi szeryfowe, pytania bezszeryfowe, kod o stałej szerokości."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quase preto quente e osso com destaque celeste claro; respostas com serifa, perguntas sem serifa, código monoespaçado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Теплый почти черный и цвет кости с бледно-голубым акцентом; ответы с засечками, вопросы без засечек, моноширинный код."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varmt nästan svart och benvitt med en blek himmelsblå accent; svar med serifer, frågor utan, kod med fast bredd."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Soluk gök mavisi vurgulu sıcak, neredeyse siyah ve kemik rengi; serif yanıtlar, sans serif sorular, eş aralıklı kod."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Теплий майже чорний і кістяний з блідо-небесним акцентом; відповіді — шрифтом із засічками, запитання — без засічок, код — моноширинним."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "暖近黑与骨白，配淡天蓝强调色；回复用衬线体，提问用无衬线体，代码用等宽字体。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "溫暖的近黑與骨白，搭配淡天藍強調色；回覆用襯線字體，提問用無襯線字體，程式碼用等寬字體。"
          }
        }
      }
    },
    "Warm paper and ink; dark ink and parchment after dark." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varmt papir og blæk; mørkt blæk og pergament efter mørkets frembrud."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Warmes Papier und Tinte; dunkle Tinte und Pergament bei Nacht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Papel cálido y tinta; de noche, tinta oscura y pergamino."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Papier chaud et encre ; encre sombre et parchemin à la nuit tombée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Carta calda e inchiostro; inchiostro scuro e pergamena di sera."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "温かみのある紙とインク。暗くなると、濃いインクと羊皮紙に。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "따뜻한 종이와 잉크, 어두워지면 짙은 잉크와 양피지."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varmt papir og blekk; mørkt blekk og pergament når det blir mørkt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Warm papier en inkt; na zonsondergang donkere inkt en perkament."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ciepły papier i atrament; po zmroku ciemny atrament i pergamin."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Papel e tinta quentes; tinta escura e pergaminho à noite."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Теплая бумага и чернила; темные чернила и пергамент вечером."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varmt papper och bläck; mörkt bläck och pergament när det blir mörkt."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sıcak kâğıt ve mürekkep; hava kararınca koyu mürekkep ve parşömen."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Теплий папір і чорнило; темне чорнило й пергамент увечері."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "暖色纸张与墨水；入夜后为深色墨水与羊皮纸。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "溫暖的紙張與墨水；入夜後是深色墨水與羊皮紙。"
          }
        }
      }
    },

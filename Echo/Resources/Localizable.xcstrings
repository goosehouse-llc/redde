    "Restarts Hermes after, and puts everything back if Hermes isn't well" : {
      "comment" : "Approval card: what happens after a change to Hermes's settings",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Genstarter Hermes bagefter og sætter alt tilbage, hvis Hermes ikke har det godt"
          }

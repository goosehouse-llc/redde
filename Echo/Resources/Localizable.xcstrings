    "Hermes fetches it from %@ at the version its catalog names, checks it, and switches it on." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes henter den fra %@ i den version, kataloget angiver, tjekker den og slår den til."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes ruft es in der im Katalog genannten Version von %@ ab, prüft es und schaltet es ein."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes lo descarga de %@ en la versión que indica su catálogo, lo comprueba y lo activa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes le récupère sur %@ dans la version indiquée par son catalogue, le vérifie et l’active."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes lo scarica da %@ alla versione indicata dal suo catalogo, lo verifica e lo attiva."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermesはカタログに記載されたバージョンを%@から取得し、確認してからオンにします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes가 카탈로그에 명시된 버전으로 %@에서 가져와 확인한 다음 켭니다."
          }
        },
        "nb" : {

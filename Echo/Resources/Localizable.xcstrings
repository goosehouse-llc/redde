    "Hidden here and in Hermes Desktop alike. A hidden bot keeps its chat, and the other bots can still message it." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skjult her og i Hermes Desktop. En skjult bot beholder sin chat, og de andre bots kan stadig skrive til den."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hier und in Hermes Desktop gleichermaßen ausgeblendet. Ein ausgeblendeter Bot behält seinen Chat, und die anderen Bots können ihm weiterhin schreiben."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se oculta aquí y también en Hermes Desktop. Un bot oculto conserva su chat, y los demás bots aún pueden escribirle."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Masqué ici comme dans Hermes Desktop. Un bot masqué garde sa discussion, et les autres bots peuvent toujours lui écrire."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nascosto qui come in Hermes Desktop. Un bot nascosto mantiene la sua chat, e gli altri bot possono ancora scrivergli."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ここでもHermes Desktopでも非表示になります。非表示のボットのチャットは残り、ほかのボットからメッセージを送ることもできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "여기와 Hermes Desktop 모두에서 가려집니다. 가려진 봇은 채팅을 유지하며 다른 봇이 계속 메시지를 보낼 수 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skjult både her og i Hermes Desktop. En skjult bot beholder chatten sin, og de andre botene kan fortsatt sende meldinger til den."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verborgen, hier en in Hermes Desktop. Een verborgen bot houdt zijn chat, en de andere bots kunnen hem nog steeds berichten sturen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ukryty tutaj i w Hermes Desktop. Ukryty bot zachowuje swój czat, a inne boty wciąż mogą do niego pisać."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oculto aqui e no Hermes Desktop. Um bot oculto mantém a conversa, e os outros bots ainda podem enviar mensagens a ele."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Скрыт и здесь, и в Hermes Desktop. Скрытый бот сохраняет свой чат, и другие боты по-прежнему могут ему писать."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gömd både här och i Hermes Desktop. En gömd bot behåller sin chatt, och de andra bottarna kan fortfarande skriva till den."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hem burada hem Hermes Desktop'ta gizlenir. Gizlenen bir bot sohbetini korur ve diğer botlar ona yine mesaj gönderebilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Приховується і тут, і в Hermes Desktop. Прихований бот зберігає свій чат, а інші боти й далі можуть йому писати."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在这里和Hermes Desktop中都会隐藏。隐藏的机器人会保留其聊天，其他机器人仍可给它发消息。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在這裡和 Hermes Desktop 中都會隱藏。隱藏的機器人會保留它的聊天，其他機器人仍可傳訊息給它。"
          }
        }
      }
    },

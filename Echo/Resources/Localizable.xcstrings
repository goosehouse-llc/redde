    "Choose Select text on a reply, select a sentence and tap Ask about this. It lands in your message as a quote." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vælg Vælg tekst på et svar, marker en sætning, og tryk på Spørg om dette. Den havner i din besked som et citat."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle bei einer Antwort „Text auswählen“, markiere einen Satz und tippe auf „Danach fragen“. Er landet als Zitat in deiner Nachricht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige Seleccionar texto en una respuesta, selecciona una frase y toca Preguntar sobre esto. Llega a tu mensaje como cita."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez Sélectionner le texte sur une réponse, sélectionnez une phrase et touchez Poser une question à ce sujet. Elle arrive dans votre message en citation."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scegli Seleziona testo su una risposta, seleziona una frase e tocca Chiedi di questo. Finisce nel messaggio come citazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "返答で「テキストを選択」を選び、文を選択して「これについて質問」をタップします。メッセージに引用として入ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "응답에서 텍스트 선택을 선택하고 문장을 선택한 다음 이것에 대해 묻기를 탭하십시오. 메시지에 인용문으로 들어갑니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Velg Marker tekst på et svar, marker en setning og trykk på Spør om dette. Den havner i meldingen din som et sitat."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kies ‘Selecteer tekst’ bij een antwoord, selecteer een zin en tik op ‘Vraag hierover’. Die komt als citaat in je bericht."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wybierz Zaznacz tekst przy odpowiedzi, zaznacz zdanie i stuknij Zapytaj o to. Trafi do wiadomości jako cytat."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolha Selecionar texto em uma resposta, selecione uma frase e toque em Perguntar sobre isto. Ela entra na sua mensagem como citação."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выберите «Выбрать текст» в ответе, выделите предложение и коснитесь «Спросить об этом». Оно попадет в ваше сообщение как цитата."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Välj Markera text på ett svar, markera en mening och tryck på Fråga om det här. Den hamnar i ditt meddelande som ett citat."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir yanıtta Metni seç'i seçin, bir cümle seçin ve Bunu sor'a dokunun. Mesajınıza alıntı olarak eklenir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Виберіть «Вибрати текст» на відповіді, виділіть речення й торкніться «Запитати про це». Воно з’явиться у вашому повідомленні як цитата."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在回复上选择“选择文本”，选中一个句子并轻点“就此提问”。它会作为引用出现在你的消息中。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在回覆上選擇「選取文字」，選取一個句子後點一下「詢問此內容」。它會以引文形式放入你的訊息。"
          }
        }
      }
    },

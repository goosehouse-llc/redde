    "Spoken replies play at full volume on the speaker, follow the volume buttons, and move to the earpiece when you raise the phone to your ear." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oplæste svar afspilles med fuld lydstyrke i højttaleren, følger lydstyrkeknapperne og flyttes til ørehøjttaleren, når du holder telefonen op til øret."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gesprochene Antworten laufen mit voller Lautstärke über den Lautsprecher, folgen den Lautstärketasten und wechseln zur Hörmuschel, wenn du das iPhone ans Ohr hältst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las respuestas habladas suenan a todo volumen por el altavoz, siguen los botones de volumen y pasan al auricular cuando te acercas el teléfono a la oreja."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les réponses parlées sont lues à plein volume sur le haut-parleur, suivent les boutons de volume, et passent à l’écouteur quand vous portez le téléphone à l’oreille."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le risposte a voce suonano a pieno volume dall'altoparlante, seguono i tasti del volume, e passano al ricevitore quando avvicini il telefono all'orecchio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "音声の返答はスピーカーから最大音量で再生され、音量ボタンに従い、iPhoneを耳に当てると受話口に切り替わります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "음성 응답은 스피커에서 최대 음량으로 재생되고, 음량 버튼을 따르며, 휴대폰을 귀에 대면 수화부로 전환됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opplest svar spilles av med full lydstyrke i høyttaleren, følger volumknappene og flyttes til ørehøyttaleren når du holder telefonen mot øret."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gesproken antwoorden spelen op vol volume via de luidspreker, volgen de volumeknoppen, en gaan naar de oorspeaker als je de telefoon tegen je oor houdt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odpowiedzi głosowe grają z pełną głośnością przez głośnik, reagują na przyciski głośności i przechodzą na głośnik do rozmów, gdy przyłożysz telefon do ucha."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As respostas faladas tocam no volume máximo no alto-falante, seguem os botões de volume e passam para o receptor quando você leva o telefone ao ouvido."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Озвученные ответы звучат на полной громкости через динамик, подчиняются кнопкам громкости и переходят в разговорный динамик, когда вы подносите телефон к уху."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Upplästa svar spelas med full volym i högtalaren, följer volymknapparna och flyttas till luren när du håller telefonen mot örat."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sesli yanıtlar hoparlörde tam ses çalar, ses düğmelerini izler ve telefonu kulağınıza götürdüğünüzde ahizeye geçer."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Озвучені відповіді звучать на повній гучності з динаміка, реагують на кнопки гучності й переходять на розмовний динамік, коли ви підносите телефон до вуха."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "语音回复会以全音量通过扬声器播放，跟随音量按钮调节，并在你将手机举到耳边时转到听筒。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "語音回覆會以完整音量從揚聲器播放、跟隨音量按鈕調整，並在你將手機拿到耳邊時改由聽筒播放。"
          }
        }
      }
    },

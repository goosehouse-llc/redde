    "Redde has looked at %@ of %@ pictures so far, and goes on while it is open." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Redde har set på %@ af %@ billeder indtil videre og fortsætter, mens den er åben."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Redde hat bisher %@ von %@ Bildern angesehen und macht weiter, solange es geöffnet ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Redde ha mirado %@ de %@ imágenes por ahora, y sigue mientras está abierto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Redde a regardé %@ images sur %@ jusqu’ici, et continue tant qu’il est ouvert."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finora Redde ha esaminato %@ immagini su %@, e continua finché resta aperta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reddeはこれまでに%2$@枚中%1$@枚の画像を確認しました。開いている間は確認を続けます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Redde가 지금까지 사진 %2$@장 중 %1$@장을 살펴봤으며, 앱이 열려 있는 동안 계속합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Redde har sett på %@ av %@ bilder så langt, og fortsetter mens appen er åpen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Redde heeft tot nu toe %@ van %@ afbeeldingen bekeken en gaat door zolang het open is."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Redde przejrzało dotąd %@ z %@ obrazów i kontynuuje, gdy jest otwarte."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Redde viu %@ de %@ imagens até agora e continua enquanto estiver aberto."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пока просмотрено изображений: %@ из %@; просмотр продолжается, пока Redde открыт."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Redde har tittat på %@ av %@ bilder hittills och fortsätter medan appen är öppen."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Redde şu ana kadar %2$@ resmin %1$@ tanesine baktı ve açık kaldığı sürece bakmayı sürdürüyor."

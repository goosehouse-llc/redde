          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaarten in Gereed die aan iemand zijn toegewezen, worden opgepakt door de dispatcher; andere wachten in Triage."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Karty Przygotowane z wykonawcą są odbierane przez dyspozytora; pozostałe czekają w Selekcji."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cartões em Pronto com responsável são pegos pelo despachante; os outros esperam em Triagem."

          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En ny server kan fyllas i från en inställningskod: skanna eller klistra in en på dess inställningsskärm."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yeni bir sunucu bir kurulum koduyla doldurulabilir: kurulum ekranında bir kod tarayın ya da yapıştırın."

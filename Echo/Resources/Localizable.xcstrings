    "Siri access is off. Turn on “Let Siri use Redde” in Redde's Settings." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siri-adgang er slået fra. Slå “Lad Siri bruge Redde” til i Reddes indstillinger."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siri-Zugriff ist aus. Aktiviere „Siri darf Redde nutzen“ in den Einstellungen von Redde."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El acceso de Siri está desactivado. Activa “Permitir que Siri use Redde” en los ajustes de Redde."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’accès de Siri est désactivé. Activez « Autoriser Siri à utiliser Redde » dans les réglages de Redde."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'accesso di Siri è disattivato. Attiva “Consenti a Siri di usare Redde” nelle impostazioni di Redde."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siriのアクセスはオフです。Reddeの設定で「SiriにReddeの使用を許可」をオンにしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siri 접근이 꺼져 있습니다. Redde 설정에서 “Siri가 Redde를 사용하도록 허용”을 켜십시오."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siri-tilgang er av. Slå på «La Siri bruke Redde» i Innstillinger i Redde."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siri-toegang staat uit. Zet ‘Laat Siri Redde gebruiken’ aan in de instellingen van Redde."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dostęp Siri jest wyłączony. Włącz „Pozwól Siri używać Redde” w Ustawieniach Redde."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O acesso da Siri está desativado. Ative “Permitir que a Siri use o Redde” nos Ajustes do Redde."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Доступ Siri выключен. Включите «Разрешить Siri использовать Redde» в настройках Redde."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siri-åtkomst är av. Slå på ”Låt Siri använda Redde” i Reddes inställningar."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siri erişimi kapalı. Redde'nin ayarlarında “Siri Redde'yi kullanabilsin” seçeneğini açın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Доступ Siri вимкнено. Увімкніть «Дозволити Siri використовувати Redde» в Параметрах Redde."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siri访问已关闭。请在Redde的设置中打开“允许Siri使用Redde”。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siri 取用已關閉。請在 Redde 的設定中開啟「允許 Siri 使用 Redde」。"
          }
        }
      }
    },

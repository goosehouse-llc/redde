    "The access gate in front of %@ turned the request away (HTTP %lld). Check the Cloudflare Access client ID and secret, the Pangolin access token, or the custom headers." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adgangsporten foran %@ afviste anmodningen (HTTP %lld). Tjek klient-id og hemmelighed til Cloudflare Access, Pangolin-adgangstokenet eller de tilpassede headere."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Zugangssperre vor %@ hat die Anfrage abgewiesen (HTTP %lld). Prüfe Client-ID und Secret von Cloudflare Access, das Pangolin-Zugriffstoken oder die eigenen Header."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La puerta de acceso delante de %@ rechazó la solicitud (HTTP %lld). Comprueba el ID y el secreto de cliente de Cloudflare Access, el token de acceso de Pangolin o los encabezados personalizados."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le contrôle d’accès devant %@ a refusé la requête (HTTP %lld). Vérifiez l’ID client et le secret Cloudflare Access, le jeton d’accès Pangolin, ou les en-têtes personnalisés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il controllo di accesso davanti a %@ ha respinto la richiesta (HTTP %lld). Controlla l'ID client e il segreto di Cloudflare Access, il token di accesso Pangolin o le intestazioni personalizzate."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@の前段にあるアクセスゲートがリクエストを拒否しました（HTTP %lld）。Cloudflare AccessのクライアントIDとシークレット、Pangolinのアクセストークン、またはカスタムヘッダを確認してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 앞의 접근 게이트가 요청을 거부했습니다(HTTP %lld). Cloudflare Access 클라이언트 ID와 비밀 값, Pangolin 접근 토큰 또는 사용자 지정 헤더를 확인하십시오."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tilgangssperren foran %@ avviste forespørselen (HTTP %lld). Sjekk klient-ID-en og hemmeligheten for Cloudflare Access, Pangolin-tilgangstokenet eller de egendefinerte headerne."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De toegangspoort voor %@ heeft het verzoek geweigerd (HTTP %lld). Controleer de client-ID en het geheim van Cloudflare Access, het Pangolin-toegangstoken of de aangepaste headers."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bramka dostępu przed %@ odrzuciła żądanie (HTTP %lld). Sprawdź ID klienta i sekret Cloudflare Access, token dostępu Pangolin lub własne nagłówki."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O portal de acesso na frente de %@ recusou o pedido (HTTP %lld). Verifique o ID e o segredo do cliente do Cloudflare Access, o token de acesso do Pangolin ou os cabeçalhos personalizados."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Защита доступа перед %@ отклонила запрос (HTTP %lld). Проверьте ID и секрет клиента Cloudflare Access, токен доступа Pangolin или свои заголовки."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Åtkomstspärren framför %@ avvisade begäran (HTTP %lld). Kontrollera klient-ID och hemlighet för Cloudflare Access, åtkomsttoken för Pangolin eller de anpassade headers."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ önündeki erişim kapısı isteği geri çevirdi (HTTP %lld). Cloudflare Access istemci kimliğini ve gizli anahtarını, Pangolin erişim token'ını ya da özel üst bilgileri denetleyin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Захист доступу перед %@ відхилив запит (HTTP %lld). Перевірте ID і секрет клієнта Cloudflare Access, токен доступу Pangolin або власні заголовки."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@前面的访问控制拒绝了请求（HTTP %lld）。请检查Cloudflare Access客户端ID和密钥、Pangolin访问令牌或自定标头。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 前方的存取閘門拒絕了請求（HTTP %lld）。請檢查 Cloudflare Access 用戶端 ID 和密鑰、Pangolin 存取權杖，或自訂標頭。"
          }
        }
      }
    },

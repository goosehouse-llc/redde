    "This group chat runs in Hermes Desktop. Its last messages show here; to talk in it, use Desktop." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne gruppechat kører i Hermes Desktop. Dens seneste beskeder vises her; brug Desktop for at skrive i den."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Gruppenchat läuft in Hermes Desktop. Seine letzten Nachrichten erscheinen hier; zum Mitreden nutze Desktop."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este chat de grupo funciona en Hermes Desktop. Aquí se ven sus últimos mensajes; para hablar en él, usa Desktop."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette discussion de groupe a lieu dans Hermes Desktop. Ses derniers messages s’affichent ici ; pour y participer, utilisez Desktop."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questa chat di gruppo è in Hermes Desktop. Qui vedi gli ultimi messaggi; per parlarci, usa Desktop."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このグループチャットはHermes Desktopで動作しています。最新のメッセージはここに表示されます。会話するにはDesktopを使用してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 그룹 채팅은 Hermes Desktop에서 실행됩니다. 마지막 메시지가 여기에 표시되며, 대화하려면 Desktop을 사용하십시오."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne gruppechatten kjører i Hermes Desktop. De siste meldingene vises her; bruk Desktop for å snakke i den."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deze groepschat draait in Hermes Desktop. De laatste berichten staan hier; gebruik Desktop om erin te praten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ten czat grupowy działa w Hermes Desktop. Tu widać jego ostatnie wiadomości; aby w nim rozmawiać, użyj Desktop."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta conversa em grupo roda no Hermes Desktop. As últimas mensagens aparecem aqui; para participar, use o Desktop."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Этот групповой чат работает в Hermes Desktop. Здесь видны последние сообщения; чтобы писать в нем, используйте Desktop."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den här gruppchatten körs i Hermes Desktop. Dess senaste meddelanden visas här; använd Desktop för att prata i den."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu grup sohbeti Hermes Desktop'ta çalışır. Son mesajları burada görünür; içinde konuşmak için Desktop'u kullanın."
          }
        },
        "uk" : {
          "stringUnit" : {

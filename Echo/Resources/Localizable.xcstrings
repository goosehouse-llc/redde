            "value" : "Tus proyectos de Hermes, encima de las conversaciones. Desactivado, sus conversaciones siguen en la lista."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos projets Hermes, au-dessus des conversations. Désactivé, leurs conversations restent dans la liste."

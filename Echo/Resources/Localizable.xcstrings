    },
    "Anyone who can reach this address can use your agent. Only use it over a private network like Tailscale." : {
      "comment" : "Warning shown for a Hermes Dashboard with no sign-in",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle, der kan nå denne adresse, kan bruge din agent. Brug den kun via et privat netværk som Tailscale."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeder, der diese Adresse erreicht, kann deinen Agenten nutzen. Verwende sie nur über ein privates Netzwerk wie Tailscale."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cualquiera que pueda llegar a esta dirección puede usar tu agente. Úsala solo a través de una red privada como Tailscale."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toute personne pouvant joindre cette adresse peut utiliser votre agent. Ne l’utilisez que sur un réseau privé comme Tailscale."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chiunque possa raggiungere questo indirizzo può usare il tuo agente. Usalo solo su una rete privata come Tailscale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このアドレスにアクセスできる人は誰でもエージェントを使用できます。Tailscaleのようなプライベートネットワーク経由でのみ使用してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 주소에 접근할 수 있는 누구나 에이전트를 사용할 수 있습니다. Tailscale 같은 사설 네트워크를 통해서만 사용하십시오."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle som kan nå denne adressen, kan bruke agenten din. Bruk den bare over et privat nettverk som Tailscale."

    "Recurring: “30m”, “every hour”, “every day at 9am”, “weekdays at 9am”, or a cron expression. Once: “in 30m” or an ISO time. Bare “30m” repeats; “in 30m” runs once." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gentagende: “30m”, “every hour”, “every day at 9am”, “weekdays at 9am” eller et cron-udtryk. Én gang: “in 30m” eller et ISO-tidspunkt. “30m” alene gentages; “in 30m” kører én gang."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wiederkehrend: „30m“, „every hour“, „every day at 9am“, „weekdays at 9am“ oder ein Cron-Ausdruck. Einmalig: „in 30m“ oder eine ISO-Zeit. Ein bloßes „30m“ wiederholt sich; „in 30m“ läuft einmal."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recurrente: “30m”, “every hour”, “every day at 9am”, “weekdays at 9am” o una expresión cron. Una vez: “in 30m” o una hora ISO. “30m” a secas se repite; “in 30m” se ejecuta una vez."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Récurrent : « 30m », « every hour », « every day at 9am », « weekdays at 9am », ou une expression cron. Une fois : « in 30m » ou une heure ISO. « 30m » seul se répète ; « in 30m » s’exécute une fois."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ricorrente: “30m”, “every hour”, “every day at 9am”, “weekdays at 9am” o un'espressione cron. Una volta: “in 30m” o un orario ISO. “30m” da solo si ripete; “in 30m” viene eseguito una volta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "繰り返し：「30m」「every hour」「every day at 9am」「weekdays at 9am」、またはcron式。1回のみ：「in 30m」またはISO形式の時刻。「30m」だけなら繰り返し、「in 30m」なら1回だけ実行します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "반복: “30m”, “every hour”, “every day at 9am”, “weekdays at 9am” 또는 cron 표현식. 한 번: “in 30m” 또는 ISO 시간. “30m”만 쓰면 반복되고, “in 30m”은 한 번 실행됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gjentakende: «30m», «every hour», «every day at 9am», «weekdays at 9am» eller et cron-uttrykk. Én gang: «in 30m» eller et ISO-tidspunkt. «30m» alene gjentas; «in 30m» kjøres én gang."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Herhalend: ‘30m’, ‘every hour’, ‘every day at 9am’, ‘weekdays at 9am’ of een cron-expressie. Eenmalig: ‘in 30m’ of een ISO-tijd. Alleen ‘30m’ herhaalt; ‘in 30m’ draait één keer."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cyklicznie: „30m”, „every hour”, „every day at 9am”, „weekdays at 9am” lub wyrażenie cron. Jednorazowo: „in 30m” lub czas ISO. Samo „30m” się powtarza; „in 30m” uruchamia się raz."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recorrente: “30m”, “every hour”, “every day at 9am”, “weekdays at 9am” ou uma expressão cron. Uma vez: “in 30m” ou um horário ISO. Só “30m” repete; “in 30m” executa uma vez."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Повторяющееся: «30m», «every hour», «every day at 9am», «weekdays at 9am» или выражение cron. Однократное: «in 30m» или время в формате ISO. Просто «30m» повторяется; «in 30m» выполняется один раз."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Återkommande: ”30m”, ”every hour”, ”every day at 9am”, ”weekdays at 9am” eller ett cron-uttryck. En gång: ”in 30m” eller en ISO-tid. Enbart ”30m” upprepas; ”in 30m” körs en gång."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yinelenen: “30m”, “every hour”, “every day at 9am”, “weekdays at 9am” ya da bir cron ifadesi. Bir kez: “in 30m” ya da bir ISO saati. Yalın “30m” yinelenir; “in 30m” bir kez çalışır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Повторювані: «30m», «every hour», «every day at 9am», «weekdays at 9am» або вираз cron. Одноразові: «in 30m» або час ISO. Просто «30m» повторюється; «in 30m» виконується один раз."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "重复：“30m”、“every hour”、“every day at 9am”、“weekdays at 9am”或cron表达式。一次：“in 30m”或ISO时间。单独的“30m”会重复；“in 30m”只运行一次。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "重複：「30m」、「every hour」、「every day at 9am」、「weekdays at 9am」或 cron 運算式。一次：「in 30m」或 ISO 時間。單獨的「30m」會重複；「in 30m」只執行一次。"
          }
        }
      }
    },

    "Hermes couldn't be reached for half an hour; the reply will be there when it can." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes kunne ikke nås i en halv time; svaret kommer, når det kan."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes war eine halbe Stunde nicht erreichbar; die Antwort kommt, sobald es geht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo contactar con Hermes durante media hora; la respuesta estará ahí cuando sea posible."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes est resté injoignable pendant une demi-heure ; la réponse arrivera dès que possible."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes non è stato raggiungibile per mezz'ora; la risposta arriverà appena possibile."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "30分間Hermesに接続できませんでした。接続でき次第、返答が届きます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "30분 동안 Hermes에 연결할 수 없었습니다. 연결되면 응답이 도착합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes kunne ikke nås på en halvtime; svaret kommer når det er mulig."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes was een halfuur niet bereikbaar; het antwoord komt zodra het kan."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes był nieosiągalny przez pół godziny; odpowiedź pojawi się, gdy będzie to możliwe."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível acessar o Hermes por meia hora; a resposta vai estar lá quando for possível."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes был недоступен полчаса; ответ появится, когда связь восстановится."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes gick inte att nå på en halvtimme; svaret kommer när det går."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes'e yarım saat boyunca ulaşılamadı; ulaşılabildiğinde yanıt orada olacak."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes був недоступний пів години; відповідь з’явиться, щойно це стане можливим."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已有半小时无法连接Hermes；能连接时，回复就会出现。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已有半小時無法連線到 Hermes；等它可以連線時，回覆就會出現。"
          }
        }
      }
    },
    "Hermes couldn't download the plugin in time. It fetches it from GitHub, which can be slow the first time: try again." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes kunne ikke hente plugin i tide. Den henter det fra GitHub, hvilket kan være langsomt første gang: prøv igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes konnte das Plugin nicht rechtzeitig laden. Es ruft es von GitHub ab, was beim ersten Mal langsam sein kann: Versuch es erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes no pudo descargar el plugin a tiempo. Lo descarga de GitHub, que puede ir lento la primera vez: vuelve a intentarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes n’a pas pu télécharger le plugin à temps. Il le récupère sur GitHub, ce qui peut être lent la première fois : réessayez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes non è riuscito a scaricare il plugin in tempo. Lo scarica da GitHub, che la prima volta può essere lento: riprova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermesが時間内にプラグインをダウンロードできませんでした。GitHubから取得するため、初回は時間がかかることがあります。もう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes가 시간 내에 플러그인을 다운로드하지 못했습니다. GitHub에서 가져오므로 처음에는 느릴 수 있습니다. 다시 시도하십시오."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes kunne ikke laste ned tillegget i tide. Det hentes fra GitHub, noe som kan gå tregt første gang: prøv igjen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes kon de plug-in niet op tijd downloaden. Het haalt hem op van GitHub, wat de eerste keer traag kan zijn: probeer het opnieuw."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes nie zdążył pobrać wtyczki. Pobiera ją z GitHuba, co za pierwszym razem może trwać długo: spróbuj ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Hermes não conseguiu baixar o plugin a tempo. Ele busca no GitHub, o que pode ser lento na primeira vez: tente de novo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes не успел загрузить плагин. Он загружает его с GitHub, а в первый раз это может быть медленно: повторите попытку."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes kunde inte hämta tillägget i tid. Det hämtas från GitHub, vilket kan gå långsamt första gången: försök igen."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes eklentiyi zamanında indiremedi. Onu GitHub'dan alır, bu da ilk seferde yavaş olabilir: yeniden deneyin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes не встиг викачати плагін. Він отримує його з GitHub, що вперше може бути повільно: спробуйте ще."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes未能及时下载插件。它从GitHub获取，首次可能较慢：请重试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes 無法及時下載外掛。它會從 GitHub 取得，第一次可能較慢：請再試一次。"
          }
        }
      }
    },
    "Hermes couldn't give it %@, so it has your agent's model for now." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes kunne ikke give den %@, så den har din agents model indtil videre."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes konnte ihm %@ nicht geben, daher hat er vorerst das Modell deines Agenten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes no pudo asignarle %@, así que por ahora tiene el modelo de tu agente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes n’a pas pu lui attribuer %@ : il utilise le modèle de votre agent pour l’instant."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes non ha potuto assegnargli %@, quindi per ora ha il modello del tuo agente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermesが%@を設定できなかったため、現在はエージェントのモデルを使用しています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes가 %@을(를) 지정할 수 없어 지금은 에이전트의 모델을 사용합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes kunne ikke gi den %@, så den har agentens modell inntil videre."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes kon het %@ niet geven, dus voorlopig heeft het het model van je agent."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes nie mógł mu przypisać: %@, więc na razie ma model Twojego agenta."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Hermes não conseguiu atribuir %@ a ele, então por enquanto ele usa o modelo do seu agente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes не смог назначить ему %@, поэтому пока у него модель вашего агента."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes kunde inte ge den %@, så den har din agents modell tills vidare."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes ona %@ veremedi, bu yüzden şimdilik ajanınızın modelini kullanıyor."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes не зміг призначити йому %@, тому поки що він має модель вашого агента."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes无法为它设定%@，因此它暂时使用你的智能体的模型。"
          }

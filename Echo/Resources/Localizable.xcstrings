    "Not met yet: the first connection shows its key's fingerprint and asks." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ikke mødt endnu: den første forbindelse viser nøglens fingeraftryk og spørger."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noch unbekannt: Die erste Verbindung zeigt den Fingerabdruck des Schlüssels und fragt nach."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aún no lo conoce: la primera conexión muestra la huella de su clave y pregunta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pas encore connu : la première connexion affiche l’empreinte de sa clé et vous demande."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mai incontrato: alla prima connessione viene mostrata l'impronta della sua chiave e ti viene chiesto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "未接続：最初の接続時にキーのフィンガープリントが表示され、確認を求められます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "아직 연결한 적 없음: 처음 연결할 때 키의 지문을 표시하고 확인을 요청합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ikke møtt ennå: den første tilkoblingen viser fingeravtrykket til nøkkelen og spør."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nog onbekend: de eerste verbinding toont de vingerafdruk van de sleutel en vraagt het je."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeszcze nieznany: pierwsze połączenie pokaże odcisk klucza i zapyta."

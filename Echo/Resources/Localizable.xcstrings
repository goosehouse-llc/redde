        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모든 플랫폼의 대화가 여기에 표시됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Samtaler fra alle plattformer vises her."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gesprekken van elk platform verschijnen hier."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu pojawiają się rozmowy ze wszystkich platform."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conversas de todas as plataformas aparecem aqui."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Здесь появляются разговоры со всех платформ."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Konversationer från alla plattformar visas här."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tüm platformlardaki konuşmalar burada görünür."

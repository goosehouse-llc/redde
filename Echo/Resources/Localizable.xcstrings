    "Said again when new sleep or a workout is saved, and when you open Redde. Turn this off and it's taken out of the jobs." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sendes igen, når ny søvn eller en træning gemmes, og når du åbner Redde. Slå det fra, så tages det ud af jobbene."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wird erneut übermittelt, wenn neuer Schlaf oder ein Training gesichert wird und wenn du Redde öffnest. Schalte es aus, und es wird aus den Jobs entfernt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se vuelve a enviar cuando se guarda un nuevo sueño o entrenamiento, y cuando abres Redde. Desactívalo y se quita de las tareas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Renvoyé quand un nouveau sommeil ou un entraînement est enregistré, et quand vous ouvrez Redde. Désactivez-le et il est retiré des tâches."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viene inviato di nuovo quando si salva un nuovo sonno o allenamento e quando apri Redde. Disattivalo e viene tolto dai job."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新しい睡眠やワークアウトが保存されたときと、Reddeを開いたときに改めて送られます。オフにすると、ジョブから外されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "새 수면이나 운동이 저장될 때와 Redde를 열 때 다시 전송됩니다. 끄면 작업에서 제외됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sendes på nytt når ny søvn eller en treningsøkt lagres, og når du åpner Redde. Slå det av, så tas det ut av jobbene."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opnieuw gestuurd als er nieuwe slaap of een training wordt bewaard, en als je Redde opent. Zet dit uit en het wordt uit de taken gehaald."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wysyłane ponownie, gdy zostanie zapisany nowy sen lub trening, i gdy otwierasz Redde. Wyłącz to, a zostanie usunięte z zadań."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enviado de novo quando um novo sono ou treino é salvo e quando você abre o Redde. Desative e ele sai das tarefas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отправляется снова, когда сохраняется новый сон или тренировка, и когда вы открываете Redde. Выключите, и это уберется из заданий."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skickas igen när ny sömn eller ett träningspass sparas och när du öppnar Redde. Stäng av det så tas det bort från jobben."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yeni uyku ya da antrenman kaydedildiğinde ve Redde'yi açtığınızda yeniden gönderilir. Kapatırsanız görevlerden çıkarılır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Надсилається знову, коли зберігається новий сон чи тренування, і коли ви відкриваєте Redde. Вимкніть, і це буде прибрано із завдань."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保存新的睡眠或体能训练时，以及你打开Redde时，会重新发送。关闭后，它会从任务中移除。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "儲存新的睡眠或體能訓練時，以及你打開 Redde 時，會重新傳送。關閉後，它會從工作中移除。"
          }
        }
      }
    },

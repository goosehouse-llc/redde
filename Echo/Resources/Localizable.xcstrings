    "%@ Without asking, Hermes runs every command it wants to in this conversation, until you switch it back or Hermes restarts." : {
      "comment" : "Footer: %@ is the sentence explaining fast mode",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Uden at spørge kører Hermes alle de kommandoer, den vil, i denne samtale, indtil du slår det fra igen, eller Hermes genstarter."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Ohne Nachfrage führt Hermes in dieser Konversation jeden gewünschten Befehl aus, bis du es zurückstellst oder Hermes neu startet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Sin preguntar, Hermes ejecuta todos los comandos que quiera en esta conversación, hasta que lo vuelvas a desactivar o Hermes se reinicie."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Sans demander, Hermes exécute toutes les commandes qu’il veut dans cette conversation, jusqu’à ce que vous désactiviez l’option ou qu’Hermes redémarre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Senza chiedere, Hermes esegue ogni comando che vuole in questa conversazione, finché non la ripristini o Hermes si riavvia."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@元に戻すかHermesが再起動するまで、この会話ではHermesが確認なしで実行したいコマンドをすべて実行します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 다시 끄거나 Hermes가 재시작될 때까지 Hermes는 이 대화에서 묻지 않고 원하는 모든 명령을 실행합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Uten å spørre kjører Hermes alle kommandoer den vil i denne samtalen, til du slår det av igjen eller Hermes starter på nytt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Zonder te vragen voert Hermes in dit gesprek elk commando uit dat het wil, tot je het terugzet of Hermes herstart."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Bez pytania Hermes uruchamia w tej rozmowie każde polecenie, które zechce, dopóki tego nie wyłączysz lub Hermes nie zostanie uruchomiony ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Sem perguntar, o Hermes executa todos os comandos que quiser nesta conversa, até você desativar isso ou o Hermes reiniciar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ В этом разговоре Hermes выполняет любые команды без запроса, пока вы не выключите это или Hermes не перезапустится."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Utan att fråga kör Hermes varje kommando den vill i den här konversationen, tills du stänger av det igen eller Hermes startar om."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Siz bunu geri alana ya da Hermes yeniden başlayana kadar Hermes bu konuşmada istediği her komutu sormadan çalıştırır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Без запиту Hermes виконує в цій розмові будь-які команди, доки ви не вимкнете це або Hermes не перезапуститься."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@在此对话中，Hermes会不经询问运行它想运行的所有命令，直到你将其关闭或Hermes重新启动。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@不詢問的情況下，Hermes 會在此對話中執行它想執行的所有指令，直到你切換回來或 Hermes 重新啟動。"
          }
        }
      }
    },

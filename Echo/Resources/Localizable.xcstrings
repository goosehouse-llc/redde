    "Bots need the Hermes Dashboard, or a bot added for the Hermes API, with Bots on in Redde's Settings." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bots kræver Hermes Dashboard eller en bot, der er tilføjet til Hermes API, med Bots slået til i Reddes Indstillinger."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bots brauchen das Hermes Dashboard oder einen für die Hermes API hinzugefügten Bot, und „Bots“ muss in den Einstellungen von Redde aktiviert sein."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los bots necesitan el Hermes Dashboard, o un bot añadido para la Hermes API, con Bots activado en los Ajustes de Redde."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les bots requièrent le Hermes Dashboard, ou un bot ajouté pour Hermes API, avec Bots activé dans les Réglages de Redde."

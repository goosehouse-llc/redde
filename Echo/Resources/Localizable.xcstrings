    "Servers that have the old key won't let this iPhone in until they have the new one." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Servere, der har den gamle nøgle, lukker ikke denne iPhone ind, før de har den nye."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Server mit dem alten Schlüssel lassen dieses iPhone erst wieder zu, wenn sie den neuen haben."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los servidores que tienen la clave antigua no dejarán entrar a este iPhone hasta que tengan la nueva."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les serveurs qui ont l’ancienne clé refuseront cet iPhone tant qu’ils n’auront pas la nouvelle."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I server che hanno la vecchia chiave non faranno entrare questo iPhone finché non avranno quella nuova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "古いキーを持つサーバは、新しいキーが登録されるまでこのiPhoneの接続を許可しません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이전 키가 있는 서버는 새로운 키를 받기 전까지 이 iPhone의 접속을 허용하지 않습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tjenere som har den gamle nøkkelen, slipper ikke inn denne iPhonen før de har den nye."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Servers met de oude sleutel laten deze iPhone pas toe als ze de nieuwe hebben."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Serwery ze starym kluczem nie wpuszczą tego iPhone'a, dopóki nie dostaną nowego."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os servidores que têm a chave antiga não deixam este iPhone entrar até terem a nova."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Серверы со старым ключом не пустят этот iPhone, пока не получат новый."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Servrar som har den gamla nyckeln släpper inte in den här iPhonen förrän de har den nya."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eski anahtara sahip sunucular, yenisi kendilerine eklenene kadar bu iPhone'u içeri almaz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сервери зі старим ключем не пускатимуть цей iPhone, доки не отримають новий."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "持有旧密钥的服务器在拿到新密钥之前，不会允许此iPhone登录。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "擁有舊金鑰的伺服器在取得新金鑰前，不會讓這部 iPhone 連線。"
          }
        }
      }
    },

    "The server and agent profile Redde talks to. Chats, skills, tools, cron jobs and memory all follow them." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den server og agentprofil, Redde taler med. Chats, færdigheder, værktøjer, cron-job og hukommelse følger dem alle."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Server und das Agentenprofil, mit denen Redde spricht. Chats, Skills, Tools, Cron-Jobs und Gedächtnis folgen ihnen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El servidor y el perfil de agente con los que habla Redde. Chats, habilidades, herramientas, tareas cron y memoria dependen de ellos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le serveur et le profil d’agent auxquels Redde parle. Discussions, compétences, outils, tâches cron et mémoire en dépendent."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il server e il profilo dell'agente con cui parla Redde. Chat, skill, strumenti, cron job e memoria li seguono."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reddeが通信するサーバとエージェントプロファイル。チャット、スキル、ツール、cronジョブ、メモリはすべてこれに従います。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Redde가 대화하는 서버 및 에이전트 프로필입니다. 채팅, 스킬, 도구, cron 작업 및 메모리 모두 이를 따릅니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tjeneren og agentprofilen Redde snakker med. Chatter, ferdigheter, verktøy, cron-jobber og minne følger dem."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De server en het agentprofiel waarmee Redde praat. Chats, skills, tools, cronjobs en geheugen volgen ze allemaal."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Serwer i profil agenta, z którymi rozmawia Redde. Czaty, umiejętności, narzędzia, zadania cron i pamięć idą za nimi."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O servidor e o perfil de agente com que o Redde fala. Conversas, habilidades, ferramentas, tarefas cron e memória seguem ambos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сервер и профиль агента, с которыми общается Redde. От них зависят чаты, навыки, инструменты, задания cron и память."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Servern och agentprofilen som Redde pratar med. Chattar, färdigheter, verktyg, cron-jobb och minne följer dem alla."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Redde'nin konuştuğu sunucu ve ajan profili. Sohbetler, beceriler, araçlar, cron görevleri ve bellek hep bunlara bağlıdır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сервер і профіль агента, з якими говорить Redde. Чати, навички, інструменти, завдання cron і пам’ять залежать від них."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Redde对话的服务器和智能体配置文件。聊天、技能、工具、Cron任务和记忆都随之切换。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Redde 交談的伺服器和代理設定檔。聊天、技能、工具、cron 工作和記憶都會跟著它們。"
          }
        }
      }

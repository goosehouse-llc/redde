            "value" : "Щоб прослухати голос, потрібен ваш ключ %@ у Параметри → Голос → Голосовий режим."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "试听声音需要你的%@密钥，请在设置 → 语音 → 语音模式中添加。"
          }
        },
        "zh-Hant" : {

        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "透過 App Store 一次性給小費。不會解鎖任何東西：所有功能都已歸你所有。"
          }
        }
      }
    },
    "A path on the Hermes host. ~ is its user's home." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En sti på Hermes-værten. ~ er dens brugers hjemmemappe."

          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чтобы прослушать голос, нужен ваш ключ %@: «Настройки» → «Голос» → «Голосовой режим»."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "För att lyssna på en röst krävs din %@-nyckel, i Inställningar → Röst → Röstläge."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",

    "Standing facts about your setup: machines, services, names, conventions." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faste fakta om din opsætning: maskiner, tjenester, navne, konventioner."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Feste Fakten zu deinem Setup: Rechner, Dienste, Namen, Konventionen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Datos fijos sobre tu entorno: máquinas, servicios, nombres, convenciones."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faits permanents sur votre installation : machines, services, noms, conventions."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fatti stabili sulla tua configurazione: macchine, servizi, nomi, convenzioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "環境に関する不変の情報：マシン、サービス、名前、規約。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "설정에 대한 변하지 않는 사실: 컴퓨터, 서비스, 이름, 규칙."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faste fakta om oppsettet ditt: maskiner, tjenester, navn, konvensjoner."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaste feiten over je opstelling: machines, diensten, namen, afspraken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stałe fakty o Twojej konfiguracji: komputery, usługi, nazwy, konwencje."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",

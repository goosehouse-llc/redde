    "And deletes what's in %@ but not in the copy" : {
      "comment" : "Approval card: rsync --delete",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Og sletter det i %@, som ikke er i kopien"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Und löscht, was in %@, aber nicht in der Kopie ist"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Y elimina lo que hay en %@ pero no en la copia"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Et supprime ce qui est dans %@ mais pas dans la copie"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "E elimina ciò che è in %@ ma non nella copia"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "さらに、%@にあってコピー元にないものを削除します"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "그리고 %@에는 있지만 복사본에 없는 항목 삭제"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Og sletter det i %@ som ikke er i kopien"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En verwijdert wat in %@ staat maar niet in de kopie"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I usuwa z %@ to, czego nie ma w kopii"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "E apaga o que está em %@ mas não na cópia"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "И удаляет то, что есть в %@, но нет в копии"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Och raderar det som finns i %@ men inte i kopian"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ayrıca %@ içinde olup kopyada olmayanlar silinir"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",

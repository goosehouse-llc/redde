            "value" : "Os bots precisam do Hermes Dashboard, ou de um bot adicionado para a Hermes API, com Bots ativado nos Ajustes do Redde."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для ботов нужен Hermes Dashboard или бот, добавленный для Hermes API, и включенный параметр «Боты» в настройках Redde."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bottar kräver Hermes Dashboard, eller en bot som lagts till för Hermes API, med Bottar på i Reddes Inställningar."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Botlar için Hermes Dashboard ya da Hermes API için eklenmiş bir bot ve Redde'nin Ayarlar'ında Botlar'ın açık olması gerekir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для ботів потрібен Hermes Dashboard або бот, доданий для Hermes API, і ввімкнений параметр «Боти» в Параметрах Redde."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {

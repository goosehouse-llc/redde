    "Nothing from Health yet: no sleep, steps or workouts saved today and yesterday, or Redde wasn't allowed to read them (Settings › Health › Data Access & Devices › Redde)." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Intet fra Sundhed endnu: ingen søvn, skridt eller træninger gemt i dag og i går, eller Redde fik ikke lov til at læse dem (Indstillinger › Sundhed › Dataadgang og enheder › Redde)."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noch nichts aus Health: Heute und gestern wurden kein Schlaf, keine Schritte und keine Trainings gesichert, oder Redde durfte sie nicht lesen (Einstellungen › Health › Datenzugriff & Geräte › Redde)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aún no hay nada de Salud: no hay sueño, pasos ni entrenamientos guardados hoy y ayer, o Redde no tenía permiso para leerlos (Ajustes › Salud › Acceso a datos y dispositivos › Redde)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rien de Santé pour l’instant : aucun sommeil, aucun pas ni aucun entraînement enregistré aujourd’hui et hier, ou Redde n’a pas été autorisé à les lire (Réglages › Santé › Accès aux données et appareils › Redde)."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ancora niente da Salute: nessun dato su sonno, passi o allenamenti salvato oggi e ieri, oppure Redde non era autorizzata a leggerli (Impostazioni › Salute › Accesso ai dati e dispositivi › Redde)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ヘルスケアからのデータはまだありません。今日と昨日の睡眠、歩数、ワークアウトが保存されていないか、Reddeに読み取りが許可されていません（設定 › ヘルスケア › データアクセスとデバイス › Redde）。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "아직 건강 데이터가 없습니다. 오늘과 어제 저장된 수면, 걸음 수, 운동이 없거나 Redde에 읽기가 허용되지 않았습니다(설정 › 건강 › 데이터 접근 및 기기 › Redde)."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingenting fra Helse ennå: ingen søvn, skritt eller treningsøkter lagret i dag og i går, eller Redde fikk ikke lov til å lese dem (Innstillinger › Helse › Datatilgang og enheter › Redde)."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nog niets uit Gezondheid: vandaag en gisteren zijn geen slaap, stappen of trainingen bewaard, of Redde mocht ze niet lezen (Instellingen › Gezondheid › Gegevenstoegang en apparaten › Redde)."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na razie nic ze Zdrowia: dziś i wczoraj nie zapisano snu, kroków ani treningów albo Redde nie ma pozwolenia na ich odczyt (Ustawienia › Zdrowie › Dostęp do danych i urządzenia › Redde)."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nada do app Saúde ainda: nenhum sono, passo ou treino salvo hoje e ontem, ou o Redde não teve permissão para lê-los (Ajustes › Saúde › Acesso a Dados e Dispositivos › Redde)."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Из «Здоровья» пока ничего: сегодня и вчера не сохранено ни сна, ни шагов, ни тренировок, или Redde не разрешено их читать («Настройки» › «Здоровье» › «Доступ к данным и устройства» › Redde)."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inget från Hälsa än: ingen sömn, inga steg eller träningspass sparade i dag och i går, eller så fick Redde inte läsa dem (Inställningar › Hälsa › Dataåtkomst och enheter › Redde)."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sağlık'tan henüz bir şey yok: bugün ve dün kaydedilmiş uyku, adım ya da antrenman yok veya Redde'nin bunları okumasına izin verilmedi (Ayarlar › Sağlık › Veri Erişimi ve Aygıtlar › Redde)."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Зі «Здоров’я» поки нічого: сьогодні й учора не збережено ні сну, ні кроків, ні тренувань, або Redde не дозволено їх читати (Параметри › Здоров’я › Доступ до даних і пристрої › Redde)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“健康”中还没有数据：今天和昨天没有保存睡眠、步数或体能训练，或者Redde未获准读取它们（设置 › 健康 › 数据访问与设备 › Redde）。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「健康」中還沒有資料：今天和昨天沒有儲存睡眠、步數或體能訓練，或 Redde 未獲准讀取（「設定」›「健康」›「資料取用與裝置」›「Redde」）。"
          }
        }
      }
    },

    "Find and install Hermes plugins from Nous Research's catalog, and switch them on and off." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Find og installer Hermes-plugins fra Nous Researchs katalog, og slå dem til og fra."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hermes-Plugins aus dem Katalog von Nous Research finden, installieren und ein- und ausschalten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Busca e instala plugins de Hermes del catálogo de Nous Research, y actívalos o desactívalos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trouvez et installez des plugins Hermes depuis le catalogue de Nous Research, et activez-les ou désactivez-les."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trova e installa plugin Hermes dal catalogo di Nous Research, e attivali o disattivali."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nous ResearchのカタログからHermesプラグインを探してインストールし、オン/オフを切り替えます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nous Research 카탈로그에서 Hermes 플러그인을 찾아 설치하고 켜거나 끕니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finn og installer Hermes-tillegg fra katalogen til Nous Research, og slå dem av og på."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zoek en installeer Hermes-plug-ins uit de catalogus van Nous Research, en zet ze aan en uit."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Znajduj i instaluj wtyczki Hermesa z katalogu Nous Research oraz włączaj je i wyłączaj."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Encontre e instale plugins do Hermes do catálogo da Nous Research, e ative ou desative."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Находите и устанавливайте плагины Hermes из каталога Nous Research, включайте и выключайте их."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hitta och installera Hermes-tillägg från Nous Researchs katalog, och slå på och av dem."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nous Research kataloğundan Hermes eklentileri bulun, yükleyin ve açıp kapatın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Шукайте й інсталюйте плагіни Hermes з каталогу Nous Research та вмикайте й вимикайте їх."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "从Nous Research的目录中查找并安装Hermes插件，并打开或关闭它们。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "從 Nous Research 的目錄尋找並安裝 Hermes 外掛，並可開啟或關閉。"
          }
        }
      }
    },

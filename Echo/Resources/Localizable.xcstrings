    "Reads and changes code, runs it, and says what it did." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Læser og ændrer kode, kører den og fortæller, hvad den gjorde."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liest und ändert Code, führt ihn aus und sagt, was er getan hat."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lee y cambia código, lo ejecuta y cuenta lo que hizo."
          }

    "No alerts while Getting There is set to Don't Work It Out." : {
      "comment" : "Settings → Leave-By Alerts, with the way of getting about set to none",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingen alarmer, så længe Vejen derhen står på Beregn ikke."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keine Hinweise, solange Anfahrt auf „Nicht berechnen“ steht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No hay avisos mientras Cómo llegar esté en «No calcularlo»."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucune alerte tant que Trajet est réglé sur « Ne pas calculer »."

    "Under its name in your chat list, and how the other bots know what to ask it." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Under dens navn på din chatliste, og sådan ved de andre bots, hvad de kan spørge den om."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unter seinem Namen in deiner Chatliste, und woran die anderen Bots erkennen, was sie ihn fragen können."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bajo su nombre en tu lista de chats, y así saben los demás bots qué preguntarle."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sous son nom dans votre liste des discussions, et ce qui indique aux autres bots quoi lui demander."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sotto il suo nome nell'elenco chat; è anche così che gli altri bot sanno cosa chiedergli."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "チャットリストで名前の下に表示され、ほかのボットが何を頼めるかを知る手がかりになります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "채팅 목록에서 이름 아래에 표시되며, 다른 봇이 무엇을 물어볼지 알 수 있게 해 줍니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Under navnet i chattelisten, og slik vet de andre botene hva de kan spørre den om."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Onder de naam in je chatlijst, en hoe de andere bots weten wat ze het kunnen vragen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pod jego nazwą na liście czatów; dzięki temu inne boty wiedzą, o co go pytać."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sob o nome dele na sua lista de conversas, e como os outros bots sabem o que perguntar a ele."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Под его именем в списке чатов; по этому описанию другие боты знают, о чем его спрашивать."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Under dess namn i din chattlista, och så vet de andra bottarna vad de ska fråga den om."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sohbet listenizde adının altında görünür; diğer botlar da ona ne soracaklarını buradan bilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Під його іменем у списку чатів; так інші боти знають, про що його питати."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "显示在聊天列表中它的名称下方，也让其他机器人知道该问它什么。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "顯示在聊天列表中它的名稱下方，其他機器人也據此知道該問它什麼。"
          }
        }
      }
    },

    "%@ is behind an access gate (HTTP %lld). Add what it asks for under Settings → Connection details: a Cloudflare Access service token, a Pangolin access token, or the proxy's own headers." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ er bag en adgangsport (HTTP %lld). Tilføj det, den beder om, under Indstillinger → Forbindelsesdetaljer: et Cloudflare Access-servicetoken, et Pangolin-adgangstoken eller proxyens egne headere."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ liegt hinter einer Zugangssperre (HTTP %lld). Füge unter Einstellungen → Verbindungsdetails hinzu, was sie verlangt: ein Cloudflare-Access-Diensttoken, ein Pangolin-Zugriffstoken oder die eigenen Header des Proxys."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ está detrás de una puerta de acceso (HTTP %lld). Añade lo que pide en Ajustes → Datos de conexión: un token de servicio de Cloudflare Access, un token de acceso de Pangolin o los encabezados propios del proxy."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ est derrière un contrôle d’accès (HTTP %lld). Ajoutez ce qu’il demande dans Réglages → Détails de connexion : un jeton de service Cloudflare Access, un jeton d’accès Pangolin, ou les en-têtes propres au proxy."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ è dietro un controllo di accesso (HTTP %lld). Aggiungi ciò che richiede in Impostazioni → Dettagli connessione: un token di servizio Cloudflare Access, un token di accesso Pangolin o le intestazioni del proxy."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@はアクセスゲートの背後にあります（HTTP %lld）。設定 → 接続の詳細で、求められているもの（Cloudflare Accessのサービストークン、Pangolinのアクセストークン、またはプロキシ独自のヘッダ）を追加してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@이(가) 접근 게이트 뒤에 있습니다(HTTP %lld). 설정 → 연결 세부사항에서 요구하는 항목을 추가하십시오: Cloudflare Access 서비스 토큰, Pangolin 접근 토큰 또는 프록시 자체 헤더."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ er bak en tilgangssperre (HTTP %lld). Legg til det den ber om under Innstillinger → Tilkoblingsdetaljer: et tjenestetoken for Cloudflare Access, et Pangolin-tilgangstoken eller proxyens egne headere."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ zit achter een toegangspoort (HTTP %lld). Voeg toe waar die om vraagt onder Instellingen → Verbindingsgegevens: een Cloudflare Access-servicetoken, een Pangolin-toegangstoken of de eigen headers van de proxy."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ jest za bramką dostępu (HTTP %lld). Dodaj to, czego wymaga, w Ustawienia → Szczegóły połączenia: token usługi Cloudflare Access, token dostępu Pangolin lub własne nagłówki proxy."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ está atrás de um portal de acesso (HTTP %lld). Adicione o que ele pede em Ajustes → Detalhes da conexão: um token de serviço do Cloudflare Access, um token de acesso do Pangolin ou os cabeçalhos do próprio proxy."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ находится за защитой доступа (HTTP %lld). Добавьте то, что она требует, в «Настройки» → «Сведения о подключении»: сервисный токен Cloudflare Access, токен доступа Pangolin или собственные заголовки прокси."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ligger bakom en åtkomstspärr (HTTP %lld). Lägg till det den kräver under Inställningar → Anslutningsuppgifter: en tjänsttoken för Cloudflare Access, en åtkomsttoken för Pangolin eller proxyns egna headers."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ bir erişim kapısının arkasında (HTTP %lld). İstediğini Ayarlar → Bağlantı ayrıntıları bölümünde ekleyin: bir Cloudflare Access hizmet token'ı, bir Pangolin erişim token'ı ya da proxy'nin kendi üst bilgileri."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ за захистом доступу (HTTP %lld). Додайте потрібне в Параметри → Відомості про з’єднання: сервісний токен Cloudflare Access, токен доступу Pangolin або власні заголовки проксі."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@位于访问控制之后（HTTP %lld）。请在设置 → 连接详细信息中添加它要求的内容：Cloudflare Access服务令牌、Pangolin访问令牌，或代理自己的标头。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 位於存取閘門後方（HTTP %lld）。請在「設定」→「連線詳細資訊」中加入它要求的項目：Cloudflare Access 服務權杖、Pangolin 存取權杖，或代理伺服器自己的標頭。"
          }

          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La sua cartella e le sue conversazioni restano sul server. Le conversazioni semplicemente non sono più raggruppate al suo interno."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "フォルダと会話はサーバに残ります。会話がこのプロジェクトの下にまとめられなくなるだけです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "폴더와 대화는 서버에 남아 있습니다. 대화가 더 이상 프로젝트 아래에 묶이지 않을 뿐입니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mappen og samtalene blir værende på tjeneren. Samtalene er bare ikke lenger gruppert under det."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De map en de gesprekken blijven op de server. De gesprekken worden alleen niet meer eronder gegroepeerd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jego folder i rozmowy zostają na serwerze. Rozmowy po prostu nie będą już w nim zgrupowane."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A pasta e as conversas dele continuam no servidor. As conversas só não ficam mais agrupadas nele."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Его папка и разговоры остаются на сервере. Просто разговоры больше не группируются под ним."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dess mapp och dess konversationer finns kvar på servern. Konversationerna grupperas bara inte under det längre."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klasörü ve konuşmaları sunucuda kalır. Yalnızca konuşmalar artık onun altında gruplanmaz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Його папка й розмови залишаються на сервері. Розмови просто більше не групуються в ньому."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "它的文件夹和对话仍保留在服务器上。只是这些对话不再归在它下面。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "它的檔案夾和對話會留在伺服器上。只是對話不再歸類在它之下。"
          }
        }
      }
    },

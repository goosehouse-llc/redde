    "Add it as one line to ~/.ssh/authorized_keys for %@ on %@. The key was made on this iPhone and never leaves it." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Føj den som én linje til ~/.ssh/authorized_keys for %1$@ på %2$@. Nøglen blev lavet på denne iPhone og forlader den aldrig."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Füge ihn als eine Zeile zu ~/.ssh/authorized_keys für %1$@ auf %2$@ hinzu. Der Schlüssel wurde auf diesem iPhone erstellt und verlässt es nie."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Add it as one line to ~/.ssh/authorized_keys for %1$@ on %2$@. The key was made on this iPhone and never leaves it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añádela como una línea a ~/.ssh/authorized_keys de %1$@ en %2$@. La clave se creó en este iPhone y nunca sale de él."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoutez-la sur une ligne dans ~/.ssh/authorized_keys pour %1$@ sur %2$@. La clé a été créée sur cet iPhone et ne le quitte jamais."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiungila come una riga a ~/.ssh/authorized_keys per %1$@ su %2$@. La chiave è stata creata su questo iPhone e non lo lascia mai."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%2$@上の%1$@の~/.ssh/authorized_keysに1行で追加してください。キーはこのiPhoneで作成され、外部に出ることはありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%2$@에 있는 %1$@의 ~/.ssh/authorized_keys에 한 줄로 추가하십시오. 키는 이 iPhone에서 만들어졌으며 외부로 나가지 않습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Legg den til som én linje i ~/.ssh/authorized_keys for %1$@ på %2$@. Nøkkelen ble laget på denne iPhonen og forlater den aldri."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voeg hem als één regel toe aan ~/.ssh/authorized_keys voor %1$@ op %2$@. De sleutel is op deze iPhone gemaakt en verlaat hem nooit."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dodaj go jako jeden wiersz do ~/.ssh/authorized_keys użytkownika %1$@ na %2$@. Klucz został utworzony na tym iPhonie i nigdy go nie opuszcza."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adicione-a como uma linha a ~/.ssh/authorized_keys de %1$@ em %2$@. A chave foi criada neste iPhone e nunca sai dele."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Добавьте его одной строкой в ~/.ssh/authorized_keys пользователя %1$@ на %2$@. Ключ создан на этом iPhone и никогда его не покидает."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lägg till den som en rad i ~/.ssh/authorized_keys för %1$@ på %2$@. Nyckeln skapades på den här iPhonen och lämnar den aldrig."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bunu %2$@ üzerinde %1$@ için ~/.ssh/authorized_keys dosyasına tek satır olarak ekleyin. Anahtar bu iPhone'da oluşturuldu ve buradan hiç çıkmaz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Додайте його одним рядком до ~/.ssh/authorized_keys користувача %1$@ на %2$@. Ключ створено на цьому iPhone, і він ніколи його не покидає."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将它作为一行添加到%2$@上%1$@的~/.ssh/authorized_keys中。此密钥在此iPhone上生成，绝不会离开此iPhone。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將它作為一行加入 %2$@ 上 %1$@ 的 ~/.ssh/authorized_keys。此金鑰在這部 iPhone 上建立，絕不會離開這部 iPhone。"
          }
        }
      }
    },

            "state" : "translated",
            "value" : "打开"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "開啟"
          }
        }
      }
    },
    "Turn on %@" : {
      "comment" : "The message a home card's switch sends to the agent, e.g. Turn on Kitchen lights",
      "localizations" : {

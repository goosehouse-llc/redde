    "A one-time tip through the App Store. It doesn't unlock anything: every feature is already yours." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Engangsdrikkepenge via App Store. Det låser ikke noget op: alle funktioner er allerede dine."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein einmaliges Trinkgeld über den App Store. Es schaltet nichts frei: Alle Funktionen gehören dir bereits."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una propina única a través del App Store. No desbloquea nada: ya tienes todas las funciones."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un pourboire unique via l’App Store. Il ne débloque rien : toutes les fonctionnalités sont déjà à vous."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una mancia una tantum tramite App Store. Non sblocca niente: hai già tutte le funzioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Storeを通じた1回限りのチップです。何かのロックが解除されるわけではありません。すべての機能はすでに利用可能です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Store를 통한 일회성 팁입니다. 잠금 해제되는 기능은 없으며, 모든 기능을 이미 사용할 수 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Engangsdriks via App Store. Den låser ikke opp noe: alle funksjoner er allerede dine."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een eenmalige fooi via de App Store. Het ontgrendelt niets: elke functie is al van jou."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jednorazowy napiwek przez App Store. Niczego nie odblokowuje: wszystkie funkcje już są Twoje."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma gorjeta única pela App Store. Não desbloqueia nada: todos os recursos já são seus."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Разовые чаевые через App Store. Они ничего не разблокируют: все функции уже ваши."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En engångsdricks via App Store. Den låser inte upp något: alla funktioner är redan dina."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Store üzerinden tek seferlik bir bahşiş. Hiçbir şeyin kilidini açmaz: tüm özellikler zaten sizin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Разові чайові через App Store. Нічого не розблоковують: усі функції вже ваші."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通过App Store进行一次性打赏。它不会解锁任何内容：所有功能都已对你开放。"

            "value" : "Dette er likevel ikke tekst, så det kan ikke endres her. Last det ned for å se på det."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dit is toch geen tekst, dus het kan hier niet worden gewijzigd. Download het om het te bekijken."
          }
        },
        "pl" : {
          "stringUnit" : {

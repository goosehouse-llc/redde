    },
    "Looks after the house: lights, heating, sensors and routines." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passer på huset: lys, varme, sensorer og rutiner."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kümmert sich ums Haus: Licht, Heizung, Sensoren und Routinen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se ocupa de la casa: luces, calefacción, sensores y rutinas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "S’occupe de la maison : lumières, chauffage, capteurs et routines."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si occupa della casa: luci, riscaldamento, sensori e routine."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "家の管理：照明、暖房、センサー、ルーチン。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "조명, 난방, 센서 및 루틴 등 집을 관리합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tar seg av huset: lys, oppvarming, sensorer og rutiner."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zorgt voor het huis: lampen, verwarming, sensoren en routines."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dba o dom: światła, ogrzewanie, czujniki i automatyzacje."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuida da casa: luzes, aquecimento, sensores e rotinas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Следит за домом: свет, отопление, датчики и сценарии."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tar hand om huset: lampor, värme, sensorer och rutiner."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eve göz kulak olur: ışıklar, ısıtma, sensörler ve rutinler."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Доглядає за домом: світло, опалення, датчики й сценарії."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "照看家里：灯光、暖气、传感器和日常程序。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "照顧家裡大小事：燈光、暖氣、感應器和例行程序。"
          }
        }
      }
    },
    "Looks things up on the web and comes back with what it found, and where it found it." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slår ting op på nettet og kommer tilbage med, hvad den fandt, og hvor den fandt det."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recherchiert im Web und bringt zurück, was er gefunden hat und wo."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Busca en la web y vuelve con lo que encontró y dónde lo encontró."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fait des recherches sur le Web et revient avec ce qu’il a trouvé, et où il l’a trouvé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cerca sul web e torna con ciò che ha trovato, e dove l'ha trovato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Webで調べて、見つけた内容とその出典を報告します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "웹에서 검색하여 찾은 내용과 출처를 알려 줍니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slår opp ting på nettet og kommer tilbake med hva den fant, og hvor den fant det."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zoekt dingen op het web op en komt terug met wat het vond, en waar het dat vond."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wyszukuje informacje w sieci i wraca z tym, co znalazł, oraz gdzie to znalazł."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pesquisa na web e volta com o que encontrou, e onde encontrou."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ищет в интернете и возвращается с найденным и указанием, где это найдено."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Söker på webben och kommer tillbaka med vad den hittade, och var den hittade det."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Web'de araştırır ve bulduklarıyla, onları nerede bulduğuyla birlikte döner."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Шукає в інтернеті й повертається зі знайденим і з тим, де це знайдено."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在网上查找资料，并带回查到的内容及其出处。"
          }
        },

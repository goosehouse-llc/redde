        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Новий сервер можна заповнити з коду налаштування: відскануйте або вставте його на екрані налаштування."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {

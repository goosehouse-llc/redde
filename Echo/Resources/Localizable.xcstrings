        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slå på"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aç"
          }
        },
        "uk" : {

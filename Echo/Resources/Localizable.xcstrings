          }
        }
      }
    },
    "While Redde is open on this %@, or on your car's screen, say an agent's phrase to talk to it: “Hey %@” opens voice mode, and “Hey %@, what's on today?” asks at once." : {
      "comment" : "“Hey” is the English wake word Redde listens for: keep it in English",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mens Redde er åben på denne %@ eller på din bils skærm, kan du sige en agents vækkeord for at tale med den: “Hey %@” åbner stemmetilstand, og “Hey %@, hvad sker der i dag?” spørger med det samme."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Während Redde auf diesem %@ oder auf dem Bildschirm deines Autos geöffnet ist, sag die Phrase eines Agenten, um mit ihm zu sprechen: „Hey %@“ öffnet den Sprachmodus, und „Hey %@, was steht heute an?“ fragt sofort."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con Redde abierto en este %@ o en la pantalla del coche, di la frase de un agente para hablar con él: “Hey %@” abre el modo de voz, y “Hey %@, ¿qué hay hoy?” pregunta al momento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quand Redde est ouvert sur cet %@, ou sur l’écran de votre voiture, dites la phrase d’un agent pour lui parler : « Hey %@ » ouvre le mode vocal, et « Hey %@, qu’est-ce qu’il y a aujourd’hui ? » pose la question directement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mentre Redde è aperta su questo %@, o sullo schermo dell'auto, pronuncia la frase di un agente per parlarci: “Hey %@” apre la modalità vocale, e “Hey %@, cosa c'è oggi?” chiede subito."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この%1$@または車の画面でReddeを開いている間、エージェントのフレーズを言うと話しかけられます：「Hey %2$@」で音声モードが開き、「Hey %3$@、今日の予定は？」ですぐに質問できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Redde가 이 %@ 또는 차량 화면에서 열려 있는 동안 에이전트의 호출어를 말하면 대화할 수 있습니다. “Hey %@”는 음성 모드를 열고, “Hey %@, 오늘 일정 뭐야?”는 바로 질문합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mens Redde er åpen på denne %@, eller på bilskjermen, kan du si frasen til en agent for å snakke med den: «Hey %@» åpner stemmemodus, og «Hey %@, hva skjer i dag?» spør med en gang."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Terwijl Redde open is op deze %@, of op het scherm van je auto, zeg je de zin van een agent om met hem te praten: ‘Hey %@’ opent spraakmodus, en ‘Hey %@, wat staat er vandaag op het programma?’ vraagt het meteen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gdy Redde jest otwarte na tym urządzeniu %@ lub na ekranie samochodu, wypowiedz frazę agenta, aby z nim porozmawiać: „Hey %@” otwiera tryb głosowy, a „Hey %@, co mam dziś w planie?” od razu zadaje pytanie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enquanto o Redde estiver aberto neste %@, ou na tela do carro, diga a frase de um agente para falar com ele: “Hey %@” abre o modo de voz, e “Hey %@, o que tem para hoje?” pergunta na hora."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пока Redde открыт на этом %@ или на экране машины, произнесите фразу агента, чтобы поговорить с ним: «Hey %@» открывает голосовой режим, а «Hey %@, что у меня сегодня?» сразу задает вопрос."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Medan Redde är öppen på denna %@, eller på bilens skärm, säg en agents fras för att prata med den: ”Hey %@” öppnar röstläge, och ”Hey %@, vad händer idag?” frågar direkt."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Redde bu %@ üzerinde ya da arabanızın ekranında açıkken bir ajanla konuşmak için onun ifadesini söyleyin: “Hey %@” sesli modu açar, “Hey %@, bugün ne var?” ise hemen sorar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Поки Redde відкритий на цьому %@ або на екрані авто, скажіть фразу агента, щоб поговорити з ним: «Hey %@» відкриває голосовий режим, а «Hey %@, що в мене сьогодні?» одразу ставить запитання."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当Redde在此%@或车载屏幕上打开时，说出智能体的唤醒词即可与它对话：“Hey %@”会打开语音模式，“Hey %@，今天有什么安排？”则会直接提问。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Redde 在這部 %@ 或你的車上螢幕打開時，說出代理的喚醒語即可與它交談：「Hey %@」會打開語音模式，「Hey %@，今天有什麼事？」則會直接詢問。"
          }
        }
      }
    },

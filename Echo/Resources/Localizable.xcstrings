    "Front matter (name, description, version, metadata) then When to Use, Procedure, Pitfalls, Verification. Redde loads it on demand when a request matches." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Front matter (name, description, version, metadata) og derefter When to Use, Procedure, Pitfalls, Verification. Redde indlæser den efter behov, når en anmodning passer."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Front Matter (name, description, version, metadata), dann When to Use, Procedure, Pitfalls, Verification. Redde lädt ihn bei Bedarf, wenn eine Anfrage passt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Front matter (name, description, version, metadata) y luego When to Use, Procedure, Pitfalls, Verification. Redde la carga cuando hace falta, si una solicitud coincide."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un en-tête front matter (name, description, version, metadata), puis When to Use, Procedure, Pitfalls, Verification. Redde la charge à la demande quand une requête correspond."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il front matter (name, description, version, metadata), poi When to Use, Procedure, Pitfalls, Verification. Redde la carica su richiesta quando una domanda corrisponde."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "フロントマター（name、description、version、metadata）の後に、When to Use、Procedure、Pitfalls、Verificationを続けます。Reddeはリクエストが一致したときに必要に応じて読み込みます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "프론트 매터(name, description, version, metadata), 그다음 사용 시기, 절차, 주의 사항, 검증. 요청이 일치하면 Redde가 필요할 때 로드합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Front matter (navn, beskrivelse, versjon, metadata), deretter When to Use, Procedure, Pitfalls, Verification. Redde laster den inn ved behov når en forespørsel passer."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Front matter (name, description, version, metadata), daarna When to Use, Procedure, Pitfalls, Verification. Redde laadt hem op aanvraag als een verzoek overeenkomt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Front matter (name, description, version, metadata), a potem When to Use, Procedure, Pitfalls, Verification. Redde wczytuje ją na żądanie, gdy prośba pasuje."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Front matter (name, description, version, metadata), depois When to Use, Procedure, Pitfalls, Verification. O Redde carrega sob demanda quando um pedido corresponde."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вводная часть (name, description, version, metadata), затем разделы When to Use, Procedure, Pitfalls, Verification. Redde загружает навык по требованию, когда запрос подходит."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Front matter (name, description, version, metadata) och sedan When to Use, Procedure, Pitfalls, Verification. Redde läser in den vid behov när en förfrågan matchar."
          }

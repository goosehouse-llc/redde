            "value" : "Sein Ordner und seine Konversationen bleiben auf dem Server. Die Konversationen werden nur nicht mehr darunter gruppiert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Su carpeta y sus conversaciones se quedan en el servidor. Solo que las conversaciones ya no se agrupan bajo él."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",

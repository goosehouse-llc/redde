        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "可能であれば、サーバでssh-keygen -lf /etc/ssh/ssh_host_ed25519_key.pubを実行して確認してください。"
          }
        },
        "ko" : {
          "stringUnit" : {

    "That approval is no longer waiting. It was answered somewhere else, or it timed out." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den godkendelse venter ikke længere. Den blev besvaret et andet sted, eller den udløb."

    "Not paired yet. Redde offers it at the end, so ideas and briefings arrive with Redde closed." : {
      "comment" : "Ahead of Your Day: pairing over the Dashboard comes after Turn On",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ikke parret endnu. Redde tilbyder det til sidst, så idéer og briefinger kommer, også når Redde er lukket."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noch nicht gekoppelt. Redde bietet es am Ende an, damit Ideen und Briefings auch bei geschlossenem Redde ankommen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aún sin vincular. Redde te lo ofrece al final, para que las ideas y los informes lleguen con Redde cerrado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pas encore jumelé. Redde vous le propose à la fin, pour que les idées et les briefings arrivent quand Redde est fermé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non ancora abbinato. Redde te lo propone alla fine, perché idee e briefing arrivino anche con Redde chiusa."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "まだペアリングしていません。最後にReddeが提案するので、Reddeが閉じていてもアイデアとブリーフィングが届きます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "아직 페어링하지 않았습니다. 마지막에 Redde가 제안하므로 Redde가 닫혀 있어도 아이디어와 브리핑이 도착합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ikke sammenkoblet ennå. Redde tilbyr det til slutt, så idéer og briefinger kommer også når Redde er lukket."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nog niet gekoppeld. Redde biedt het aan het eind aan, zodat ideeën en briefings ook binnenkomen als Redde gesloten is."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeszcze nie sparowano. Redde zaproponuje to na końcu, aby pomysły i briefingi docierały przy zamkniętym Redde."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ainda não emparelhado. O Redde oferece isso no fim, para que ideias e briefings cheguem com o Redde fechado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пара ещё не создана. Redde предложит это в конце, чтобы идеи и сводки приходили при закрытом Redde."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inte parkopplad än. Redde erbjuder det i slutet, så att idéer och briefingar kommer även när Redde är stängd."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Henüz eşlenmedi. Redde bunu sonda önerir; böylece Redde kapalıyken de fikirler ve brifingler gelir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пару ще не створено. Redde запропонує це наприкінці, щоб ідеї та зведення надходили, коли Redde закрито."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "尚未配对。Redde 会在最后提供配对，这样 Redde 关闭时也能收到想法和简报。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "尚未配對。Redde 會在最後提供配對，這樣 Redde 關閉時也能收到點子和簡報。"
          }
        }
      }
    },

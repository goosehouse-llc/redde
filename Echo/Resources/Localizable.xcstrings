    "On the other device, open Redde and choose Scan a setup code, or point its Camera at this." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Åbn Redde på den anden enhed, og vælg Scan en opsætningskode, eller ret dens Kamera mod dette."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öffne auf dem anderen Gerät Redde und wähle „Einrichtungscode scannen“ oder richte seine Kamera hierauf."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En el otro dispositivo, abre Redde y elige Escanear un código de configuración, o apunta su Cámara a esto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sur l’autre appareil, ouvrez Redde et choisissez Scanner un code de configuration, ou pointez son app Appareil photo vers ce code."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sull'altro dispositivo, apri Redde e scegli Scansiona un codice di configurazione, oppure inquadra questo con la sua Fotocamera."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "もう一方のデバイスでReddeを開いて「セットアップコードをスキャン」を選ぶか、カメラをこのコードに向けてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다른 기기에서 Redde를 열고 설정 코드 스캔을 선택하거나, 카메라로 이 코드를 비추십시오."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "På den andre enheten åpner du Redde og velger Skann en oppsettskode, eller peker Kamera-appen mot denne."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open Redde op het andere apparaat en kies ‘Scan een instelcode’, of richt de Camera erop."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na drugim urządzeniu otwórz Redde i wybierz Zeskanuj kod konfiguracji albo skieruj na ten kod jego Aparat."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No outro dispositivo, abra o Redde e escolha Escanear um código de configuração, ou aponte a Câmera para isto."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "На другом устройстве откройте Redde и выберите «Сканировать код настройки» или наведите на этот код его Камеру."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öppna Redde på den andra enheten och välj Skanna en inställningskod, eller rikta dess Kamera mot den här."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diğer aygıtta Redde'yi açıp Kurulum kodu tara'ya dokunun ya da o aygıtın Kamera'sını buna doğrultun."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "На іншому пристрої відкрийте Redde й виберіть «Сканувати код налаштування» або наведіть на це його Камеру."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在另一台设备上打开Redde并选择“扫描设置码”，或用它的“相机”对准此码。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {

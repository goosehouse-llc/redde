    "Ready cards with an assignee are picked up by the dispatcher; others wait in Triage." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kort i Klar med en ansvarlig hentes af dispatcheren; andre venter i Sortering."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Karten in „Bereit“ mit Zuständigem übernimmt der Dispatcher; andere warten in „Triage“."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El distribuidor recoge las tarjetas listas con alguien asignado; las demás esperan en Clasificar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les cartes Prêt avec un assigné sont prises en charge par le répartiteur ; les autres attendent dans Tri."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le schede Pronto con un assegnatario vengono prese dal dispatcher; le altre attendono in Smistamento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "担当者のいる準備完了のカードはディスパッチャーが割り当てます。それ以外はトリアージで待機します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "담당자가 있는 준비됨 카드는 디스패처가 가져가고, 나머지는 분류에서 대기합니다."
          }
        },
        "nb" : {
          "stringUnit" : {

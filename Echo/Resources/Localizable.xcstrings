    "What replaces the word. Spaces count, including a space at the end. Leave it empty to only switch the model." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det, der erstatter ordet. Mellemrum tæller med, også et mellemrum til sidst. Lad det være tomt for kun at skifte model."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Was das Wort ersetzt. Leerzeichen zählen, auch eines am Ende. Leer lassen, um nur das Modell zu wechseln."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo que sustituye a la palabra. Los espacios cuentan, incluido un espacio al final. Déjalo vacío para solo cambiar el modelo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce qui remplace le mot. Les espaces comptent, y compris une espace finale. Laissez vide pour seulement changer de modèle."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cosa sostituisce la parola. Gli spazi contano, compreso uno spazio finale. Lascialo vuoto per cambiare solo il modello."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "単語を置き換えるテキスト。末尾のスペースも含め、スペースも有効です。モデルの切り替えだけを行う場合は空欄にします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "단어를 대치할 내용입니다. 끝의 공백을 포함하여 공백도 반영됩니다. 모델만 전환하려면 비워 두십시오."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det som erstatter ordet. Mellomrom teller, også et mellomrom på slutten. La det stå tomt for bare å bytte modell."

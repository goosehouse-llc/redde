    "Costs are the gateway's own estimate from provider pricing." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Omkostninger er gatewayens eget skøn ud fra udbyderens priser."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Kosten sind eine Schätzung des Gateways anhand der Anbieterpreise."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los costes son una estimación del gateway según los precios del proveedor."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les coûts sont une estimation de la passerelle d’après les tarifs du fournisseur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I costi sono una stima del gateway basata sui prezzi del provider."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コストは、プロバイダの料金に基づくゲートウェイ独自の見積もりです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "비용은 제공업체 가격을 바탕으로 게이트웨이가 추정한 값입니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kostnadene er gatewayens eget anslag basert på leverandørens priser."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De kosten zijn een eigen schatting van de gateway op basis van de prijzen van de provider."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koszty to szacunek bramy na podstawie cennika dostawcy."
          }
        },
        "pt-BR" : {

    "The endpoint replaces the one you have now (%@), and that one's key is forgotten." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Endpointet erstatter det, du har nu (%@), og dets nøgle glemmes."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Endpunkt ersetzt deinen jetzigen (%@), und dessen Schlüssel wird vergessen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El endpoint reemplaza al que tienes ahora (%@), y se olvida la clave de ese."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce point d’accès remplace l’actuel (%@), dont la clé est oubliée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'endpoint sostituisce quello attuale (%@), e la chiave di quest'ultimo viene dimenticata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このエンドポイントが現在のもの（%@）に置き換わり、そのキーは削除されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 엔드포인트가 현재 엔드포인트(%@)를 대치하며, 기존 엔드포인트의 키는 지워집니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Endepunktet erstatter det du har nå (%@), og nøkkelen til det glemmes."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het endpoint vervangt je huidige (%@), en de sleutel daarvan wordt vergeten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ten punkt końcowy zastąpi obecny (%@), a jego klucz zostanie zapomniany."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O endpoint substitui o que você tem agora (%@), e a chave dele é esquecida."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Эндпоинт заменит текущий (%@), а ключ текущего будет забыт."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slutpunkten ersätter den du har nu (%@), och dess nyckel glöms."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uç nokta, şu anki uç noktanın (%@) yerini alır ve onun anahtarı unutulur."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ця кінцева точка замінить поточну (%@), а ключ поточної буде забуто."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {

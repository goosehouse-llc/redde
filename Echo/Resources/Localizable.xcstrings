    "A key is kept in %@'s .env on your server and never shown again here." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En nøgle opbevares i .env for %@ på din server og vises aldrig igen her."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Schlüssel wird in der .env von %@ auf deinem Server gesichert und hier nie wieder angezeigt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La clave se guarda en el .env de %@ en tu servidor y aquí no se vuelve a mostrar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une clé est conservée dans le .env de %@ sur votre serveur et n’est plus jamais affichée ici."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una chiave viene salvata nel file .env di %@ sul tuo server e non viene più mostrata qui."

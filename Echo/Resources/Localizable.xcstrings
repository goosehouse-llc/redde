    "That question is no longer waiting. It was answered somewhere else, or it timed out." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det spørgsmål venter ikke længere. Det blev besvaret et andet sted, eller det udløb."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Frage wartet nicht mehr. Sie wurde woanders beantwortet oder ist abgelaufen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esa pregunta ya no está pendiente. Se respondió en otro sitio o caducó."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette question n’est plus en attente. Elle a reçu une réponse ailleurs, ou elle a expiré."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quella domanda non è più in attesa. Ha ricevuto risposta altrove, o è scaduta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "その質問はもう待機していません。別の場所で回答されたか、タイムアウトしました。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "해당 질문은 더 이상 대기 중이 아닙니다. 다른 곳에서 응답했거나 시간이 초과되었습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det spørsmålet venter ikke lenger. Det ble besvart et annet sted, eller det gikk ut på tid."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die vraag wacht niet meer. Ze is elders beantwoord, of de tijd is verstreken."

    "Check that the gateway is running and that this phone is on your network or tailnet." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tjek, at gatewayen kører, og at denne telefon er på dit netværk eller tailnet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prüfe, ob das Gateway läuft und dieses iPhone in deinem Netzwerk oder Tailnet ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comprueba que el gateway esté en marcha y que este teléfono esté en tu red o tailnet."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vérifiez que la passerelle fonctionne et que ce téléphone est sur votre réseau ou votre tailnet."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Controlla che il gateway sia in esecuzione e che questo telefono sia sulla tua rete o tailnet."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ゲートウェイが実行中で、このiPhoneがネットワークまたはtailnetに接続されていることを確認してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "게이트웨이가 실행 중이고 이 휴대폰이 네트워크 또는 tailnet에 연결되어 있는지 확인하십시오."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sjekk at gatewayen kjører, og at denne telefonen er på nettverket ditt eller tailnet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Controleer of de gateway draait en of deze telefoon op je netwerk of tailnet zit."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sprawdź, czy brama działa i czy ten telefon jest w Twojej sieci lub tailnecie."

          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geldt voor dit gesprek en voor nieuwe."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dotyczy tej rozmowy i nowych."
          }
        },
        "pt-BR" : {
          "stringUnit" : {

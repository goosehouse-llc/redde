    "With “Interrupt with” set to Only “stop”, these stop a reply too." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Med “Afbryd med” sat til Kun “stop” stopper disse også et svar."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steht „Unterbrechen mit“ auf Nur „stop“, stoppen diese auch eine Antwort."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con “Interrumpir con” en Solo “stop”, estas también detienen una respuesta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quand « Interrompre avec » est sur Seulement « stop », elles arrêtent aussi une réponse."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con “Interrompi con” impostato su Solo “stop”, interrompono anche una risposta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「割り込み方法」が「『stop』のみ」のときも、これらで返答が止まります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "끼어들기 방식이 “stop”만으로 설정되어 있으면 이 문구로도 응답이 중단됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Med «Avbryt med» satt til Bare «stop» stopper disse også et svar."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Met ‘Onderbreek met’ op Alleen ‘stop’ stoppen deze ook een antwoord."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gdy w „Przerywanie” wybrano Tylko „stop”, te frazy zatrzymują też odpowiedź."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Com “Interromper com” definido como Só “stop”, estas também param uma resposta."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если для «Прерывать» выбрано «Только „stop“», эти фразы тоже останавливают ответ."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Med ”Avbryt med” inställt på Endast ”stop” stoppar de även ett svar."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Bölme şekli” Yalnızca “stop” olarak ayarlıysa bunlar bir yanıtı da durdurur."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Якщо «Як перебивати» має значення «Лише „stop“», вони також зупиняють відповідь."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当“打断方式”设为仅“stop”时，这些短语也会停止回复。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「打斷方式」設為「僅『stop』」時，這些語句也會停止回覆。"
          }
        }
      }
    },
    "With App Lock on, Redde waits for your iPhone to be unlocked before it asks, as it does for Siri." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Med applås slået til venter Redde på, at din iPhone bliver låst op, før den spørger, ligesom med Siri."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit aktivierter App-Sperre wartet Redde, bis dein iPhone entsperrt ist, bevor es fragt, wie bei Siri."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con el bloqueo de la app activado, Redde espera a que desbloquees el iPhone antes de preguntar, como hace con Siri."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avec le verrouillage de l’app activé, Redde attend que votre iPhone soit déverrouillé avant de demander, comme pour Siri."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con il blocco dell'app attivo, Redde aspetta che l'iPhone sia sbloccato prima di chiedere, come fa con Siri."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アプリのロックがオンの場合、Siriのときと同じように、ReddeはiPhoneのロックが解除されるのを待ってから質問します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "앱 잠금이 켜져 있으면 Redde는 Siri와 마찬가지로 iPhone이 잠금 해제될 때까지 기다린 후에 질문합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Med applåsen på venter Redde til iPhonen er låst opp før den spør, slik den gjør for Siri."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Met App-vergrendeling aan wacht Redde tot je iPhone ontgrendeld is voordat het vraagt, net als bij Siri."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gdy blokada aplikacji jest włączona, Redde czeka, aż iPhone zostanie odblokowany, zanim zapyta, tak jak w przypadku Siri."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Com o bloqueio do app ativado, o Redde espera o iPhone ser desbloqueado antes de perguntar, como faz com a Siri."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "При включенной блокировке приложения Redde ждет, пока iPhone будет разблокирован, прежде чем спросить, как и для Siri."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Med applås på väntar Redde tills din iPhone är upplåst innan den frågar, precis som för Siri."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uygulama Kilidi açıkken Redde, Siri'de olduğu gibi sormadan önce iPhone'unuzun kilidinin açılmasını bekler."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Якщо ввімкнено замкнення програми, Redde чекає, поки iPhone буде розблоковано, перш ніж запитати, як і для Siri."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "打开App锁定时，Redde会像Siri一样，等你的iPhone解锁后再提问。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "開啟 App 鎖定時，Redde 會像 Siri 一樣，等你的 iPhone 解鎖後再詢問。"
          }
        }
      }
    },

          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "その後Hermesを再起動し、Hermesが正常でなければすべて元に戻します"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",

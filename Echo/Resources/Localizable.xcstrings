            "value" : "%@ için kurulum kodu"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Код налаштування для %@"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@的设置码"
          }
        },
        "zh-Hant" : {

        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Цей iPhone уперше під’єднується до %@. Відбиток його ключа: %@."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {

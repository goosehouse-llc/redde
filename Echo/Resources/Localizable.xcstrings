    "Restart Hermes Now" : {

    },
    "Restart the gateway?" : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Genstart gatewayen?"
          }
        },
        "de" : {

        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모두에게 말하거나, @와 이름으로 시작해서 한 봇에게 물어보십시오. 덧붙일 말이 없는 봇은 조용히 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
